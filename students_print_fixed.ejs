            <div class="filter-grid">


                <div class="filter-box">

                    <select id="filterField">

                        <option value="name">
                            Student Name
                        </option>

                        <option value="aadhaar">
                            Aadhaar No.
                        </option>

                        <option value="fatherName">
                            Father Name
                        </option>

                        <option value="motherName">
                            Mother Name
                        </option>

                        <option value="mobile">
                            Mobile No.
                        </option>

                        <option value="uid">
                            UID
                        </option>

                        <option value="serialNo">
                            Sr. No.
                        </option>

                        <option value="class">
                            Class
                        </option>

                        <option value="document">
                            Submitted Document
                        </option>

                        <option value="schoolJoinSession">
                            Join Session
                        </option>

                        <option value="status">
                            Status
                        </option>

                    </select>

                </div>


                <div
                    class="filter-box"
                    id="normalSearchBox"
                >

                    <input
                        type="text"
                        id="filterValue"
                        placeholder="Search student name..."
                        autocomplete="off"
                    >

                </div>


                <div class="filter-box">

                    <select id="quickFilter">

                        <option value="">
                            All Status
                        </option>

                        <option value="active">
                            Active
                        </option>

                        <option value="deactive">
                            Deactive
                        </option>

                    </select>

                </div>


            </div>


            <div
                class="extra-filter"
                id="extraFilter"
            >

                <select
                    id="classFilter"
                    style="display:none;"
                >

                    <option value="">
                        Select Class
                    </option>

                    <% for(let i = 1; i <= 12; i++) { %>

                        <option value="<%= i %>">
                            Class <%= i %>
                        </option>

                    <% } %>

                </select>


                <input
                    type="text"
                    id="documentFilter"
                    style="display:none;"
                    placeholder="Enter document name e.g. TC or Photo"
                    autocomplete="off"
                >

            </div>


        </section>


        <!-- RESULTS -->

        <section class="results-panel">


            <div class="results-header">

                <h2>
                    Student Records
                </h2>


                <span
                    class="results-count"
                    id="resultText"
                >

                    Loading...

                </span>

            </div>


            <div
                class="loading"
                id="loading"
            >

                Searching students...

            </div>


            <div
                class="table-wrapper"
                id="tableContainer"
            >

                <table>

                    <thead>

                        <tr>

                            <th>
                                STUDENT
                            </th>

                            <th>
                                CLASS
                            </th>

                            <th>
                                JOIN SESSION
                            </th>

                            <th>
                                MOBILE
                            </th>

                            <th>
                                FATHER
                            </th>

                            <th>
                                DOCUMENTS
                            </th>

                            <th>
                                STATUS
                            </th>

                            <th>
                                ACTION
                            </th>

                        </tr>

                    </thead>


                    <tbody
                        id="studentBody"
                    >
                    </tbody>

                </table>

            </div>


            <div
                class="empty"
                id="emptyState"
                style="display:none;"
            >

                <strong>
                    No students found
                </strong>

                <p>
                    Try changing your search or filters.
                </p>

            </div>


            <div class="pagination">

                <div
                    class="page-info"
                    id="pageInfo"
                >

                    Showing 0 students

