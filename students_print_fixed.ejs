<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>IKVM | Students</title>

<link
    rel="preconnect"
    href="https://fonts.googleapis.com"
>

<link
    rel="preconnect"
    href="https://fonts.gstatic.com"
>

<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {

    --bg: #07090d;
    --sidebar: #090b11;
    --card: rgba(255,255,255,.025);
    --border: rgba(255,255,255,.07);
    --text: #f5f7ff;
    --muted: #777f91;
    --primary: #687cff;
    --green: #4ed39a;
    --red: #ff6878;

}

body {

    font-family: Inter, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;

}

body::before {

    content: "";

    position: fixed;

    inset: 0;

    background-image:
        linear-gradient(
            rgba(255,255,255,.018) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.018) 1px,
            transparent 1px
        );

    background-size: 70px 70px;

    pointer-events: none;

    z-index: -2;

}

.glow {

    position: fixed;

    width: 400px;
    height: 400px;

    border-radius: 50%;

    filter: blur(150px);

    opacity: .07;

    pointer-events: none;

    z-index: -1;

}

.glow-one {

    background: #566fff;

    top: -200px;
    left: 100px;

}

.glow-two {

    background: #914cff;

    right: -200px;
    bottom: 100px;

}


/* =====================================================
SIDEBAR
===================================================== */

.sidebar {

    width: 250px;

    position: fixed;

    top: 0;
    bottom: 0;
    left: 0;

    padding: 24px 16px;

    background: rgba(9,11,17,.97);

    border-right: 1px solid var(--border);

    z-index: 20;

    transition: .3s;

}

.brand {

    display: flex;

    align-items: center;

    gap: 11px;

    padding: 0 10px;

    margin-bottom: 38px;

}

.brand-icon {

    width: 36px;
    height: 36px;

    display: grid;

    place-items: center;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            #6078ff,
            #914cff
        );

    font-weight: 800;

}

.brand-text strong {

    display: block;

    font-size: 15px;

}

.brand-text span {

    color: #606777;

    font-size: 8px;

    letter-spacing: 1px;

}

.nav-label {

    padding: 0 11px;

    margin: 22px 0 10px;

    color: #4e5666;

    font-size: 9px;

    letter-spacing: 1.5px;

    font-weight: 700;

}

.nav-item {

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 10px 12px;

    margin-bottom: 4px;

    border-radius: 9px;

    color: #737a8b;

    font-size: 11px;

    transition: .2s;

    text-decoration: none;

}

.nav-item:hover {

    color: white;

    background: rgba(255,255,255,.04);

}

.nav-item.active {

    color: #8090ff;

    background:
        linear-gradient(
            90deg,
            rgba(91,111,255,.16),
            rgba(91,111,255,.04)
        );

}

.nav-icon {

    width: 27px;
    height: 27px;

    display: grid;

    place-items: center;

    border-radius: 7px;

}

.sidebar-bottom {

    position: absolute;

    left: 16px;
    right: 16px;
    bottom: 20px;

}

.user-mini {

    display: flex;

    align-items: center;

    gap: 9px;

    padding: 10px;

    border: 1px solid var(--border);

    border-radius: 10px;

    background: var(--card);

}

.avatar {

    width: 31px;
    height: 31px;

    display: grid;

    place-items: center;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            #566fff,
            #8b4cff
        );

    font-size: 10px;

    font-weight: 700;

}

.user-info {

    flex: 1;

    min-width: 0;

}

.user-info strong {

    display: block;

    font-size: 9px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

}

.user-info span {

    color: #626979;

    font-size: 7px;

}

.logout {

    color: #666d7e;

    text-decoration: none;

}


/* =====================================================
MAIN
===================================================== */

.main {

    margin-left: 250px;

    min-height: 100vh;

    padding: 25px 35px;

}

.topbar {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding-bottom: 20px;

    border-bottom: 1px solid var(--border);

}

.top-left {

    display: flex;

    align-items: center;

    gap: 12px;

}

.page-title small {

    color: #626979;

    font-size: 9px;

    letter-spacing: 1px;

}

.page-title h1 {

    margin-top: 4px;

    font-size: 22px;

}

.mobile-menu {

    display: none;

    width: 35px;
    height: 35px;

    border: 1px solid var(--border);

    border-radius: 8px;

    background: var(--card);

    color: white;

}


/* =====================================================
ADD BUTTON
===================================================== */

.add-student {

    display: flex;

    align-items: center;

    gap: 7px;

    padding: 10px 14px;

    border-radius: 8px;

    background:
        linear-gradient(
            135deg,
            #566fff,
            #824cff
        );

    color: white;

    font-size: 9px;

    font-weight: 600;

    text-decoration: none;

}


/* =====================================================
CONTENT
===================================================== */

.content {

    max-width: 1350px;

    margin: 23px auto;

}


/* =====================================================
SUMMARY
===================================================== */

.summary {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 12px;

    margin-bottom: 15px;

}

.summary-card {

    padding: 16px;

    border: 1px solid var(--border);

    border-radius: 11px;

    background: var(--card);

}

.summary-card span {

    color: #646c7d;

    font-size: 8px;

}

.summary-card strong {

    display: block;

    margin-top: 8px;

    font-size: 22px;

}

.summary-card small {

    display: block;

    margin-top: 4px;

    color: #555d6e;

    font-size: 7px;

}

.green {

    color: var(--green);

}

.red {

    color: var(--red);

}


/* =====================================================
FILTER
===================================================== */

.filter-panel {

    padding: 18px;

    border: 1px solid var(--border);

    border-radius: 12px;

    background: var(--card);

}

.filter-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 15px;

}

.filter-title h2 {

    font-size: 12px;

}

.filter-title p {

    margin-top: 4px;

    color: #606878;

    font-size: 8px;

}

.clear-btn {

    border: none;

    background: transparent;

    color: #687cff;

    cursor: pointer;

    font-size: 8px;

}

.filter-grid {

    display: grid;

    grid-template-columns:
        190px 1fr 150px;

    gap: 10px;

}

.filter-box input,
.filter-box select {

    width: 100%;

    height: 40px;

    padding: 0 11px;

    border: 1px solid var(--border);

    border-radius: 8px;

    outline: none;

    background: rgba(255,255,255,.025);

    color: #e8ebf3;

    font-size: 9px;

}

.filter-box input::placeholder {

    color: #505766;

}

.filter-box input:focus,
.filter-box select:focus {

    border-color:
        rgba(104,124,255,.55);

    box-shadow:
        0 0 0 3px
        rgba(104,124,255,.05);

}

.filter-box select option {

    background: #11141c;

    color: white;

}


/* =====================================================
EXTRA FILTER
===================================================== */

.extra-filter {

    display: none;

    margin-top: 10px;

}

.extra-filter.show {

    display: block;

}

.extra-filter input,
.extra-filter select {

    width: 100%;

    height: 40px;

    padding: 0 11px;

    border: 1px solid var(--border);

    border-radius: 8px;

    outline: none;

    background: rgba(255,255,255,.025);

    color: white;

    font-size: 9px;

}

.extra-filter select option {

    background: #11141c;

}


/* =====================================================
RESULTS
===================================================== */

.results-panel {

    margin-top: 15px;

    border: 1px solid var(--border);

    border-radius: 12px;

    background: var(--card);

    overflow: hidden;

}

.results-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 16px 18px;

    border-bottom: 1px solid var(--border);

}

.results-header h2 {

    font-size: 12px;

}

.results-count {

    color: #626979;

    font-size: 8px;

}

.table-wrapper {

    width: 100%;

    overflow-x: auto;

}

table {

    width: 100%;

    min-width: 950px;

    border-collapse: collapse;

}

th {

    padding: 11px 15px;

    text-align: left;

    color: #505868;

    font-size: 7px;

    font-weight: 600;

    border-bottom: 1px solid var(--border);

}

td {

    padding: 13px 15px;

    color: #9ea5b4;

    font-size: 8px;

    border-bottom:
        1px solid
        rgba(255,255,255,.04);

}

tbody tr {

    cursor: pointer;

    transition: .15s;

}

tbody tr:hover {

    background:
        rgba(104,124,255,.035);

}

.student-name {

    display: flex;

    align-items: center;

    gap: 9px;

}

.student-avatar {

    width: 29px;
    height: 29px;

    display: grid;

    place-items: center;

    flex-shrink: 0;

    border-radius: 8px;

    background:
        rgba(104,124,255,.1);

    color: #7c8bff;

    font-size: 9px;

    font-weight: 700;

}

.student-name strong {

    display: block;

    color: #d0d4de;

    font-size: 8px;

}

.student-name small {

    display: block;

    margin-top: 3px;

    color: #505868;

    font-size: 6px;

}

.status {

    display: inline-flex;

    padding: 4px 7px;

    border-radius: 20px;

    font-size: 6px;

}

.status.active {

    color: var(--green);

    background: rgba(78,211,154,.08);

}

.status.deactive {

    color: var(--red);

    background: rgba(255,104,120,.08);

}

.documents {

    color: #7182ff;

}


/* =====================================================
EDIT BUTTON
===================================================== */

.edit-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 5px;

    padding: 7px 11px;

    border:
        1px solid
        rgba(104,124,255,.25);

    border-radius: 7px;

    background:
        rgba(104,124,255,.07);

    color: #7c8bff;

    font-size: 7px;

    font-weight: 600;

    text-decoration: none;

    white-space: nowrap;

    transition: .2s;

}

.edit-btn:hover {

    background:
        rgba(104,124,255,.15);

    border-color:
        rgba(104,124,255,.45);

    color: white;

}


/* =====================================================
LOADING
===================================================== */

.loading {

    display: none;

    padding: 35px;

    text-align: center;

    color: #606878;

    font-size: 9px;

}

.loading.show {

    display: block;

}


/* =====================================================
EMPTY
===================================================== */

.empty {

    padding: 45px 20px;

    text-align: center;

    color: #555d6e;

}

.empty strong {

    display: block;

    color: #747c8d;

    font-size: 10px;

}

.empty p {

    margin-top: 5px;

    font-size: 8px;

}


/* =====================================================
PAGINATION
===================================================== */

.pagination {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 14px 18px;

    border-top: 1px solid var(--border);

}

.page-info {

    color: #555d6e;

    font-size: 7px;

}

.show-more-btn {

    padding: 9px 18px;

    border:
        1px solid
        rgba(104,124,255,.25);

    border-radius: 8px;

    background:
        rgba(104,124,255,.07);

    color: #7c8bff;

    cursor: pointer;

    font-size: 8px;

    font-weight: 600;

    transition: .2s;

}

.show-more-btn:hover {

    background:
        rgba(104,124,255,.13);

    border-color:
        rgba(104,124,255,.45);

    color: white;

}

.show-more-btn:disabled {

    opacity: .35;

    cursor: not-allowed;

}


/* =====================================================
MOBILE
===================================================== */

@media(max-width:850px) {

    .sidebar {

        transform:
            translateX(-100%);

    }

    .sidebar.open {

        transform:
            translateX(0);

    }

    .main {

        margin-left: 0;

        padding: 18px;

    }

    .mobile-menu {

        display: grid;

        place-items: center;

    }

    .summary {

        grid-template-columns:
            repeat(2, 1fr);

    }

    .filter-grid {

        grid-template-columns: 1fr;

    }

}

@media(max-width:550px) {

    .main {

        padding: 14px;

    }

    .summary {

        gap: 8px;

    }

    .summary-card {

        padding: 13px;

    }

    .summary-card strong {

        font-size: 19px;

    }

    .add-student span {

        display: none;

    }

    .filter-panel {

        padding: 14px;

    }

    .pagination {

        gap: 10px;

    }

}


/* =====================================================
PRINT STUDENTS SYSTEM
===================================================== */

.print-students-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border: 1px solid rgba(104,124,255,.25);
    border-radius: 8px;
    background: rgba(104,124,255,.07);
    color: #9aa6ff;
    font-family: Inter, sans-serif;
    font-size: 9px;
    font-weight: 600;
    cursor: pointer;
    transition: .2s;
}

.print-students-btn:hover {
    background: rgba(104,124,255,.14);
    border-color: rgba(104,124,255,.45);
    color: white;
}

.print-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    background: rgba(0,0,0,.72);
    backdrop-filter: blur(7px);
    padding: 22px;
}

.print-modal.show {
    display: flex;
}

.print-modal-card {
    width: min(1180px, 100%);
    height: min(820px, calc(100vh - 44px));
    margin: auto;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 14px;
    background: #0c0f15;
    box-shadow: 0 30px 100px rgba(0,0,0,.55);
}

.print-modal-head {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding:18px 20px;
    border-bottom:1px solid var(--border);
}

.print-modal-head h2 {
    font-size:14px;
}

.print-modal-head p {
    margin-top:4px;
    color:#626979;
    font-size:8px;
}

.print-close {
    width:32px;
    height:32px;
    border:1px solid var(--border);
    border-radius:7px;
    background:rgba(255,255,255,.025);
    color:#8d95a5;
    cursor:pointer;
}

.print-modal-body {
    flex:1;
    min-height:0;
    display:grid;
    grid-template-columns: 1fr 390px;
    gap:0;
}

.print-students-pane,
.print-fields-pane {
    min-width:0;
    overflow:auto;
}

.print-students-pane {
    border-right:1px solid var(--border);
}

.print-section-head {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:14px 16px;
    border-bottom:1px solid var(--border);
}

.print-section-head strong {
    font-size:10px;
}

.print-section-head span {
    color:#626979;
    font-size:7px;
}

.print-head-actions {
    display:flex;
    gap:6px;
}

.print-mini-btn {
    padding:7px 9px;
    border:1px solid var(--border);
    border-radius:7px;
    background:rgba(255,255,255,.025);
    color:#747d8e;
    font-size:7px;
    cursor:pointer;
}

.print-student-list {
    max-height:370px;
    overflow:auto;
}

.print-selection-row {
    display:flex;
    align-items:center;
    gap:10px;
    padding:10px 15px;
    border-bottom:1px solid rgba(255,255,255,.035);
}

.print-selection-row:hover {
    background:rgba(104,124,255,.035);
}

.print-selection-row input,
.print-field-row input,
.print-candidate-row input {
    width:15px;
    height:15px;
    accent-color:#687cff;
    flex-shrink:0;
}

.print-avatar {
    width:30px;
    height:30px;
    display:grid;
    place-items:center;
    border-radius:8px;
    background:rgba(104,124,255,.1);
    color:#8491ff;
    font-size:8px;
    font-weight:700;
    flex-shrink:0;
}

.print-student-info {
    min-width:0;
    flex:1;
}

.print-student-info strong {
    display:block;
    color:#d4d8e1;
    font-size:8px;
}

.print-student-info small {
    display:block;
    margin-top:3px;
    color:#596172;
    font-size:6px;
}

.print-add-box {
    padding:13px 15px;
    border-top:1px solid var(--border);
    border-bottom:1px solid var(--border);
}

.print-add-title {
    margin-bottom:8px;
    color:#777f91;
    font-size:7px;
    font-weight:700;
    letter-spacing:.8px;
}

.print-add-line {
    display:flex;
    gap:7px;
}

.print-add-line input {
    flex:1;
    min-width:0;
    height:36px;
    padding:0 10px;
    border:1px solid var(--border);
    border-radius:7px;
    outline:none;
    background:rgba(255,255,255,.025);
    color:#e8ebf3;
    font-size:8px;
}

.print-add-line button,
.print-add-selected {
    border:1px solid rgba(104,124,255,.25);
    border-radius:7px;
    background:rgba(104,124,255,.09);
    color:#8d99ff;
    padding:0 12px;
    font-size:8px;
    font-weight:600;
    cursor:pointer;
}

.print-candidates {
    max-height:210px;
    overflow:auto;
}

.print-candidate-row {
    display:flex;
    align-items:center;
    gap:9px;
    padding:9px 15px;
    border-bottom:1px solid rgba(255,255,255,.035);
}

.print-candidate-info {
    flex:1;
    min-width:0;
}

.print-candidate-info strong {
    display:block;
    color:#cbd0da;
    font-size:8px;
}

.print-candidate-info small {
    display:block;
    margin-top:3px;
    color:#596172;
    font-size:6px;
}

.print-already {
    color:#5968d9;
    font-size:6px;
}

.print-add-selected-wrap {
    padding:9px 15px 12px;
}

.print-add-selected {
    width:100%;
    height:32px;
}

.print-add-selected:disabled {
    opacity:.35;
    cursor:not-allowed;
}

.print-fields-pane {
    padding-bottom:15px;
}

.print-fields-toolbar {
    display:flex;
    gap:6px;
    padding:12px 15px;
    border-bottom:1px solid var(--border);
}

.print-field-list {
    padding:8px 15px 0;
}

.print-field-group-title {
    margin:8px 0;
    color:#4f596b;
    font-size:7px;
    font-weight:700;
    letter-spacing:1px;
}

.print-field-row {
    display:flex;
    align-items:center;
    gap:9px;
    padding:7px 0;
    color:#aeb4c0;
    font-size:8px;
}

.print-field-row.custom {
    padding-left:7px;
}

.print-empty {
    padding:45px 20px;
    text-align:center;
    color:#555d6e;
    font-size:8px;
    line-height:1.7;
}

.print-sort-pane {
    margin: 0 22px 18px;
    padding: 12px 14px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 12px;
    background: rgba(255,255,255,.025);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
}

.print-sort-title {
    font-size:10px;
    font-weight:800;
    letter-spacing:.8px;
    color:#9da8c7;
}

.print-sort-select {
    min-width:230px;
    padding:9px 11px;
    border-radius:8px;
    border:1px solid rgba(255,255,255,.12);
    background:#10131d;
    color:#eef2ff;
    outline:none;
}

.print-modal-foot {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:13px 18px;
    border-top:1px solid var(--border);
}

.print-modal-foot span {
    color:#626979;
    font-size:8px;
}

.print-confirm {
    padding:10px 15px;
    border:0;
    border-radius:8px;
    background:linear-gradient(135deg,#566fff,#824cff);
    color:white;
    font-size:8px;
    font-weight:600;
    cursor:pointer;
}

.print-confirm:disabled {
    opacity:.35;
    cursor:not-allowed;
}

@media(max-width:900px) {
    .print-modal {
        padding:10px;
    }

    .print-modal-card {
        height:calc(100vh - 20px);
    }

    .print-modal-body {
        grid-template-columns:1fr;
        overflow:auto;
    }

    .print-students-pane {
        border-right:0;
        border-bottom:1px solid var(--border);
    }

    .print-student-list {
        max-height:280px;
    }

    .print-fields-pane {
        min-height:350px;
    }
}

@media(max-width:550px) {
    .print-students-btn span {
        display:none;
    }

    .print-modal {
        padding:5px;
    }

    .print-modal-card {
        height:calc(100vh - 10px);
        border-radius:10px;
    }
}

</style>

</head>


<body>


<div class="glow glow-one"></div>

<div class="glow glow-two"></div>


<!-- =====================================================
SIDEBAR
===================================================== -->

<aside
    class="sidebar"
    id="sidebar"
>

    <div class="brand">

        <div class="brand-icon">
            ◆
        </div>

        <div class="brand-text">

            <strong>IKVM</strong>

            <span>
                ADMIN PORTAL
            </span>

        </div>

    </div>


    <div class="nav-label">
        MAIN MENU
    </div>


    <a
        href="/admin/dashboard"
        class="nav-item"
    >

        <div class="nav-icon">
            ⌂
        </div>

        Dashboard

    </a>


    <a
        href="/admin/students"
        class="nav-item active"
    >

        <div class="nav-icon">
            ◉
        </div>

        Students

    </a>


    <a
        href="/admin/faculty"
        class="nav-item"
    >

        <div class="nav-icon">
            ◇
        </div>

        Faculty

    </a>


    <div class="nav-label">
        MANAGEMENT
    </div>


