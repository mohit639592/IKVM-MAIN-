<script>

/* =====================================================
ELEMENTS
===================================================== */

const field =
    document.getElementById("filterField");

const value =
    document.getElementById("filterValue");

const quickFilter =
    document.getElementById("quickFilter");

const classFilter =
    document.getElementById("classFilter");

const documentFilter =
    document.getElementById("documentFilter");

const extraFilter =
    document.getElementById("extraFilter");

const studentBody =
    document.getElementById("studentBody");

const loading =
    document.getElementById("loading");

const emptyState =
    document.getElementById("emptyState");

const tableContainer =
    document.getElementById("tableContainer");

const resultText =
    document.getElementById("resultText");

const showingCount =
    document.getElementById("showingCount");

const pageInfo =
    document.getElementById("pageInfo");

const showMoreBtn =
    document.getElementById("showMoreBtn");

const clearBtn =
    document.getElementById("clearBtn");


/* =====================================================
STATE
===================================================== */

let currentPage = 1;

let totalPages = 1;

let totalMatching = 0;

let loadedStudents = 0;

let searchTimer = null;

// Prevent old search requests from updating the table
let searchRequestId = 0;


/* =====================================================
FIELD CHANGE
===================================================== */

field.addEventListener(
    "change",
    () => {

        const selected =
            field.value;

        extraFilter.classList.remove(
            "show"
        );

        classFilter.style.display =
            "none";

        documentFilter.style.display =
            "none";

        value.style.display =
            "block";


        if (selected === "class") {

            extraFilter.classList.add(
                "show"
            );

            classFilter.style.display =
                "block";

            value.style.display =
                "none";

        }

        else if (
            selected === "document"
        ) {

            extraFilter.classList.add(
                "show"
            );

            documentFilter.style.display =
                "block";

            value.style.display =
                "none";

        }

        else if (
            selected === "status"
        ) {

            value.style.display =
                "none";

        }

        else {

            value.placeholder =
                "Search " +
                field.options[
                    field.selectedIndex
                ].text.toLowerCase() +
                "...";

        }


        resetAndSearch();

    }
);


/* =====================================================
NORMAL SEARCH
===================================================== */

value.addEventListener(
    "input",
    () => {

        clearTimeout(
            searchTimer
        );

        searchTimer =
            setTimeout(
                () => {

                    resetAndSearch();

                },
                200
            );

    }
);


/* =====================================================
CLASS
===================================================== */

classFilter.addEventListener(
    "change",
    () => {

        resetAndSearch();

    }
);


/* =====================================================
DOCUMENT
===================================================== */

documentFilter.addEventListener(
    "input",
    () => {

        clearTimeout(
            searchTimer
        );

        searchTimer =
            setTimeout(
                () => {

                    resetAndSearch();

                },
                200
            );

    }
);


/* =====================================================
STATUS
===================================================== */

quickFilter.addEventListener(
    "change",
    () => {

        resetAndSearch();

    }
);


/* =====================================================
RESET SEARCH
===================================================== */

function resetAndSearch() {

    currentPage = 1;

    loadedStudents = 0;

    totalMatching = 0;

    // Every new search gets a new ID.
    // Older requests become invalid.
    searchRequestId++;

    studentBody.innerHTML = "";

    loadStudents(
        false,
        searchRequestId
    );

}


/* =====================================================
LOAD STUDENTS
===================================================== */

async function loadStudents(
    loadMore = false,
    requestId = searchRequestId
) {

    loading.classList.add(
        "show"
    );


    if (!loadMore) {

        tableContainer.style.display =
            "none";

        emptyState.style.display =
            "none";

    }


    const params =
        new URLSearchParams();


    params.set(
        "field",
        field.value
    );

    params.set(
        "page",
        currentPage
    );

    params.set(
        "limit",
        "50"
    );


    /* =================================================
    CLASS FILTER
    ================================================= */

    if (
        field.value === "class"
    ) {

        if (classFilter.value) {

            params.set(
                "value",
                classFilter.value
            );

        }

    }


    /* =================================================
    DOCUMENT FILTER
    ================================================= */

    else if (
        field.value === "document"
    ) {

        if (
            documentFilter.value.trim()
        ) {

            params.set(
                "value",
                documentFilter.value.trim()
            );

        }

    }


    /* =================================================
    STATUS FILTER
    ================================================= */

    else if (
        field.value === "status"
    ) {

        if (
            quickFilter.value
        ) {

            params.set(
                "value",
                quickFilter.value
            );

        }

    }


    /* =================================================
    NORMAL TEXT FILTER
    ================================================= */

    else {

        if (
            value.value.trim()
        ) {

            params.set(
                "value",
                value.value.trim()
            );

        }

    }


    /* =================================================
    QUICK STATUS FILTER
    ================================================= */

    if (
        quickFilter.value &&
        field.value !== "status"
    ) {

        params.set(
            "status",
            quickFilter.value
        );

    }


    try {

        const response =
            await fetch(
                "/api/admin/students?" +
                params.toString()
            );


        if (!response.ok) {

            throw new Error(
                "Request failed"
            );

        }


        const data =
            await response.json();


        /* =================================================
        IMPORTANT FIX

        If this response belongs to an old search,
        completely ignore it.
        ================================================= */

        if (
            requestId !== searchRequestId
        ) {

            return;

        }


        if (!data.success) {

            throw new Error(
                data.message ||
                "Unable to load"
            );

        }


        totalMatching =
            data.total;

        totalPages =
            data.totalPages;


        /* =================================================
        ADD STUDENTS
        ================================================= */

        data.students.forEach(
            student => {

                addStudentRow(
                    student
                );

            }
        );


        loadedStudents +=
            data.students.length;


        showingCount.textContent =
            loadedStudents;


        resultText.textContent =
            `${totalMatching} matching student${
                totalMatching === 1
                    ? ""
                    : "s"
            }`;


        pageInfo.textContent =
            `Showing ${
                loadedStudents
            } of ${
                totalMatching
            }`;


        /* =================================================
        EMPTY RESULT
        ================================================= */

        if (
            totalMatching === 0
        ) {

            tableContainer.style.display =
                "none";

            emptyState.style.display =
                "block";

        }

        else {

            tableContainer.style.display =
                "block";

            emptyState.style.display =
                "none";

        }


        /* =================================================
        SHOW MORE
        ================================================= */

        if (
            currentPage < totalPages
        ) {

            showMoreBtn.style.display =
                "block";

        }

        else {

            showMoreBtn.style.display =
                "none";

        }


    }

    catch (error) {

        /*
         * Don't show an error for an old request.
         */

        if (
            requestId !== searchRequestId
        ) {

            return;

        }


        console.error(
            "Student loading error:",
            error
        );


        resultText.textContent =
            "Unable to load students";


        studentBody.innerHTML = "";


        tableContainer.style.display =
            "none";


        emptyState.style.display =
            "block";


        emptyState.innerHTML = `

            <strong>
                Unable to load students
            </strong>

            <p>
                Please refresh the page and try again.
            </p>

        `;

    }


    /*
     * Only hide loading if this is
     * still the current request.
     */

    if (
        requestId === searchRequestId
    ) {

        loading.classList.remove(
            "show"
        );

    }

}


/* =====================================================
ADD STUDENT ROW
===================================================== */

function addStudentRow(
    student
) {

    const row =
        document.createElement(
            "tr"
        );


    /* =================================================
    ROW CLICK
    ================================================= */

    row.addEventListener(
        "click",
        () => {

            window.location.href =
                `/admin/students/details/${student._id}`;

        }
    );


    /* =================================================
    INITIALS
    ================================================= */

    const initials =
        student.name
            .split(" ")
            .slice(0, 2)
            .map(
                name =>
                    name.charAt(0)
            )
            .join("")
            .toUpperCase();


    /* =================================================
    DOCUMENT COUNT
    ================================================= */

    const documentCount =
        Array.isArray(
            student.submittedDocuments
        )
            ? student.submittedDocuments.length
            : 0;


    /* =================================================
    ROW HTML
    ================================================= */

    row.innerHTML = `

        <td>

            <div class="student-name">

                <div class="student-avatar">

                    ${escapeHTML(
                        initials
                    )}

                </div>


                <div>

                    <strong>

                        ${escapeHTML(
                            student.name
                        )}

                    </strong>


                    <small>

                        UID:
                        ${escapeHTML(
                            student.uid ||
                            "—"
                        )}

                    </small>

                </div>

            </div>

        </td>


        <td>

            Class
            ${escapeHTML(
                student.class
            )}

        </td>


        <td>

            ${escapeHTML(
                student.schoolJoinSession ||
                "—"
            )}

        </td>


        <td>

            ${escapeHTML(
                student.mobile ||
                "—"
            )}

        </td>


        <td>

            ${escapeHTML(
                student.fatherName ||
                "—"
            )}

        </td>


        <td>

            <span class="documents">

                ${documentCount}

                ${
                    documentCount === 1
                        ? "document"
                        : "documents"
                }

            </span>

        </td>


        <td>

            <span
                class="
                    status
                    ${
                        student.status ===
                        "active"
                            ? "active"
                            : "deactive"
                    }
                "
            >

                ●

                ${
                    student.status ===
                    "active"
                        ? "Active"
                        : "Deactive"
                }

            </span>

        </td>


        <td>

            <a
                href="/admin/students/update/${student._id}"
                class="edit-btn"
                onclick="event.stopPropagation();"
            >

                ✎ Edit

            </a>

        </td>

    `;


    studentBody.appendChild(
        row
    );

}


/* =====================================================
SHOW MORE
===================================================== */

showMoreBtn.addEventListener(
    "click",
    () => {

        if (
            currentPage <
            totalPages
        ) {

            currentPage++;

            loadStudents(
                true,
                searchRequestId
            );

        }

    }
);


/* =====================================================
CLEAR FILTERS
===================================================== */

clearBtn.addEventListener(
    "click",
    () => {

        field.value =
            "name";

        value.value =
            "";

        quickFilter.value =
            "";

        classFilter.value =
            "";

        documentFilter.value =
            "";

        value.style.display =
            "block";

        extraFilter.classList.remove(
            "show"
        );

        classFilter.style.display =
            "none";

        documentFilter.style.display =
            "none";

        value.placeholder =
            "Search student name...";

        resetAndSearch();

    }
);


/* =====================================================
ESCAPE HTML
===================================================== */

function escapeHTML(
    value
) {

    return String(value)

        .replaceAll(
            "&",
            "&amp;"
        )

        .replaceAll(
            "<",
            "&lt;"
        )

        .replaceAll(
            ">",
            "&gt;"
        )

        .replaceAll(
            '"',
            "&quot;"
        )

        .replaceAll(
            "'",
            "&#039;"
        );

}


/* =====================================================
MOBILE MENU
===================================================== */

const menuBtn =
    document.getElementById(
        "menuBtn"
    );

const sidebar =
    document.getElementById(
        "sidebar"
    );


