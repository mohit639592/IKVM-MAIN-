            <span>${students.length} student${students.length === 1 ? "" : "s"}</span>
            <span>Generated: ${escapeHTML(today)}</span>
        </div>
    </div>

    <div class="table-wrap">
        <table id="studentTable">
            <colgroup>
                <col data-col="0">
                ${fields.map((_, i) => `<col data-col="${i + 1}">`).join("")}
            </colgroup>
            <thead>
                <tr>
                    <th class="serial" data-col-index="0">
                        <span class="th-label">S.No.</span>
                        <span class="col-resizer" data-col-index="0" title="Drag to resize column"></span>
                    </th>
                    ${headerHTML}
                </tr>
            </thead>
            <tbody>
                ${bodyHTML}
            </tbody>
        </table>
    </div>

    <div class="footer">
        <span>IKVM Student Management</span>
        <span>Student Information Report</span>
    </div>
</main>

<script>
(function () {
    const table = document.getElementById("studentTable");
    const paper = document.getElementById("paper");
    const storageKey = "ikvm_student_print_layout_v1";
    let savedLayout = null;

    function setColumnWidth(index, widthPx) {
        const cols = table.querySelectorAll("colgroup col");
        const col = cols[index];
        if (!col) return;
        const min = index === 0 ? 40 : 55;
        col.style.width = Math.max(min, widthPx) + "px";
    }

    function currentColumnWidths() {
        return [...table.querySelectorAll("colgroup col")].map(col => {
            const rect = col.getBoundingClientRect();
            return Math.round(rect.width);
        });
    }

    function currentRowHeights() {
        return [...table.querySelectorAll("tbody tr")].map(row =>
            Math.round(row.getBoundingClientRect().height)
        );
    }

    function saveLayout() {
        const layout = {
            columns: currentColumnWidths(),
            rows: currentRowHeights()
        };
        try {
            localStorage.setItem(storageKey, JSON.stringify(layout));
            savedLayout = layout;
            alert("Print layout saved.");
        } catch (error) {
            console.error(error);
            alert("Unable to save the print layout in this browser.");
        }
    }

    function applyLayout(layout) {
        if (!layout) return;

        if (Array.isArray(layout.columns)) {
            layout.columns.forEach((width, index) => {
                if (Number.isFinite(Number(width))) {
                    setColumnWidth(index, Number(width));
                }
            });
        }

        if (Array.isArray(layout.rows)) {
            const rows = table.querySelectorAll("tbody tr");
            layout.rows.forEach((height, index) => {
                const row = rows[index];
                if (row && Number.isFinite(Number(height))) {
                    row.style.height = Math.max(24, Number(height)) + "px";
                }
            });
        }
    }

    function resetLayout() {
        try {
            localStorage.removeItem(storageKey);
        } catch (error) {}

        table.querySelectorAll("colgroup col").forEach(col => col.style.width = "");
        table.querySelectorAll("tbody tr").forEach(row => row.style.height = "");
        savedLayout = null;
    }

    window.saveLayout = saveLayout;
    window.resetLayout = resetLayout;

    try {
        savedLayout = JSON.parse(localStorage.getItem(storageKey) || "null");
        applyLayout(savedLayout);
    } catch (error) {
        savedLayout = null;
    }

    /* Column resizing */
    let columnDrag = null;

    table.addEventListener("mousedown", event => {
        const handle = event.target.closest(".col-resizer");
        if (!handle) return;

        event.preventDefault();
        const index = Number(handle.dataset.colIndex);
        const cols = table.querySelectorAll("colgroup col");
        const col = cols[index];
        if (!col) return;

        columnDrag = {
            index,
            startX: event.clientX,
            startWidth: col.getBoundingClientRect().width
        };

        handle.classList.add("dragging");
        document.body.style.cursor = "col-resize";
        document.body.style.userSelect = "none";
    });

    document.addEventListener("mousemove", event => {
        if (!columnDrag) return;
        const width = columnDrag.startWidth + (event.clientX - columnDrag.startX);
        setColumnWidth(columnDrag.index, width);
    });

    document.addEventListener("mouseup", () => {
        if (!columnDrag) return;
        document.querySelectorAll(".col-resizer.dragging")
            .forEach(x => x.classList.remove("dragging"));
        columnDrag = null;
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
    });

    /* Row resizing */
    let rowDrag = null;

    table.addEventListener("mousedown", event => {
        const handle = event.target.closest(".row-resizer");
        if (!handle) return;

        event.preventDefault();
        const row = handle.closest("tr");
        if (!row || !row.parentElement.matches("tbody")) return;

        rowDrag = {
            row,
            startY: event.clientY,
            startHeight: row.getBoundingClientRect().height
        };

        handle.classList.add("dragging");
        document.body.style.cursor = "row-resize";
        document.body.style.userSelect = "none";
    });

    document.addEventListener("mousemove", event => {
        if (!rowDrag) return;
        const height = rowDrag.startHeight + (event.clientY - rowDrag.startY);
        rowDrag.row.style.height = Math.max(24, height) + "px";
    });

    document.addEventListener("mouseup", () => {
        if (!rowDrag) return;
        document.querySelectorAll(".row-resizer.dragging")
            .forEach(x => x.classList.remove("dragging"));
        rowDrag = null;
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
    });

    /* Re-apply saved layout after the table has completed its first layout pass. */
    requestAnimationFrame(() => applyLayout(savedLayout));
})();
</scr${"ipt"}>

</body>
</html>
    `);

    preview.document.close();
}

