</aside>


<!-- =====================================================
MAIN
===================================================== -->

<main class="main">


    <div class="topbar">


        <div class="top-left">

            <button
                class="mobile-menu"
                id="menuBtn"
            >
                ☰
            </button>


            <div class="page-title">

                <small>
                    STUDENT MANAGEMENT
                </small>

                <h1>
                    Students
                </h1>

            </div>

        </div>


        <div style="display:flex;align-items:center;gap:8px;">
            <button
                type="button"
                class="print-students-btn"
                id="printStudentsBtn"
            >
                🖨
                <span>Print Students</span>
            </button>

            <a
                href="/admin/students/add"
                class="add-student"
            >
                +
                <span>Add Student</span>
            </a>
        </div>


    </div>


    <div class="content">


        <!-- SUMMARY -->

        <section class="summary">


            <div class="summary-card">

                <span>
                    TOTAL STUDENTS
                </span>

                <strong id="totalCount">

                    <%= totalStudents || 0 %>

                </strong>

                <small>
                    All registered students
                </small>

            </div>


            <div class="summary-card">

                <span>
                    ACTIVE
                </span>

                <strong
                    class="green"
                    id="activeCount"
                >

                    <%= activeStudents || 0 %>

                </strong>

                <small>
                    Currently enrolled
                </small>

            </div>


            <div class="summary-card">

                <span>
                    DEACTIVE
                </span>

                <strong
                    class="red"
                    id="deactiveCount"
                >

                    <%= deactiveStudents || 0 %>

                </strong>

                <small>
                    Former / inactive
                </small>

            </div>


            <div class="summary-card">

                <span>
                    SHOWING
                </span>

                <strong id="showingCount">
                    0
                </strong>

                <small>
                    Matching records
                </small>

            </div>


        </section>


        <!-- FILTER -->

        <section class="filter-panel">


            <div class="filter-header">

                <div class="filter-title">

                    <h2>
                        Find Student
                    </h2>

                    <p>
                        Search students by any available field
