        Notices

    </a>


    <div class="nav-label">
        SYSTEM
    </div>


    <a
        href="/admin/reports"
        class="nav-item"
    >

        <div class="nav-icon">
            ◫
        </div>

        Reports

    </a>


    <a
        href="/admin/settings"
