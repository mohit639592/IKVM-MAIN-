/* =====================================================
PRINT STUDENTS SYSTEM
===================================================== */

const printStudentsBtn = document.getElementById("printStudentsBtn");
const printModal = document.getElementById("printModal");
const printCloseBtn = document.getElementById("printCloseBtn");
const printStudentList = document.getElementById("printStudentList");
const printStudentCount = document.getElementById("printStudentCount");
const printFooterCount = document.getElementById("printFooterCount");
const confirmPrintBtn = document.getElementById("confirmPrintBtn");
const printCandidates = document.getElementById("printCandidates");
const printAddSearch = document.getElementById("printAddSearch");
const printAddSearchBtn = document.getElementById("printAddSearchBtn");
const printAddSelectedBtn = document.getElementById("printAddSelectedBtn");
const printFieldList = document.getElementById("printFieldList");

let selectedPrintStudents = new Map();
let printCandidatesMap = new Map();
let printSearchRequestId = 0;

/*
 * These are the current Student model's direct fields.
 * Custom fields are discovered from the selected students automatically.
 *
 * Excluded technical Mongo/Mongoose fields:
 * _id, __v, createdAt, updatedAt
 */
let studentModelPrintFields = [];

async function loadPrintFieldMetadata() {
    const response = await fetch("/api/admin/students/print-fields");

    if (!response.ok) {
        throw new Error("Unable to load Student model fields.");
    }

    const data = await response.json();

    if (!data.success || !Array.isArray(data.fields)) {
        throw new Error(data.message || "Unable to load Student model fields.");
    }

    studentModelPrintFields = data.fields.map(field => [
        String(field.key),
        String(field.label || labelizePrintKey(field.key))
    ]);

    return studentModelPrintFields;
}

const defaultPrintFields = new Set([
    "name",
    "class",
    "academicSession",
    "fatherName",
    "motherName"
]);

function printStudentKey(student) {
    return String(
        student._id ||
        [
            student.name || "",
            student.class || "",
            student.uid || "",
            student.serialNo || "",
            student.aadhaar || ""
        ].join("|")
    );
}

function currentPrintSearchParams() {
    const params = new URLSearchParams();

    params.set("field", field.value);

    if (field.value === "class") {
        if (classFilter.value) {
            params.set("value", classFilter.value);
        }
    } else if (field.value === "document") {
        if (documentFilter.value.trim()) {
            params.set("value", documentFilter.value.trim());
        }
    } else if (field.value === "status") {
        if (quickFilter.value) {
            params.set("value", quickFilter.value);
        }
    } else if (value.value.trim()) {
        params.set("value", value.value.trim());
    }

    if (quickFilter.value && field.value !== "status") {
        params.set("status", quickFilter.value);
    }

    params.set("page", "1");
    params.set("limit", "100");

    return params;
}

async function fetchPrintSearchResults(params) {
    const response = await fetch(
        "/api/admin/students?" + params.toString()
    );

    if (!response.ok) {
        throw new Error("Unable to load students.");
    }

    const data = await response.json();

    if (!data.success) {
        throw new Error(data.message || "Unable to load students.");
    }

    return data;
}

async function fetchFullPrintStudents(students) {
    const ids = [...new Set(
        students
            .map(student => student && student._id)
            .filter(Boolean)
            .map(String)
    )];

    if (!ids.length) {
        throw new Error("No valid student records were selected.");
    }

    const response = await fetch("/api/admin/students/print-data", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ids })
    });

    if (!response.ok) {
        throw new Error("Unable to load complete student information.");
    }

    const data = await response.json();

    if (!data.success || !Array.isArray(data.students)) {
        throw new Error(data.message || "Unable to load complete student information.");
    }

    const byId = new Map(
        data.students.map(student => [String(student._id), student])
    );

    return students.map(student => byId.get(String(student._id)) || student);
}

async function fetchAllCurrentSearchStudents() {
    const base = currentPrintSearchParams();
    base.set("page", "1");

    const first = await fetchPrintSearchResults(base);
    const students = [...(first.students || [])];

    const totalPages = Number(first.totalPages || 1);

    for (let page = 2; page <= totalPages; page++) {
        const params = new URLSearchParams(base);
        params.set("page", String(page));

        const data = await fetchPrintSearchResults(params);
        students.push(...(data.students || []));
    }

    return students;
}

function renderPrintFields() {
    const previousChecked = new Set(
        [...document.querySelectorAll("[data-print-field]:checked")]
            .map(x => x.dataset.printField)
    );

    const shouldPreserve =
        document.querySelectorAll("[data-print-field]").length > 0;

    printFieldList.innerHTML = "";

    const directTitle = document.createElement("div");
    directTitle.className = "print-field-group-title";
    directTitle.textContent = "STUDENT MODEL FIELDS";
    printFieldList.appendChild(directTitle);

    studentModelPrintFields.forEach(([key, label]) => {

        const row = document.createElement("label");
        row.className = "print-field-row";

        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.dataset.printField = key;

        checkbox.checked =
            shouldPreserve
                ? previousChecked.has(key)
                : defaultPrintFields.has(key);

        const text = document.createElement("span");
        text.textContent = label;

        row.appendChild(checkbox);
        row.appendChild(text);

        printFieldList.appendChild(row);
    });

    const customNames = new Set();

    selectedPrintStudents.forEach(student => {
        if (!Array.isArray(student.customFields)) return;

        student.customFields.forEach(item => {
            const name = String(item?.name || "").trim();
            if (name) customNames.add(name);
        });
    });

    if (customNames.size) {

        const customTitle = document.createElement("div");
        customTitle.className = "print-field-group-title";
        customTitle.textContent = "CUSTOM FIELDS";
        printFieldList.appendChild(customTitle);

        [...customNames]
            .sort((a, b) => a.localeCompare(b))
            .forEach(name => {

                const key = "custom:" + name;

                const row = document.createElement("label");
                row.className = "print-field-row custom";

                const checkbox = document.createElement("input");
                checkbox.type = "checkbox";
                checkbox.dataset.printField = key;
                checkbox.checked = shouldPreserve
                    ? previousChecked.has(key)
                    : false;

                const text = document.createElement("span");
                text.textContent = name;

                row.appendChild(checkbox);
                row.appendChild(text);

                printFieldList.appendChild(row);
            });
    }

    const customDocuments = document.createElement("div");
    customDocuments.className = "print-field-group-title";
    customDocuments.textContent = "NOTE";
    printFieldList.appendChild(customDocuments);

    const note = document.createElement("div");
    note.style.cssText =
        "color:#596172;font-size:7px;line-height:1.6;padding:0 0 10px;";
    note.textContent =
        "Fields above are read from the current Student model. Custom field names are collected from the students selected for this print.";
    printFieldList.appendChild(note);
}

function getSelectedPrintFields() {
    return [
        ...document.querySelectorAll("[data-print-field]:checked")
    ].map(x => x.dataset.printField);
}

function updatePrintCounts() {
    let checked = 0;

    printStudentList
        .querySelectorAll("[data-print-student]:checked")
        .forEach(() => checked++);

    printStudentCount.textContent =
        `${checked} selected`;

    printFooterCount.textContent = checked;

    confirmPrintBtn.disabled = checked === 0;
}

function renderPrintStudents() {

    const previousCheckedKeys = new Set(
        [...printStudentList.querySelectorAll("[data-print-student]:checked")]
            .map(box => box.dataset.printStudent)
    );
    const hadPreviousRows =
        printStudentList.querySelectorAll("[data-print-student]").length > 0;

    printStudentList.innerHTML = "";

    if (!selectedPrintStudents.size) {
        printStudentList.innerHTML = `
            <div class="print-empty">
                No students selected.<br>
                Search students first, then open Print Students.
            </div>
        `;

        updatePrintCounts();
        renderPrintFields();
        return;
    }

    selectedPrintStudents.forEach((student, key) => {

        const row = document.createElement("label");
        row.className = "print-selection-row";

        const initials = String(student.name || "?")
            .split(/\s+/)
            .slice(0, 2)
            .map(x => x.charAt(0))
            .join("")
            .toUpperCase();

        row.innerHTML = `
            <input
                type="checkbox"
                data-print-student="${escapeHTML(key)}"
                ${!hadPreviousRows || previousCheckedKeys.has(key) ? "checked" : ""}
            >

            <div class="print-avatar">
                ${escapeHTML(initials)}
            </div>

            <div class="print-student-info">
                <strong>${escapeHTML(student.name || "Unnamed Student")}</strong>
                <small>
                    Class ${escapeHTML(student.class ?? "—")}
                    ${student.uid ? " • UID: " + escapeHTML(student.uid) : ""}
                    ${student.serialNo ? " • Sr: " + escapeHTML(student.serialNo) : ""}
                </small>
            </div>
        `;

        printStudentList.appendChild(row);
    });

    printStudentList
        .querySelectorAll("[data-print-student]")
        .forEach(box => {
            box.addEventListener("change", updatePrintCounts);
        });

    updatePrintCounts();
    renderPrintFields();
}

async function openPrintStudents() {

    printModal.classList.add("show");

    printStudentList.innerHTML = `
        <div class="print-empty">Loading all matching students...</div>
    `;

    try {

        await loadPrintFieldMetadata();
        const students = await fetchAllCurrentSearchStudents();

        selectedPrintStudents.clear();

        students.forEach(student => {
            selectedPrintStudents.set(
                printStudentKey(student),
                student
            );
        });

        renderPrintStudents();

    } catch (error) {

        console.error("Print student loading error:", error);

        printStudentList.innerHTML = `
            <div class="print-empty">
                Unable to load students for printing.<br>
                ${escapeHTML(error.message || "Please try again.")}
            </div>
        `;
    }
}

function getCheckedPrintStudents() {
    const checkedKeys = new Set(
        [
            ...printStudentList.querySelectorAll(
                "[data-print-student]:checked"
            )
        ].map(x => x.dataset.printStudent)
    );

    return [...selectedPrintStudents.entries()]
        .filter(([key]) => checkedKeys.has(key))
        .map(([, student]) => student);
}

function renderPrintCandidates() {

    printCandidates.innerHTML = "";

    if (!printCandidatesMap.size) {
        printCandidates.innerHTML = `
            <div class="print-empty">
                No matching students found.
            </div>
        `;

        printAddSelectedBtn.disabled = true;
        return;
    }

    printCandidatesMap.forEach((student, key) => {

        const alreadyAdded =
            selectedPrintStudents.has(key);

        const row = document.createElement("label");
        row.className = "print-candidate-row";

        row.innerHTML = `
            <input
                type="checkbox"
                data-print-candidate="${escapeHTML(key)}"
                ${alreadyAdded ? "disabled" : ""}
            >

            <div class="print-candidate-info">
                <strong>${escapeHTML(student.name || "Unnamed Student")}</strong>
                <small>
                    Class ${escapeHTML(student.class ?? "—")}
                    ${student.uid ? " • UID: " + escapeHTML(student.uid) : ""}
                    ${student.serialNo ? " • Sr: " + escapeHTML(student.serialNo) : ""}
                    ${student.aadhaar ? " • Aadhaar: " + escapeHTML(student.aadhaar) : ""}
                </small>
            </div>

            ${alreadyAdded
                ? '<span class="print-already">Already added</span>'
                : ""}
        `;

        printCandidates.appendChild(row);
    });

    printCandidates
        .querySelectorAll("[data-print-candidate]")
        .forEach(box => {
            box.addEventListener("change", updateCandidateButton);
        });

    updateCandidateButton();
}

function updateCandidateButton() {

    const count =
        printCandidates.querySelectorAll(
            "[data-print-candidate]:checked"
        ).length;

    printAddSelectedBtn.disabled = count === 0;

    printAddSelectedBtn.textContent =
        count
            ? `Add ${count} Selected Student${count === 1 ? "" : "s"}`
            : "Add Selected Students";
}

async function searchPrintCandidates() {

    const search = printAddSearch.value.trim();

    if (!search) {
        printCandidates.innerHTML = `
            <div class="print-empty">
                Enter a name, UID, Aadhaar, mobile, or serial number.
            </div>
        `;
        printAddSelectedBtn.disabled = true;
        return;
    }

    const requestId = ++printSearchRequestId;

    printAddSearchBtn.disabled = true;
    printAddSearchBtn.textContent = "...";

    printCandidates.innerHTML = `
        <div class="print-empty">Searching students...</div>
    `;

    try {

        /*
         * Search the existing student API.
         * We deliberately DO NOT auto-add anything.
         * Every match is shown as a checkbox first.
         */
        const fieldsToTry = [
            "name",
            "uid",
            "aadhaar",
            "mobile",
            "serialNo",
            "fatherName",
            "motherName"
        ];

        const matches = new Map();

        for (const searchField of fieldsToTry) {

            const params = new URLSearchParams();

            params.set("field", searchField);
            params.set("value", search);
            params.set("page", "1");
            params.set("limit", "50");

            const data = await fetchPrintSearchResults(params);

            if (requestId !== printSearchRequestId) return;

            (data.students || []).forEach(student => {
                matches.set(printStudentKey(student), student);
            });
        }

        printCandidatesMap = matches;

        renderPrintCandidates();

    } catch (error) {

        console.error("Print candidate search error:", error);

        printCandidates.innerHTML = `
            <div class="print-empty">
                Unable to search students.<br>
                ${escapeHTML(error.message || "Please try again.")}
            </div>
        `;

    } finally {

        if (requestId === printSearchRequestId) {
            printAddSearchBtn.disabled = false;
            printAddSearchBtn.textContent = "Search";
        }
    }
}

function addSelectedPrintCandidates() {

    const keys = [
        ...printCandidates.querySelectorAll(
            "[data-print-candidate]:checked"
        )
    ].map(x => x.dataset.printCandidate);

    if (!keys.length) return;

    keys.forEach(key => {

        const student = printCandidatesMap.get(key);

        if (student) {
            selectedPrintStudents.set(key, student);
        }
    });

    printAddSearch.value = "";
    printCandidatesMap.clear();

    printCandidates.innerHTML = `
        <div class="print-empty">
            Student(s) added. Search again to add another student.
        </div>
    `;

    printAddSelectedBtn.disabled = true;
    printAddSelectedBtn.textContent = "Add Selected Students";

    renderPrintStudents();
}

function selectedValue(student, fieldKey) {

    if (fieldKey.startsWith("custom:")) {

        const customName =
            fieldKey.slice("custom:".length).trim();

        const found =
            Array.isArray(student.customFields)
                ? student.customFields.find(
                    item =>
                        String(item?.name || "").trim() === customName
                )
                : null;

        return found?.value || "—";
    }

    const value = student[fieldKey];

    if (value === null || value === undefined || value === "") {
        return "—";
    }

    if (Array.isArray(value)) {

        if (!value.length) return "—";

        return value.map(item => {

            if (typeof item === "object" && item !== null) {

                return Object.entries(item)
                    .filter(([key]) => key !== "_id")
                    .map(
                        ([key, val]) =>
                            `${labelizePrintKey(key)}: ${val ?? "—"}`
                    )
                    .join(", ");
            }

            return String(item);

        }).join(" | ");
    }

    return String(value);
}

function labelizePrintKey(key) {

    return String(key)
        .replace(/([a-z])([A-Z])/g, "$1 $2")
        .replace(/[_-]+/g, " ")
        .replace(/\b\w/g, c => c.toUpperCase())
        .trim();
}

async function openA4PrintPreview() {

    const selectedStudents = getCheckedPrintStudents();
    const fields = getSelectedPrintFields();

    if (!selectedStudents.length) {
        alert("Please select at least one student.");
        return;
    }

    if (!fields.length) {
        alert("Please select at least one information field.");
        return;
    }

    let students;

    try {
        students = await fetchFullPrintStudents(selectedStudents);
    } catch (error) {
        console.error("Print data loading error:", error);
        alert(error.message || "Unable to load complete student information.");
        return;
    }

    const sortOrder =
        document.getElementById("printSortOrder")?.value || "default";

    const normalize = value =>
        String(value ?? "")
            .trim()
            .toLocaleLowerCase("en-IN");

    const classValue = student => {
        const raw = selectedValue(student, "class");
        const number = Number.parseInt(String(raw).replace(/[^0-9-]/g, ""), 10);
        return Number.isFinite(number) ? number : 999999;
    };

    const nameValue = student => normalize(
        student.name || selectedValue(student, "name") || ""
    );

    students = [...students];

    if (sortOrder !== "default") {
        students.sort((a, b) => {
            const aName = nameValue(a);
            const bName = nameValue(b);
            const aClass = classValue(a);
            const bClass = classValue(b);

            if (sortOrder === "name-asc") {
                return aName.localeCompare(bName, "en", { sensitivity: "base" });
            }

            if (sortOrder === "name-desc") {
                return bName.localeCompare(aName, "en", { sensitivity: "base" });
            }

            if (sortOrder === "class-asc") {
                return aClass - bClass || aName.localeCompare(bName, "en", { sensitivity: "base" });
            }

            if (sortOrder === "class-desc") {
                return bClass - aClass || aName.localeCompare(bName, "en", { sensitivity: "base" });
            }

            if (sortOrder === "class-name") {
                return aClass - bClass || aName.localeCompare(bName, "en", { sensitivity: "base" });
            }

            if (sortOrder === "name-class") {
                return aName.localeCompare(bName, "en", { sensitivity: "base" }) || aClass - bClass;
            }

            return 0;
        });
    }

    const headers = fields.map(fieldKey => {

        if (fieldKey.startsWith("custom:")) {
            return fieldKey.slice("custom:".length);
        }

        const found =
            studentModelPrintFields.find(
                ([key]) => key === fieldKey
            );

        return found ? found[1] : labelizePrintKey(fieldKey);
    });

    const headerHTML = headers
        .map((label, index) => `
            <th data-col-index="${index + 1}">
                <span class="th-label">${escapeHTML(label)}</span>
                <span class="col-resizer" data-col-index="${index + 1}" title="Drag to resize column"></span>
            </th>
        `)
        .join("");

    const bodyHTML = students.map((student, index) => {

        const cells = fields
            .map((fieldKey, fieldIndex) => `
                <td data-col-index="${fieldIndex + 1}">
                    <div class="cell-content">${escapeHTML(
                        selectedValue(student, fieldKey)
                    )}</div>
                    <span class="row-resizer" title="Drag to resize row"></span>
                </td>
            `)
            .join("");

        return `
            <tr data-row-index="${index}">
                <td class="serial" data-col-index="0">
                    <div class="cell-content">${index + 1}</div>
                    <span class="row-resizer" title="Drag to resize row"></span>
                </td>
                ${cells}
            </tr>
        `;
    }).join("");

    const today = new Date().toLocaleDateString("en-IN");

    const preview = window.open(
        "",
        "_blank",
        "width=1300,height=900"
    );

    if (!preview) {
        alert("Please allow pop-ups for the IKVM admin portal.");
        return;
    }

    preview.document.write(`
