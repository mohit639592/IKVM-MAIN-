<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>IKVM | Add Student</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #07090d;
            --sidebar: #090b11;
            --card: rgba(255,255,255,.025);
            --border: rgba(255,255,255,.07);
            --text: #f5f7ff;
            --muted: #777f91;
            --muted2: #555d6e;
            --primary: #687cff;
            --purple: #914cff;
            --green: #4ed39a;
            --red: #ff6878;
        }

        body {
            font-family: "Inter", sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input,
        select {
            font-family: inherit;
        }


        /* BACKGROUND */

        body::before {
            content: "";

            position: fixed;
            inset: 0;

            background-image:
                linear-gradient(
                    rgba(255,255,255,.018) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,.018) 1px,
                    transparent 1px
                );

            background-size: 70px 70px;

            mask-image: linear-gradient(
                to bottom,
                black,
                transparent 90%
            );

            pointer-events: none;

            z-index: -2;
        }


        .glow {
            position: fixed;

            width: 400px;
            height: 400px;

            border-radius: 50%;

            filter: blur(150px);

            opacity: .07;

            pointer-events: none;

            z-index: -1;
        }

        .glow-one {
            background: #566fff;

            top: -200px;
            left: 100px;
        }

        .glow-two {
            background: #914cff;

            right: -200px;
            bottom: 100px;
        }


        /* LAYOUT */

        .layout {
            min-height: 100vh;
        }


        /* SIDEBAR */

        .sidebar {
            width: 250px;

            position: fixed;

            top: 0;
            bottom: 0;
            left: 0;

            padding: 24px 16px;

            background: rgba(9,11,17,.96);

            border-right: 1px solid var(--border);

            backdrop-filter: blur(20px);

            z-index: 20;
        }


        .brand {
            display: flex;

            align-items: center;

            gap: 11px;

            padding: 0 10px;

            margin-bottom: 38px;
        }


        .brand-icon {
            width: 36px;
            height: 36px;

            display: grid;
            place-items: center;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    #6078ff,
                    #914cff
                );

            box-shadow:
                0 10px 30px rgba(80,80,255,.25);

            font-size: 13px;

            font-weight: 800;
        }


        .brand-text strong {
            display: block;

            font-size: 15px;
        }


        .brand-text span {
            color: #606777;

            font-size: 8px;

            letter-spacing: 1px;
        }


        .nav-label {
            padding: 0 11px;

            margin: 22px 0 10px;

            color: #4e5666;

            font-size: 9px;

            letter-spacing: 1.5px;

            font-weight: 700;
        }


        .nav-item {
            display: flex;

            align-items: center;

            gap: 12px;

            width: 100%;

            padding: 10px 12px;

            margin-bottom: 4px;

            border-radius: 9px;

            color: #737a8b;

            font-size: 11px;

            transition: .25s;
        }


        .nav-item:hover {
            color: #e1e4ed;

            background: rgba(255,255,255,.04);
        }


        .nav-item.active {
            color: #8090ff;

            background:
                linear-gradient(
                    90deg,
                    rgba(91,111,255,.16),
                    rgba(91,111,255,.04)
                );

            border: 1px solid rgba(100,120,255,.08);
        }


        .nav-icon {
            width: 27px;
            height: 27px;

            display: grid;
            place-items: center;

            border-radius: 7px;

            font-size: 11px;
        }


        .nav-item.active .nav-icon {
            background: rgba(100,120,255,.12);
        }


        .sidebar-bottom {
            position: absolute;

            left: 16px;
            right: 16px;
            bottom: 20px;
        }


        .user-mini {
            display: flex;

            align-items: center;

            gap: 9px;

            padding: 10px;

            border: 1px solid var(--border);

            border-radius: 10px;

            background: rgba(255,255,255,.025);
        }


        .avatar {
            width: 31px;
            height: 31px;

            display: grid;
            place-items: center;

            flex-shrink: 0;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #566fff,
                    #8b4cff
                );

            font-size: 10px;

            font-weight: 700;
        }


        .user-info {
            min-width: 0;

            flex: 1;
        }


        .user-info strong {
            display: block;

            font-size: 9px;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }


        .user-info span {
            color: #626979;

            font-size: 7px;
        }


        .logout {
            color: #666d7e;

            font-size: 12px;

            transition: .2s;
        }


        .logout:hover {
            color: var(--red);
        }


        /* MAIN */

        .main {
            margin-left: 250px;

            min-height: 100vh;

            padding: 25px 35px;
        }


        /* TOPBAR */

        .topbar {
            display: flex;

            align-items: center;

            justify-content: space-between;

            padding-bottom: 20px;

            border-bottom: 1px solid var(--border);
        }


        .page-title small {
            color: #626979;

            font-size: 9px;

            letter-spacing: 1px;
        }


        .page-title h1 {
            margin-top: 4px;

            font-size: 22px;

            letter-spacing: -.5px;
        }


        .back-btn {
            display: flex;

            align-items: center;

            gap: 7px;

            padding: 9px 13px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background: var(--card);

            color: #858c9d;

            font-size: 9px;

            transition: .2s;
        }


        .back-btn:hover {
            color: white;

            background: rgba(255,255,255,.05);
        }


        /* FORM */

        .form-container {
            max-width: 1000px;

            margin: 24px auto 50px;
        }


        .intro {
            margin-bottom: 18px;
        }


        .intro h2 {
            font-size: 16px;
        }


        .intro p {
            margin-top: 5px;

            color: var(--muted);

            font-size: 9px;
        }


        .form-card {
            padding: 23px;

            margin-bottom: 15px;

            border: 1px solid var(--border);

            border-radius: 13px;

            background: var(--card);
        }


        .card-heading {
            display: flex;

            align-items: center;

            gap: 11px;

            margin-bottom: 22px;
        }


        .heading-icon {
            width: 32px;
            height: 32px;

            display: grid;
            place-items: center;

            border-radius: 8px;

            background: rgba(90,110,255,.1);

            color: var(--primary);

            font-size: 11px;
        }


        .card-heading h3 {
            font-size: 12px;
        }


        .card-heading p {
            margin-top: 3px;

            color: #5e6676;

            font-size: 7px;
        }


        /* FORM GRID */

        .form-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 16px;
        }


        .form-group {
            display: flex;

            flex-direction: column;

            gap: 7px;
        }


        .form-group.full {
            grid-column: 1 / -1;
        }


        .form-group label {
            color: #858c9c;

            font-size: 8px;

            font-weight: 600;
        }


        .required {
            color: #7182ff;
        }


        .optional {
            color: #4f5767;

            font-weight: 400;

            margin-left: 3px;
        }


        .form-group input,
        .form-group select {
            width: 100%;

            height: 42px;

            padding: 0 12px;

            border: 1px solid var(--border);

            border-radius: 8px;

            outline: none;

            background: rgba(255,255,255,.025);

            color: #e8ebf3;

            font-size: 9px;

            transition: .2s;
        }


        .form-group input::placeholder {
            color: #4f5665;
        }


        .form-group select {
            appearance: none;

            cursor: pointer;

            background-image:
                linear-gradient(45deg, transparent 50%, #626979 50%),
                linear-gradient(135deg, #626979 50%, transparent 50%);

            background-position:
                calc(100% - 15px) 18px,
                calc(100% - 11px) 18px;

            background-size:
                5px 5px,
                5px 5px;

            background-repeat: no-repeat;
        }


        .form-group select option {
            background: #11141c;

            color: white;
        }


        .form-group input:focus,
        .form-group select:focus {
            border-color: rgba(104,124,255,.55);

            background: rgba(104,124,255,.035);

            box-shadow:
                0 0 0 3px rgba(104,124,255,.06);
        }


        /* DOCUMENTS */

        .documents-list {
            display: flex;

            flex-direction: column;

            gap: 9px;
        }


        .document-row {
            display: grid;

            grid-template-columns: 1fr auto;

            gap: 9px;
        }


        .document-row input {
            width: 100%;

            height: 40px;

            padding: 0 11px;

            border: 1px solid var(--border);

            border-radius: 8px;

            outline: none;

            background: rgba(255,255,255,.025);

            color: white;

            font-size: 9px;
        }


        .document-row input:focus {
            border-color: rgba(104,124,255,.5);
        }


        .remove-btn {
            width: 40px;
            height: 40px;

            border: 1px solid rgba(255,104,120,.1);

            border-radius: 8px;

            background: rgba(255,104,120,.04);

            color: #a85b66;

            cursor: pointer;

            transition: .2s;
        }


        .remove-btn:hover {
            background: rgba(255,104,120,.1);

            color: #ff7180;
        }


        .add-btn {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            margin-top: 12px;

            padding: 8px 11px;

            border: 1px dashed rgba(104,124,255,.25);

            border-radius: 8px;

            background: rgba(104,124,255,.035);

            color: #7585ff;

            font-size: 8px;

            cursor: pointer;

            transition: .2s;
        }


        .add-btn:hover {
            border-color: rgba(104,124,255,.5);

            background: rgba(104,124,255,.07);
        }


        /* CUSTOM FIELDS */

        .custom-list {
            display: flex;

            flex-direction: column;

            gap: 10px;
        }


        .custom-row {
            display: grid;

            grid-template-columns: 1fr 1fr auto;

            gap: 9px;
        }


        .custom-row input {
            height: 40px;

            padding: 0 11px;

            border: 1px solid var(--border);

            border-radius: 8px;

            outline: none;

            background: rgba(255,255,255,.025);

            color: white;

            font-size: 9px;
        }


        .custom-row input::placeholder {
            color: #4f5665;
        }


        .custom-row input:focus {
            border-color: rgba(104,124,255,.5);
        }


        /* FORM ACTIONS */

        .form-actions {
            display: flex;

            align-items: center;

            justify-content: flex-end;

            gap: 10px;

            padding-top: 5px;
        }


        .cancel-btn {
            padding: 11px 18px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background: rgba(255,255,255,.025);

            color: #737a8b;

            font-size: 9px;

            cursor: pointer;

            transition: .2s;
        }


        .cancel-btn:hover {
            color: white;

            background: rgba(255,255,255,.05);
        }


        .save-btn {
            padding: 11px 20px;

            border: none;

            border-radius: 8px;

            background:
                linear-gradient(
                    135deg,
                    #566fff,
                    #824cff
                );

            color: white;

            font-size: 9px;

            font-weight: 600;

            cursor: pointer;

            box-shadow:
                0 10px 25px rgba(80,80,255,.2);

            transition: .2s;
        }


        .save-btn:hover {
            transform: translateY(-1px);

            box-shadow:
                0 14px 30px rgba(80,80,255,.3);
        }


        /* MOBILE */

        .mobile-menu {
            display: none;

            width: 35px;
            height: 35px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background: var(--card);

            color: white;

            cursor: pointer;
        }


        @media(max-width: 850px) {

            .sidebar {
                transform: translateX(-100%);

                transition: .3s;

                z-index: 50;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .mobile-menu {
                display: grid;

                place-items: center;
            }

            .main {
                margin-left: 0;

                padding: 18px;
            }

            .top-left {
                display: flex;

                align-items: center;

                gap: 12px;
            }

        }


        @media(max-width: 600px) {

            .main {
                padding: 14px;
            }

            .page-title h1 {
                font-size: 19px;
            }

            .back-btn span {
                display: none;
            }

            .form-card {
                padding: 17px;
            }

            .form-grid {
                grid-template-columns: 1fr;

                gap: 14px;
            }

            .form-group.full {
                grid-column: auto;
            }

            .custom-row {
                grid-template-columns: 1fr;
            }

            .custom-row .remove-btn {
                width: 100%;
            }

            .document-row {
                grid-template-columns: 1fr;
            }

            .document-row .remove-btn {
                width: 100%;
            }

            .form-actions {
                flex-direction: column-reverse;

                width: 100%;
            }

            .cancel-btn,
            .save-btn {
                width: 100%;

                text-align: center;
            }

        }

    </style>

</head>


<body>


<div class="glow glow-one"></div>
<div class="glow glow-two"></div>


<div class="layout">


    <!-- SIDEBAR -->

    <aside class="sidebar" id="sidebar">


        <div class="brand">

            <div class="brand-icon">
                ◆
            </div>

            <div class="brand-text">

                <strong>IKVM</strong>

                <span>ADMIN PORTAL</span>

            </div>

        </div>


        <div class="nav-label">
            MAIN MENU
        </div>


        <a href="/admin/dashboard"
           class="nav-item">

            <div class="nav-icon">
                ⌂
            </div>

            <span>
                Dashboard
            </span>

        </a>


        <a href="/admin/students"
           class="nav-item active">

            <div class="nav-icon">
                ◉
            </div>

            <span>
                Students
            </span>

        </a>


        <a href="/admin/faculty"
           class="nav-item">

            <div class="nav-icon">
                ◇
            </div>

            <span>
                Faculty
            </span>

        </a>


        <div class="nav-label">
            MANAGEMENT
        </div>


        <a href="/admin/attendance"
           class="nav-item">

            <div class="nav-icon">
                ✓
            </div>

            <span>
                Attendance
            </span>

        </a>


        <a href="/admin/results"
           class="nav-item">

            <div class="nav-icon">
                %
            </div>

            <span>
                Results
            </span>

        </a>


        <a href="/admin/library"
           class="nav-item">

            <div class="nav-icon">
                ▣
            </div>

            <span>
                Library
            </span>

        </a>


        <a href="/admin/notices"
           class="nav-item">

            <div class="nav-icon">
                !
            </div>

            <span>
                Notices
            </span>

        </a>


        <div class="nav-label">
            SYSTEM
        </div>


        <a href="/admin/reports"
           class="nav-item">

            <div class="nav-icon">
                ◫
            </div>

            <span>
                Reports
            </span>

        </a>


        <a href="/admin/settings"
           class="nav-item">

            <div class="nav-icon">
                ⚙
            </div>

            <span>
                Settings
            </span>

        </a>


        <div class="sidebar-bottom">

            <div class="user-mini">

                <div class="avatar">
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>

                <div class="user-info">

                    <strong>
                        <%= user.name %>
                    </strong>

                    <span>
                        Administrator
                    </span>

                </div>

                <a href="/logout"
                   class="logout">

                    ↪

                </a>

            </div>

        </div>

    </aside>


    <!-- MAIN -->

    <main class="main">


        <!-- TOPBAR -->

        <div class="topbar">


            <div class="top-left">

                <button
                    class="mobile-menu"
                    id="menuBtn">

                    ☰

                </button>


                <div class="page-title">

                    <small>
                        STUDENT MANAGEMENT
                    </small>

                    <h1>
                        Add Student
                    </h1>

                </div>

            </div>


            <a href="/admin/students"
               class="back-btn">

                ←

                <span>
                    Back to Students
                </span>

            </a>

        </div>


        <!-- FORM -->

        <div class="form-container">


            <div class="intro">

                <h2>
                    Student Information
                </h2>

                <p>
                    Add a new student to the IKVM management system.
                </p>

            </div>


           <form
    action="/admin/students"
    method="POST">


                <!-- BASIC INFORMATION -->

                <div class="form-card">


                    <div class="card-heading">

                        <div class="heading-icon">
                            ◉
                        </div>

                        <div>

                            <h3>
                                Basic Information
                            </h3>

                            <p>
                                Primary student details
                            </p>

                        </div>

                    </div>


                    <div class="form-grid">


                        <div class="form-group full">

                            <label>
                                Student Name
                                <span class="required">*</span>
                            </label>

                            <input
                                type="text"
                                name="name"
                                placeholder="Enter student's full name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Class
                                <span class="required">*</span>
                            </label>

                            <select
                                name="class"
                                required>

                                <option value="">
                                    Select class
                                </option>

                                <% for(let i = 1; i <= 12; i++) { %>

                                    <option value="<%= i %>">
                                        Class <%= i %>
                                    </option>

                                <% } %>

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                Academic Session
                                <span class="required">*</span>
                            </label>

                            <select
                                name="academicSession"
                                required>

                                <option value="<%= academicState.sourceSession %>"
                                    <%= academicState.displaySession === academicState.sourceSession ? "selected" : "" %>>
                                    <%= academicState.sourceSession %>
                                </option>

                                <% if (academicState.targetSession !== academicState.sourceSession) { %>
                                    <option value="<%= academicState.targetSession %>"
                                        <%= academicState.displaySession === academicState.targetSession ? "selected" : "" %>>
                                        <%= academicState.targetSession %>
                                    </option>
                                <% } %>

                            </select>

                        </div>
                        <div class="form-group">

                            <label>
                                Serial / Sr. No.
                                <span class="optional">
                                    Optional
                                </span>
                            </label>

                            <input
                                type="text"
                                name="serialNo"
                                placeholder="Enter serial number"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                UID
                                <span class="optional">
                                    Optional
                                </span>
                            </label>

                            <input
                                type="text"
                                name="uid"
                                placeholder="Enter UID"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Student Aadhaar Card No.
                                <span class="optional">
                                    Optional
                                </span>
                            </label>

                            <input
                                type="text"
                                name="aadhaar"
                                inputmode="numeric"
                                maxlength="12"
                                placeholder="Enter 12 digit Aadhaar number"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Mobile Number
                                <span class="optional">
                                    Optional
                                </span>
                            </label>

                            <input
                                type="tel"
                                name="mobile"
                                inputmode="numeric"
                                maxlength="10"
                                placeholder="Enter mobile number"
                            >

                        </div>


                    </div>

                </div>


                <!-- PARENTS -->

                <div class="form-card">


                    <div class="card-heading">

                        <div class="heading-icon">
                            ◇
                        </div>

                        <div>

                            <h3>
                                Parent / Guardian Information
                            </h3>

                            <p>
                                Parent details and identification
                            </p>

                        </div>

                    </div>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                Father Name
                                <span class="required">*</span>
                            </label>

                            <input
                                type="text"
                                name="fatherName"
                                placeholder="Enter father's name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Mother Name
                                <span class="required">*</span>
                            </label>

                            <input
                                type="text"
                                name="motherName"
                                placeholder="Enter mother's name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Father Aadhaar No.
                                <span class="optional">
                                    Optional
                                </span>
                            </label>

                            <input
                                type="text"
                                name="fatherAadhaar"
                                inputmode="numeric"
                                maxlength="12"
                                placeholder="Enter father's Aadhaar"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Mother Aadhaar No.
                                <span class="optional">
                                    Optional
                                </span>
                            </label>

                            <input
                                type="text"
                                name="motherAadhaar"
                                inputmode="numeric"
                                maxlength="12"
                                placeholder="Enter mother's Aadhaar"
                            >

                        </div>


                    </div>

                </div>
                <div class="form-group">

<div class="form-group">

    <label>
        School Join Session
        <span class="required">*</span>
    </label>

    <select
        name="schoolJoinSession"
        required>

        <option value="">
            Select session
        </option>

        <option value="2022-23">2022-23</option>
        <option value="2023-24">2023-24</option>
        <option value="2024-25">2024-25</option>
        <option value="2025-26">2025-26</option>
        <option value="2026-27">2026-27</option>
        <option value="2027-28">2027-28</option>
        <option value="2028-29">2028-29</option>

    </select>

</div>


<div class="form-group">

    <label>
        Student Status
        <span class="required">*</span>
    </label>

    <select
        name="status"
        required>

        <option value="active" selected>
            Active
        </option>

        <option value="deactive">
            Deactive
        </option>

    </select>

</div>


                <!-- DOCUMENTS -->

                <div class="form-card">


                    <div class="card-heading">

                        <div class="heading-icon">
                            ▣
                        </div>

                        <div>

                            <h3>
                                Submitted Documents
                            </h3>

                            <p>
                                Record documents submitted by the student
                            </p>

                        </div>

                    </div>


                    <div
                        class="documents-list"
                        id="documentsList">


                        <div class="document-row">

                            <input
                                type="text"
                                name="documents[]"
                                placeholder="Example: TC, Photo, Birth Certificate"
                            >

                            <button
                                type="button"
                                class="remove-btn"
                                onclick="removeDocument(this)">

                                ×

                            </button>

                        </div>


                    </div>


                    <button
                        type="button"
                        class="add-btn"
                        onclick="addDocument()">

                        +

                        Add Document

                    </button>


                </div>


                <!-- CUSTOM FIELDS -->

                <div class="form-card">


                    <div class="card-heading">

                        <div class="heading-icon">
                            +
                        </div>

                        <div>

                            <h3>
                                Additional Information
                            </h3>

                            <p>
                                Add any custom field specific to this student
                            </p>

                        </div>

                    </div>


                    <div
                        class="custom-list"
                        id="customList">


                    </div>


                    <button
                        type="button"
                        class="add-btn"
                        onclick="addCustomField()">

                        +

                        Add Custom Field

                    </button>


                </div>


                <!-- ACTIONS -->

                <div class="form-actions">


                    <button
                        type="button"
                        class="cancel-btn"
                        onclick="window.location.href='/admin/students'">

                        Cancel

                    </button>


                    <button
                        type="submit"
                        class="save-btn">

                        Save Student →

                    </button>


                </div>


            </form>

        </div>


    </main>

</div>


<script>


    /* DOCUMENTS */

    function addDocument() {

        const list =
            document.getElementById("documentsList");


        const row =
            document.createElement("div");


        row.className =
            "document-row";


        row.innerHTML = `

            <input
                type="text"
                name="documents[]"
                placeholder="Enter document name"
            >

            <button
                type="button"
                class="remove-btn"
                onclick="removeDocument(this)">

                ×

            </button>

        `;


        list.appendChild(row);

    }


    function removeDocument(button) {

        const list =
            document.getElementById("documentsList");


        const rows =
            list.querySelectorAll(".document-row");


        if (rows.length <= 1) {

            button
                .parentElement
                .querySelector("input")
                .value = "";

            return;

        }


        button.parentElement.remove();

    }


    /* CUSTOM FIELDS */

    function addCustomField() {

        const list =
            document.getElementById("customList");


        const row =
            document.createElement("div");


        row.className =
            "custom-row";


        row.innerHTML = `

            <input
                type="text"
                name="customFieldName[]"
                placeholder="Field name"
            >

            <input
                type="text"
                name="customFieldValue[]"
                placeholder="Field value"
            >

            <button
                type="button"
                class="remove-btn"
                onclick="removeCustomField(this)">

                ×

            </button>

        `;


        list.appendChild(row);

    }


    function removeCustomField(button) {

        button.parentElement.remove();

    }


    /* MOBILE SIDEBAR */

    const menuBtn =
        document.getElementById("menuBtn");

    const sidebar =
        document.getElementById("sidebar");


    if (menuBtn) {

        menuBtn.addEventListener("click", () => {

            sidebar.classList.toggle("open");

        });

    }


</script>


</body>

</html>