<script>


    /* DOCUMENTS */

    function addDocument() {

        const list =
            document.getElementById("documentsList");


        const row =
            document.createElement("div");


        row.className =
            "document-row";


        row.innerHTML = `

            <input
                type="text"
                name="documents[]"
                placeholder="Enter document name"
            >

            <button
                type="button"
                class="remove-btn"
                onclick="removeDocument(this)">

                ×

            </button>

        `;


        list.appendChild(row);

    }


    function removeDocument(button) {

        const list =
            document.getElementById("documentsList");


        const rows =
            list.querySelectorAll(".document-row");


        if (rows.length <= 1) {

            button
                .parentElement
                .querySelector("input")
                .value = "";

            return;

        }


        button.parentElement.remove();

    }


    /* CUSTOM FIELDS */

    function addCustomField() {

        const list =
            document.getElementById("customList");


        const row =
            document.createElement("div");


        row.className =
            "custom-row";


        row.innerHTML = `

            <input
                type="text"
                name="customFieldName[]"
                placeholder="Field name"
            >

            <input
                type="text"
                name="customFieldValue[]"
                placeholder="Field value"
            >

            <button
                type="button"
                class="remove-btn"
                onclick="removeCustomField(this)">

                ×

            </button>

        `;


        list.appendChild(row);

    }


    function removeCustomField(button) {

        button.parentElement.remove();

    }


    /* MOBILE SIDEBAR */

    const menuBtn =
        document.getElementById("menuBtn");

    const sidebar =
        document.getElementById("sidebar");


    if (menuBtn) {

        menuBtn.addEventListener("click", () => {

            sidebar.classList.toggle("open");

        });

    }


</script>



<div class="field-builder-modal" id="fieldBuilderModal">
<div class="field-builder-card" role="dialog" aria-modal="true">
<h3 id="fieldBuilderTitle">Add Student Field</h3>
<p id="fieldBuilderDescription">Add a field to this section for one student or for every student.</p>
<div class="builder-group"><label for="newFieldName">Field Name</label><input id="newFieldName" type="text" maxlength="80" placeholder="Example: Blood Group"></div>
<div class="builder-group"><label for="newFieldType">Field Type</label><select id="newFieldType"><option value="text">Text</option><option value="number">Number</option><option value="date">Date</option><option value="email">Email</option><option value="tel">Mobile Number</option></select></div>
<div class="builder-group"><label>Apply this field to</label><div class="scope-choice"><label><input type="radio" name="newFieldScope" value="student" checked><span><strong>This Student Only</strong>Saved only for this student.</span></label><label><input type="radio" name="newFieldScope" value="all"><span><strong>Every Student</strong>Saved permanently for all students.</span></label></div></div>
<div class="builder-actions"><button type="button" class="builder-cancel" onclick="closeFieldBuilder()">Cancel</button><button type="button" class="builder-create" onclick="createDynamicField()">Add Field</button></div>
</div></div>
<script>
let fieldBuilderSection="student";
const dynamicFieldState={student:<%- JSON.stringify((dynamicFields&&dynamicFields.student)||[]) %>,parent:<%- JSON.stringify((dynamicFields&&dynamicFields.parent)||[]) %>};
function openFieldBuilder(s){fieldBuilderSection=s;document.getElementById("fieldBuilderTitle").textContent=s==="parent"?"Add Parent Field":"Add Student Field";document.getElementById("fieldBuilderDescription").textContent=s==="parent"?"Add a parent / guardian field for one student or for every student.":"Add a student field for one student or for every student.";document.getElementById("newFieldName").value="";document.getElementById("newFieldType").value="text";document.querySelector('input[name="newFieldScope"][value="student"]').checked=true;document.getElementById("fieldBuilderModal").classList.add("open");setTimeout(()=>document.getElementById("newFieldName").focus(),30)}
function closeFieldBuilder(){document.getElementById("fieldBuilderModal").classList.remove("open")}
function fieldKey(v){return v.toLowerCase().trim().replace(/[^a-z0-9]+/g,"_").replace(/^_+|_+$/g,"").replace(/_+/g,"_").slice(0,60)||("field_"+Date.now())}
function createDynamicField(){const label=document.getElementById("newFieldName").value.trim(),type=document.getElementById("newFieldType").value,scope=document.querySelector('input[name="newFieldScope"]:checked').value;if(!label){alert("Please enter a field name.");return}const key=fieldKey(label);if(dynamicFieldState[fieldBuilderSection].some(f=>f.key===key)){alert("A field with this name already exists in this section.");return}dynamicFieldState[fieldBuilderSection].push({key,label,type,scope,value:""});renderDynamicFields(fieldBuilderSection);syncDynamicFields();closeFieldBuilder()}
function renderDynamicFields(s){const c=document.getElementById(s+"DynamicFields");if(!c)return;c.innerHTML="";dynamicFieldState[s].forEach((f,index)=>{const w=document.createElement("div");w.className="form-group dynamic-field-group";const l=document.createElement("label");l.textContent=f.label;const b=document.createElement("span");b.className="optional";b.textContent=f.scope==="all"?"Permanent field":"This student only";l.appendChild(b);const i=document.createElement("input");i.type=f.type||"text";i.name="dynamic_"+s+"_"+f.key;i.dataset.dynamicSection=s;i.dataset.dynamicKey=f.key;i.value=f.value||"";i.placeholder="Enter "+f.label;const r=document.createElement("button");r.type="button";r.className="dynamic-remove";r.textContent="×";r.onclick=()=>{dynamicFieldState[s].splice(index,1);renderDynamicFields(s);syncDynamicFields()};w.append(l,i,r);c.appendChild(w)})}
function syncDynamicFields(){const d=[];["student","parent"].forEach(s=>dynamicFieldState[s].forEach(f=>d.push({section:s,key:f.key,label:f.label,type:f.type||"text",scope:f.scope||"student"})));const v={};document.querySelectorAll("[data-dynamic-section][data-dynamic-key]").forEach(i=>{const s=i.dataset.dynamicSection,k=i.dataset.dynamicKey;if(!v[s])v[s]={};v[s][k]=i.value});document.getElementById("dynamicFieldDefinitions").value=JSON.stringify(d);document.getElementById("dynamicFieldValues").value=JSON.stringify(v)}
const dynamicForm=document.querySelector('form[action="/admin/students"]');if(dynamicForm)dynamicForm.addEventListener("submit",syncDynamicFields);document.getElementById("fieldBuilderModal").addEventListener("click",e=>{if(e.target===e.currentTarget)closeFieldBuilder()});document.addEventListener("keydown",e=>{if(e.key==="Escape")closeFieldBuilder()});

// ======================================================
// LIVE AADHAAR DUPLICATE CHECK
// ======================================================

const aadhaarInput =
    document.querySelector('input[name="aadhaar"]');

const aadhaarStatus =
    document.getElementById("aadhaarStatus");

let aadhaarCheckTimer = null;
let aadhaarCheckRequest = 0;

if (aadhaarInput && aadhaarStatus) {

    aadhaarInput.addEventListener(
        "input",
        function () {

            const digits =
                this.value.replace(/\D/g, "");

            // Reset status while typing
            clearTimeout(aadhaarCheckTimer);

            aadhaarStatus.style.display = "none";
            aadhaarStatus.textContent = "";

            aadhaarInput.style.borderColor = "";

            if (digits.length !== 12) {
                aadhaarInput.setCustomValidity("");
                return;
            }

            aadhaarStatus.style.display = "block";
            aadhaarStatus.textContent =
                "Checking Aadhaar...";

            aadhaarStatus.style.color =
                "#9ca3af";

            aadhaarCheckTimer = setTimeout(
                async () => {

                    const requestId =
                        ++aadhaarCheckRequest;

                    try {

                        const response =
                            await fetch(
                                "/api/admin/students/check-aadhaar?aadhaar=" +
                                encodeURIComponent(digits)
                            );

                        const data =
                            await response.json();

                        // Ignore old request
                        if (
                            requestId !==
                            aadhaarCheckRequest
                        ) {
                            return;
                        }

                        if (!data.success) {
                            throw new Error(
                                data.message ||
                                "Check failed"
                            );
                        }

                        if (data.taken) {

                            aadhaarStatus.style.display =
                                "block";

                            aadhaarStatus.style.color =
                                "#ef4444";

                            aadhaarStatus.textContent =
                                "✕ Already Taken" +
                                (
                                    data.student
                                        ? ` — ${data.student.name} (Class ${data.student.class})`
                                        : ""
                                );

                            aadhaarInput.style.borderColor =
                                "#ef4444";

                            // Prevent form submission
                            aadhaarInput.setCustomValidity(
                                "This Aadhaar number is already registered."
                            );

                        } else {

                            aadhaarStatus.style.display =
                                "block";

                            aadhaarStatus.style.color =
                                "#22c55e";

                            aadhaarStatus.textContent =
                                "✓ Aadhaar is available";

                            aadhaarInput.style.borderColor =
                                "#22c55e";

                            aadhaarInput.setCustomValidity("");
                        }

                    } catch (error) {

                        console.error(
                            "Aadhaar check error:",
                            error
                        );

                        aadhaarStatus.style.display =
                            "block";

                        aadhaarStatus.style.color =
                            "#f59e0b";

                        aadhaarStatus.textContent =
                            "Unable to check Aadhaar right now.";

                        aadhaarInput.style.borderColor =
                            "";

                        aadhaarInput.setCustomValidity("");
                    }

                },
                300
            );
        }
    );
}
</script>

<script>
function formatAadhaar(input) {
    let digits = input.value.replace(/\D/g, '').slice(0, 12);
    input.value = digits.replace(/(\d{4})(?=\d)/g, '$1 ');
}
</script>
</body>

