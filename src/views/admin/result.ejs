/* =========================================================
   HELPERS
========================================================= */

function esc(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function numberValue(value){

    const n = Number(value);

    return Number.isFinite(n)
        ? n
        : 0;

}


function wholeNumber(value){

    return Math.round(numberValue(value));

}


function gradeFromPercentage(p){

    if(p >= 90) return "A+";
    if(p >= 80) return "A";
    if(p >= 70) return "B+";
    if(p >= 60) return "B";
    if(p >= 50) return "C";
    if(p >= 40) return "D";

    return "E";

}


