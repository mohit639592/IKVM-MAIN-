        row.dataset.classNumber=student.class||"";
        row.innerHTML=`<div>${index+1}</div><div><b>${esc(student.name||"Unnamed Student")}</b><div class="muted">Father: ${esc(student.fatherName||"-")}</div></div><input class="studentTarget" type="number" min="0" max="100" step="0.01" placeholder="Example: 85">`;
        container.appendChild(row);
    });
    card.classList.remove("hidden");
}

function addSubject(data){
    const components=activeComponents();
    const defaults=isClass11()?[[0,100],[0,30],[0,100],[0,30]]:[[8,19],[8,19],[25,55],[8,19],[8,19],[25,55]];
    const subject=data||{name:"Subject",ranges:defaults};
    const card=document.createElement("div"); card.className="subject-card";
    card.innerHTML=`<div class="subject-title"><strong>Subject</strong><div style="display:flex;align-items:center;gap:10px;"><label class="include-box"><input class="includeFinal" type="checkbox" checked> Include in Final %</label><button class="danger class11-remove" onclick="this.closest('.subject-card').remove();updateRange();">Remove</button></div></div><div class="subject-name"><label>Subject Name <input class="subjectName" value="${esc(subject.name)}" placeholder="Subject Name"></label></div><div class="component-grid">${components.map((component,index)=>`<div class="component"><b>${component.label}</b><div class="cap">Maximum ${component.max}</div><input class="componentMin" type="number" min="0" max="${component.max}" value="${subject.ranges[index]?.[0]??0}" title="Minimum"><input class="componentMax" type="number" min="0" max="${component.max}" value="${subject.ranges[index]?.[1]??component.max}" title="Maximum"><div class="cap">Min / Max</div></div>`).join("")}</div>`;
    document.getElementById("subjectsContainer").appendChild(card); updateRange();
}

function getSubjects(){
    const components=activeComponents();
    return [...document.querySelectorAll(".subject-card")].map(card=>({
        name:card.querySelector(".subjectName")?.value.trim()||"Subject",
        mins:[...card.querySelectorAll(".componentMin")].map(i=>wholeNumber(i.value)),
        maxs:[...card.querySelectorAll(".componentMax")].map(i=>wholeNumber(i.value)),
        include:card.querySelector(".includeFinal")?.checked!==false
    })).filter(s=>s.mins.length===components.length&&s.maxs.length===components.length);
}

function validateSubjects(){
    const subjects=getSubjects(),components=activeComponents();
    if(!subjects.length)return "Add at least one subject.";
    for(const subject of subjects){
        for(let i=0;i<components.length;i++){
            const maximum=components[i].max,min=Math.max(0,Math.min(maximum,wholeNumber(subject.mins[i]))),max=Math.max(0,Math.min(maximum,wholeNumber(subject.maxs[i])));
            subject.mins[i]=min;subject.maxs[i]=max;
            if(min>max)return `${subject.name} — ${components[i].label}: minimum cannot be greater than maximum.`;
        }
    }
    if(!subjects.some(s=>s.include))return "Select at least one subject to include in Final %.";
    return "";
}

function getBounds(){
    const subjects=getSubjects().filter(s=>s.include);let minimum=0,maximum=0;
    subjects.forEach(s=>{s.mins.forEach(v=>minimum+=numberValue(v));s.maxs.forEach(v=>maximum+=numberValue(v));});
    // Final marks remain /200 in both systems. For Class 11 the practical maximum
    // is allowed in the component settings, but generated totals are capped at /200.
    return {minimum,maximum,total:subjects.length*200};
}

function updateRange(){
    const error=validateSubjects(),rangeBox=document.getElementById("rangeBox"),errorBox=document.getElementById("generatorError");
    if(error){errorBox.style.display="block";errorBox.textContent="⚠️ "+error;}else errorBox.style.display="none";
    const bounds=getBounds(); if(bounds.total<=0){rangeBox.textContent="Select at least one subject to see the possible percentage.";return;}
    const minP=bounds.minimum/bounds.total*100,maxP=Math.min(100,bounds.maximum/bounds.total*100);
    rangeBox.innerHTML=`<b>Possible generated overall percentage:</b> ${minP.toFixed(2)}% - ${maxP.toFixed(2)}% &nbsp; <span style="opacity:.7">(${getSubjects().filter(s=>s.include).length} subject(s) included)</span>`;
}

function generateClass11Marks(total,subjects){
    const mins=subjects.map(s=>s.mins),maxs=subjects.map(s=>s.maxs);
    const minTotal=mins.reduce((a,s)=>a+s.reduce((x,y)=>x+y,0),0);
    if(total<minTotal||total>subjects.length*200)return null;
    const output=[];
    let remaining=total;
    for(let i=0;i<subjects.length;i++){
        const subjectsLeft=subjects.length-i-1;
        const minRest=mins.slice(i+1).reduce((a,s)=>a+s.reduce((x,y)=>x+y,0),0);
        const maxRest=(subjects.length-i-1)*200;
        let subjectTotal=Math.round(remaining/(subjectsLeft+1));
        subjectTotal=Math.max(0,Math.min(200,subjectTotal));
        subjectTotal=Math.max(subjectTotal,remaining-maxRest);
        subjectTotal=Math.min(subjectTotal,remaining-minRest);
        let half=Math.floor(subjectTotal/2),annual=subjectTotal-half;
        if(annual>100){annual=100;half=subjectTotal-annual;}
        if(half>100){half=100;annual=subjectTotal-half;}
        const halfMin=mins[i][0]+mins[i][1],halfMax=Math.min(100,maxs[i][0]+maxs[i][1]);
        const annualMin=mins[i][2]+mins[i][3],annualMax=Math.min(100,maxs[i][2]+maxs[i][3]);
        half=Math.max(halfMin,Math.min(halfMax,half));annual=subjectTotal-half;
        if(annual<annualMin){annual=annualMin;half=subjectTotal-annual;}
        if(annual>annualMax){annual=annualMax;half=subjectTotal-annual;}
        if(half<halfMin||half>halfMax||annual<annualMin||annual>annualMax)return null;
        let hw=Math.min(maxs[i][0],Math.max(mins[i][0],Math.floor(half*0.65))),hp=half-hw;
        if(hp<mins[i][1]){hp=mins[i][1];hw=half-hp;} if(hp>maxs[i][1]){hp=maxs[i][1];hw=half-hp;}
        let aw=Math.min(maxs[i][2],Math.max(mins[i][2],Math.floor(annual*0.65))),ap=annual-aw;
        if(ap<mins[i][3]){ap=mins[i][3];aw=annual-ap;} if(ap>maxs[i][3]){ap=maxs[i][3];aw=annual-ap;}
        if(hw<mins[i][0]||hw>maxs[i][0]||hp<mins[i][1]||hp>maxs[i][1]||aw<mins[i][2]||aw>maxs[i][2]||ap<mins[i][3]||ap>maxs[i][3])return null;
        output.push([hw,hp,aw,ap]); remaining-=subjectTotal;
    }
    return remaining===0?output:null;
}

function generateStudentResult(student,subjects){
    if(!isClass11()){
        const result=legacy_generateStudentResult(student,subjects);
        if(result){
            result.className=selectedResultClass;
            result.fatherName="";
            result.srNo="";
            result.rollNo="";
            result.uid="";
        }
        return result;
    }
    const included=subjects.filter(s=>s.include),target=Math.max(0,Math.min(100,numberValue(student.target))),total=included.length*200,desired=Math.round(total*target/100),marks=generateClass11Marks(desired,included);
    if(!marks)return null;
    const resultSubjects=included.map((s,i)=>({name:s.name,marks:marks[i],mins:[...s.mins],maxs:[...s.maxs],include:true,remark:""}));
    const obtained=resultSubjects.reduce((sum,s)=>sum+s.marks.reduce((a,b)=>a+b,0),0),percentage=total?obtained/total*100:0;
    return {name:student.name,target,rollNo:"",srNo:"",fatherName:"",className:"11th",section:"",attendance:"",rank:"",session:"2025-2026",boardRegistrationNo:"",studentRegistrationNo:"",teacherRemark:"",subjects:resultSubjects,obtained,total,percentage,grade:gradeFromPercentage(percentage),result:percentage>=33?"PASS":"FAIL"};
}

function generateResults(){
    if(!isClass11())return legacy_generateResults();
    const errorBox=document.getElementById("generatorError");
    const error=validateSubjects();
    if(error){errorBox.style.display="block";errorBox.textContent="⚠️ "+error;return;}
    const prepared=validateDatabaseStudents();
    if(!prepared)return;
    const subjects=getSubjects();
    generatedResults=[];
    for(const student of prepared.students){
        const result=generateStudentResult(student,subjects);
        if(!result){errorBox.style.display="block";errorBox.textContent=`Could not generate a valid result for ${student.name}.`;return;}
        applyStudentDatabaseMeta(result,student);
        generatedResults.push(result);
    }
    errorBox.style.display="none";
    renderGeneratedResults();
    document.getElementById("previewCard").classList.remove("hidden");
    document.getElementById("previewCard").scrollIntoView({behavior:"smooth"});
}

function calculateResult(result){
    if(!isClass11()&&result?.className!=="11th")return legacy_calculateResult(result);
    const obtained=(result.subjects||[]).reduce((sum,s)=>sum+(s.marks||[]).reduce((a,b)=>a+numberValue(b),0),0),total=(result.subjects||[]).length*200,percentage=total?obtained/total*100:0;
    return {obtained,total,percentage,grade:gradeFromPercentage(percentage),result:percentage>=33?"PASS":"FAIL"};
}

