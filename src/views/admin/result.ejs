<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>IKVM — Auto Result Generator + School Result Card</title>

<style>
/* =========================================================
   GLOBAL / ADMIN GENERATOR
========================================================= */
:root{
    --bg:#080d17;
    --panel:#101827;
    --panel2:#151f30;
    --border:#29364b;
    --border2:#344158;
    --text:#edf3ff;
    --muted:#9aa8bd;
    --blue:#3b82f6;
    --green:#22c55e;
    --yellow:#fbbf24;
    --red:#ef4444;
}
*{box-sizing:border-box;margin:0;padding:0}

body{
    font-family:Inter,Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    padding:24px;
}

.container{
    max-width:1400px;
    margin:auto;
}

.header,.admin-card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    box-shadow:0 8px 30px rgba(0,0,0,.25);
}

.header{
    padding:25px;
    margin-bottom:18px;
}

.header h1{
    font-size:25px;
    margin-bottom:7px;
}

.header p{
    color:var(--muted);
    font-size:13px;
    line-height:1.5;
}

.admin-card{
    padding:21px;
    margin-bottom:18px;
}

.admin-card h2{
    font-size:18px;
    margin-bottom:15px;
}

.row{
    display:flex;
    gap:12px;
    align-items:end;
}

.group{
    flex:1;
}

label{
    display:block;
    font-size:12px;
    font-weight:700;
    color:#b9c5d8;
    margin-bottom:6px;
}

input,select{
    width:100%;
    padding:10px;
    border:1px solid #34435a;
    border-radius:8px;
    background:#0b1422;
    color:#fff;
    outline:none;
}

input:focus,select:focus{
    border-color:var(--blue);
    box-shadow:0 0 0 3px #3b82f622;
}

button{
    border:0;
    border-radius:8px;
    padding:10px 15px;
    font-weight:700;
    cursor:pointer;
}

.primary{background:var(--blue);color:white}
.secondary{background:#202b3d;color:#e5edf9}
.success{background:#16a34a;color:#fff}
.danger{background:#3a1c24;color:#ff9da8}
.dark{background:#111827;color:#fff}

button:active{
    transform:translateY(1px);
}

.hidden{
    display:none!important;
}

.muted{
    color:var(--muted);
    font-size:12px;
    line-height:1.5;
}

/* =========================================================
   STUDENTS
========================================================= */

.student-head,
.student-row{
    display:grid;
    grid-template-columns:45px minmax(0,1fr) 180px;
    gap:10px;
    align-items:center;
}

.student-head{
    padding:10px;
    background:var(--panel2);
    font-size:12px;
    font-weight:800;
}

.student-row{
    padding:9px;
    border-bottom:1px solid #202b3b;
}

/* =========================================================
   SUBJECT SETTINGS
========================================================= */

.subject-card{
    border:1px solid var(--border);
    border-radius:10px;
    margin-top:12px;
    padding:14px;
    background:#0d1523;
}

.subject-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:12px;
}

.subject-title strong{
    font-size:15px;
}

.subject-title span{
    font-size:12px;
    color:var(--muted);
}

.subject-name{
    margin-bottom:11px;
}

.component-grid{
    display:grid;
    grid-template-columns:repeat(6,minmax(125px,1fr));
    gap:9px;
}

.component{
    background:#111b2b;
    border:1px solid #26344a;
    border-radius:9px;
    padding:10px;
}

.component b{
    font-size:11px;
}

.component .cap{
    font-size:10px;
    color:#91a0b6;
    margin-top:4px;
}

.component input{
    margin-top:6px;
}

.include-box{
    display:flex;
    align-items:center;
    gap:6px;
    margin:0;
    color:#b9c5d8;
    font-size:11px;
}

.include-box input{
    width:auto;
    margin:0;
}

.range-box,
.notice,
.error-box{
    margin-top:14px;
    padding:12px 14px;
    border-radius:9px;
    font-size:12px;
}

.range-box{
    background:#0d2440;
    border:1px solid #1e4d82;
    color:#a9d1ff;
}

.notice{
    background:#111c2c;
    border:1px solid var(--border);
    color:#aebbd0;
}

.error-box{
    display:none;
    background:#3a1717;
    border:1px solid #6d2929;
    color:#ffb4b4;
}

/* =========================================================
   GENERATED RESULTS
========================================================= */

.generated-card{
    border:1px solid var(--border2);
    border-radius:11px;
    overflow:hidden;
    margin-top:14px;
}

.generated-title{
    background:#0b1220;
    padding:14px 17px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
}

.generated-title strong{
    font-size:15px;
}

.target{
    color:#a9c9f7;
    font-size:12px;
}

.generated-scroll{
    overflow-x:auto;
}

.generated-table{
    width:100%;
    min-width:1050px;
    border-collapse:collapse;
}

.generated-table th,
.generated-table td{
    padding:8px;
    text-align:center;
    border-bottom:1px solid #253044;
    font-size:11px;
}

.generated-table th{
    background:#151f30;
    color:#cad7e8;
    font-size:10px;
}

.generated-table td{
    color:#e2e9f4;
}

.generated-table .mark{
    width:55px;
    text-align:center;
    padding:6px;
}

.generated-table .subject-cell{
    text-align:left;
    min-width:130px;
}

.generated-table .total-row td,
.generated-table .total-row th{
    font-weight:800;
    background:#111b2b;
}

.adjustment{
    padding:13px 16px;
    background:#241d0b;
    border-top:1px solid #55451d;
    color:#e7d39b;
}

.adjustment strong{
    color:#f6c85f;
}

.actions{
    display:flex;
    gap:9px;
    justify-content:flex-end;
    flex-wrap:wrap;
    margin-top:12px;
}

.result-action-row{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    padding:12px;
    border-top:1px solid var(--border);
}

/* =========================================================
   RESULT CARD VIEW
========================================================= */

#resultView{
    display:none;
    margin-top:18px;
}

.result-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:10px;
    background:#111b2d;
    border:1px solid #293851;
    border-radius:12px;
    padding:12px;
}

.result-toolbar h2{
    font-size:16px;
}

.result-toolbar p{
    color:#9eacc1;
    font-size:11px;
    margin-top:3px;
}

.result-toolbar-actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

/* =========================================================
   SCHOOL RESULT CARD

   IMPORTANT:
   The left marks table and right final panel are independent
   grid columns. The right panel is NOT placed inside a row
   of the marks table. This prevents the large white gap.
========================================================= */

.print-page{
    background:#fff;
    color:#111;
    padding:10px;
    overflow:auto;
}

.school-card{
    width:100%;
    max-width:1400px;
    margin:0 auto;
    background:#fff;
    color:#111;
    padding:10px 12px 12px;
    font-family:"Times New Roman",serif;
}

.school-header{
    position:relative;
    text-align:center;
    margin-bottom:3px;
}

.school-logo{
    position:absolute;
    left:0;
    top:-2px;
    width:48px;
    height:48px;
    border:2px solid #222;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font:700 7px Arial;
}

.school-name{
    font-size:29px;
    line-height:1;
    font-weight:900;
}

.report-title{
    margin-top:4px;
    font-size:17px;
    font-weight:800;
}

.student-info{
    width:100%;
    border-collapse:collapse;
    font-size:11px;
}

.student-info td{
    height:18px;
    padding:1px 5px;
    border-bottom:1px dotted #333;
}

.student-info .label{
    font-weight:800;
    white-space:nowrap;
}

.card-layout{
    width:100%;
    display:grid;
    grid-template-columns:minmax(0,1fr) 230px;
    align-items:start;
    margin-top:5px;
}

.card-left{
    min-width:0;
}

.marks-table{
    width:100%;
    border-collapse:collapse;
    table-layout:fixed;
}

.marks-table th,
.marks-table td{
    border:1px solid #222;
    text-align:center;
    vertical-align:middle;
    padding:1px;
    font-size:8.5px;
    height:25px;
}

.marks-table th{
    font-weight:800;
}

.marks-table .sno{
    width:30px;
}

.marks-table .subject{
    width:125px;
}

.marks-table .mm{
    width:29px;
}

.marks-table .obt{
    width:33px;
}

.marks-table .total{
    width:38px;
}

.marks-table .final-mm{
    width:38px;
}

.marks-table .final-obt{
    width:43px;
}

.marks-table .subject-text{
    text-align:left;
    padding-left:5px;
    font-weight:700;
}

.card-mark-input{
    width:100%;
    height:20px;
    margin:0;
    padding:0;
    border:0;
    border-radius:0;
    background:transparent;
    color:#111;
    text-align:center;
    font:inherit;
    font-weight:700;
}

.card-mark-input:focus{
    background:#edf5ff;
    outline:1px solid #2563eb;
}

.card-remark{
    width:100%;
    height:20px;
    border:0;
    border-radius:0;
    background:transparent;
    color:#111;
    text-align:center;
    font:8px "Times New Roman",serif;
}

.card-remark:focus{
    outline:1px solid #2563eb;
    background:#edf5ff;
}

.blank-row td{
    height:27px;
}

.total-row td{
    height:29px;
    font-weight:800;
}

.final-side{
    width:230px;
    align-self:stretch;
}

.final-table{
    width:100%;
    height:100%;
    border-collapse:collapse;
    table-layout:fixed;
}

.final-table td{
    border:1px solid #222;
}

.final-head{
    height:52px;
    text-align:center;
    font-size:11px;
    font-weight:800;
}

.final-title{
    height:47px;
    text-align:center;
    font-size:12px;
    font-weight:900;
}

.final-field{
    height:68px;
    padding:12px 8px;
    font-size:10px;
    vertical-align:middle;
}

.final-line{
    display:inline-block;
    min-width:95px;
    border-bottom:1px dotted #222;
    min-height:13px;
}

.final-result-box{
    height:62px;
    text-align:center;
    vertical-align:middle;
    font-size:12px;
    font-weight:900;
}

.principal-box{
    height:190px;
    text-align:center;
    vertical-align:middle;
    font-size:11px;
    line-height:1.7;
}

.bottom-table{
    width:100%;
    border-collapse:collapse;
    table-layout:fixed;
}

.bottom-table td{
    border:1px solid #222;
    height:29px;
    font-size:9px;
}

.bottom-label{
    width:166px;
    padding-left:6px;
    font-weight:700;
    text-align:left;
}

.bottom-edit{
    width:100%;
    height:22px;
    border:0;
    background:transparent;
    color:#111;
    font:9px "Times New Roman",serif;
}

.bottom-edit:focus{
    outline:1px solid #2563eb;
    background:#edf5ff;
}


/* =========================================================
   CLASS 11 RESULT CARD — same school-card design, new marks layout
========================================================= */
.class11-school-card{font-family:"Times New Roman",serif;}
.class11-school-card .school-name{font-size:27px;}
.class11-school-card .report-title{font-size:17px;}
.class11-card-layout{width:100%;display:grid;grid-template-columns:minmax(0,1fr) 185px;gap:0;align-items:stretch;margin-top:5px;}
.class11-card-left{min-width:0;}
.class11-marks-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.class11-marks-table th,.class11-marks-table td{border:1px solid #222;text-align:center;vertical-align:middle;padding:1px;font-size:7.2px;height:24px;}
.class11-marks-table th{font-weight:800;}
.class11-marks-table .c11-sno{width:25px;}
.class11-marks-table .c11-subject{width:105px;}
.class11-marks-table .c11-mm{width:27px;}
.class11-marks-table .c11-obt{width:34px;}
.class11-marks-table .c11-total{width:34px;}
.class11-marks-table .c11-final{width:38px;}
.class11-marks-table .c11-remark{width:65px;}
.class11-marks-table .subject-text{text-align:left;padding-left:4px;font-weight:700;}
.class11-card-input{width:100%;height:19px;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:#111;text-align:center;font:inherit;font-weight:700;}
.class11-card-input:focus{outline:1px solid #2563eb;background:#edf5ff;}
.class11-card-remark{width:100%;height:19px;border:0;background:transparent;color:#111;text-align:center;font:7px "Times New Roman",serif;}
.class11-card-remark:focus{outline:1px solid #2563eb;background:#edf5ff;}
.class11-bottom-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.class11-bottom-table td{border:1px solid #222;height:23px;font-size:7.5px;}
.class11-bottom-label{width:105px;padding-left:4px;font-weight:700;text-align:left;}
.class11-final-side{width:185px;}
.class11-final-side .final-table{width:100%;height:100%;border-collapse:collapse;table-layout:fixed;}
.class11-final-side .final-table td{border:1px solid #222;}
.class11-final-side .final-head{height:34px;font-size:8px;}
.class11-final-side .final-title{height:34px;font-size:9px;}
.class11-final-side .final-field{height:45px;padding:7px 5px;font-size:8px;}
.class11-final-side .final-line{min-width:68px;}
.class11-final-side .final-result-box{height:40px;font-size:9px;}
.class11-final-side .principal-box{height:105px;font-size:8px;line-height:1.45;}
.class11-extra-info{display:grid;grid-template-columns:1fr 1fr 1fr;border-left:1px solid #222;border-right:1px solid #222;border-bottom:1px solid #222;}
.class11-extra-info div{min-height:22px;border-right:1px solid #222;padding:2px 4px;font-size:7.5px;}
.class11-extra-info div:last-child{border-right:0;}
.class11-extra-info input{height:18px;border:0;background:transparent;color:#111;font:7.5px "Times New Roman",serif;padding:0;}
.class11-extra-info input:focus{outline:1px solid #2563eb;background:#edf5ff;}
@media print{
 .class11-school-card .school-name{font-size:21px;} .class11-school-card .report-title{font-size:12px;}
 .class11-marks-table th,.class11-marks-table td{font-size:6.5px;height:21px;} .class11-marks-table .subject-text{font-size:6.8px;}
 .class11-card-layout{grid-template-columns:minmax(0,1fr) 160px;} .class11-final-side{width:160px;}
 .class11-final-side .final-field{height:39px;font-size:7px;padding:5px 4px;} .class11-final-side .final-head{height:30px;font-size:7px;} .class11-final-side .final-title{height:30px;font-size:8px;} .class11-final-side .principal-box{height:90px;font-size:7px;}
 .class11-bottom-table td,.class11-extra-info div{font-size:6.5px;}
}

/* =========================================================
   PRINT
========================================================= */

@media print{
    @page{
        size:A4 landscape;
        margin:5mm;
    }

    body{
        background:#fff;
        padding:0;
    }

    .header,
    .admin-card,
    .result-toolbar{
        display:none!important;
    }

    #resultView{
        display:block!important;
        margin:0;
    }

    .print-page{
        padding:0;
        overflow:visible;
    }

    .school-card{
        max-width:none;
        width:100%;
        padding:0;
    }

    .school-name{
        font-size:23px;
    }

    .report-title{
        font-size:14px;
    }

    .student-info{
        font-size:8px;
    }

    .student-info td{
        height:15px;
    }

    .card-layout{
        grid-template-columns:minmax(0,1fr) 190px;
    }

    .final-side{
        width:190px;
    }

    .marks-table th,
    .marks-table td{
        font-size:6.5px;
        height:21px;
        padding:1px;
    }

    .marks-table .subject{
        font-size:7px;
    }

    .marks-table .sno{
        width:25px;
    }

    .marks-table .subject{
        width:105px;
    }

    .marks-table .mm{
        width:23px;
    }

    .marks-table .obt{
        width:26px;
    }

    .marks-table .total{
        width:31px;
    }

    .marks-table .final-mm{
        width:34px;
    }

    .marks-table .final-obt{
        width:37px;
    }

    .card-mark-input{
        height:17px;
        font-size:6.5px;
    }

    .card-remark{
        height:17px;
        font-size:6px;
    }

    .blank-row td{
        height:21px;
    }

    .total-row td{
        height:22px;
    }

    .final-head{
        height:40px;
        font-size:7.5px;
    }

    .final-title{
        height:36px;
        font-size:8.5px;
    }

    .final-field{
        height:52px;
        padding:7px 5px;
        font-size:7.5px;
    }

    .final-line{
        min-width:72px;
    }

    .final-result-box{
        height:42px;
        font-size:8.5px;
    }

    .principal-box{
        height:120px;
        font-size:7.5px;
    }

    .bottom-table td{
        height:22px;
        font-size:7px;
    }

    .bottom-label{
        width:120px;
    }

    .bottom-edit{
        height:17px;
        font-size:7px;
    }
}

@media(max-width:900px){
    body{padding:12px}

    .component-grid{
        grid-template-columns:repeat(3,minmax(125px,1fr));
    }

    .card-layout{
        grid-template-columns:1fr;
    }

    .final-side{
        width:100%;
    }

    .generated-table{
        min-width:1050px;
    }
}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>

<body>

<div class="container">

<!-- =========================================================
     MAIN GENERATOR
========================================================= -->

<div class="header">
    <h1>IKVM — Term Based Auto Result Generator</h1>
    <p>
        FA-1 + FA-2 + S.A.-1 = Term 1 /100
        &nbsp; | &nbsp;
        FA-3 + FA-4 + S.A.-2 = Term 2 /100
        &nbsp; | &nbsp;
        Final = /200
    </p>
</div>


<!-- STUDENTS -->

<div class="admin-card">
    <h2>1. Result Class & Students</h2>
    <div class="notice">
        Select the class once. Students are loaded automatically from the existing IKVM student database.
        No student name needs to be entered manually.
    </div>
    <div class="row result-class-row">
        <div class="group">
            <label>Result Class (choose once)</label>
            <select id="resultClass" onchange="applyResultClass()">
                <option value="1st" selected>Class 1</option>
                <option value="2nd">Class 2</option>
                <option value="3rd">Class 3</option>
                <option value="4th">Class 4</option>
                <option value="5th">Class 5</option>
                <option value="6th">Class 6</option>
                <option value="7th">Class 7</option>
                <option value="8th">Class 8</option>
                <option value="9th">Class 9</option>
                <option value="11th">Class 11</option>
            </select>
        </div>
    </div>
</div>

<div class="admin-card hidden" id="studentsCard">
    <h2>Students Loaded From Database</h2>
    <div class="student-head">
        <div>#</div>
        <div>Student Details</div>
        <div>Target Overall %</div>
    </div>
    <div id="studentsContainer"></div>
</div>


<!-- SUBJECTS -->

<div class="admin-card">

    <h2>2. Subject & Assessment Settings</h2>

    <div class="notice">
        Each included subject is <b>200 marks</b>:
        Term 1 = FA-1 (20) + FA-2 (20) + S.A.-1 (60);
        Term 2 = FA-3 (20) + FA-4 (20) + S.A.-2 (60).
        Set realistic minimum and maximum marks for every component.
    </div>

    <div id="subjectsContainer"></div>

    <button
        id="addSubjectButton"
        class="secondary"
        style="margin-top:13px"
        onclick="addSubject()"
    >
        + Add Subject
    </button>

    <div class="range-box" id="rangeBox">
        Possible overall percentage range will appear here.
    </div>

    <div class="error-box" id="generatorError"></div>

</div>


<!-- GENERATE -->

<div class="admin-card">

    <h2>3. Generate Result</h2>

    <div class="notice">
        The generator distributes the required total marks across all six
        assessment components while respecting every component's minimum
        and maximum. Whole-number marks are used.
    </div>

    <div class="actions">

        <button
            class="primary"
            onclick="generateResults()"
        >
            Generate Result
        </button>

    </div>

</div>


<!-- GENERATED RESULTS -->

<div class="admin-card hidden" id="previewCard">

    <h2>4. Generated Results</h2>

    <p class="muted">
        First generate the results here. Click <b>See Result</b> to open
        the school's actual result-card design.
    </p>

    <div id="resultsContainer"></div>

