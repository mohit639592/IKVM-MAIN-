/* =========================================================
   PDF DOWNLOAD
   - One student/result per A4 landscape page
   - Individual PDF
   - Combined PDF
   - Uses the exact existing result-card DOM/design
========================================================= */

function waitForPdfRender(){
    return new Promise(resolve=>{
        requestAnimationFrame(()=>{
            requestAnimationFrame(()=>{
                setTimeout(resolve,120);
            });
        });
    });
}

function getPdfFileName(result,index){
    const safeName=String(result?.name||`Student-${index+1}`)
        .replace(/[<>:"/\\|?*]+/g,"")
        .replace(/\s+/g,"_")
        .trim();

    const className=String(
        result?.className||selectedResultClass||"Result"
    ).replace(/[^a-zA-Z0-9_-]+/g,"");

    return `${safeName||`Student-${index+1}`}_${className}_Result.pdf`;
}

async function captureResultCanvas(resultIndex){
    if(!generatedResults[resultIndex]) return null;

    currentResultIndex=resultIndex;

    const resultView=document.getElementById("resultView");
    if(!resultView) throw new Error("Result view was not found.");

    const oldDisplay=resultView.style.display;

    try{
        resultView.style.display="block";
        renderSchoolResultCard(resultIndex);
        await waitForPdfRender();

        const card=document.getElementById("schoolResultCard");
        if(!card) throw new Error("Result card was not found.");

        return await html2canvas(card,{
            scale:2,
            useCORS:true,
            backgroundColor:"#ffffff",
            logging:false,
            windowWidth:Math.max(card.scrollWidth,1400)
        });
    }finally{
        resultView.style.display=oldDisplay;
    }
}

function addCanvasToPdf(pdf,canvas){
    const pageWidth=297;
    const pageHeight=210;
    const margin=5;

    const maxWidth=pageWidth-margin*2;
    const maxHeight=pageHeight-margin*2;

    const ratio=Math.min(
        maxWidth/canvas.width,
        maxHeight/canvas.height
    );

    const imgWidth=canvas.width*ratio;
    const imgHeight=canvas.height*ratio;

    const x=(pageWidth-imgWidth)/2;
    const y=(pageHeight-imgHeight)/2;

    pdf.addImage(
        canvas.toDataURL("image/jpeg",0.96),
        "JPEG",
        x,
        y,
        imgWidth,
        imgHeight,
        undefined,
        "FAST"
    );
}

async function downloadResultPDF(resultIndex){
    if(!generatedResults[resultIndex]){
        alert("Please generate the result first.");
        return;
    }

    if(
        typeof html2canvas==="undefined" ||
        !window.jspdf?.jsPDF
    ){
        alert("PDF libraries are not loaded. Please check your internet connection and reload the page.");
        return;
    }

    const result=generatedResults[resultIndex];

    try{
        const canvas=await captureResultCanvas(resultIndex);
        const {jsPDF}=window.jspdf;

        const pdf=new jsPDF({
            orientation:"landscape",
            unit:"mm",
            format:"a4",
            compress:true
        });

        addCanvasToPdf(pdf,canvas);
        pdf.save(getPdfFileName(result,resultIndex));
    }catch(error){
        console.error("Individual PDF generation failed:",error);
        alert("Could not create the PDF. Please try again.");
    }
}

async function downloadAllResultsPDF(){
    if(!generatedResults.length){
        alert("Please generate the results first.");
        return;
    }

    if(
        typeof html2canvas==="undefined" ||
        !window.jspdf?.jsPDF
    ){
        alert("PDF libraries are not loaded. Please check your internet connection and reload the page.");
        return;
    }

    const button=[...document.querySelectorAll("button")]
        .find(b=>b.textContent.includes("Download All Results PDF"));

    const oldText=button?button.textContent:"";

    try{
        if(button){
            button.disabled=true;
            button.textContent="⏳ Creating PDF...";
        }

        const {jsPDF}=window.jspdf;

        const pdf=new jsPDF({
            orientation:"landscape",
            unit:"mm",
            format:"a4",
            compress:true
        });

        for(let i=0;i<generatedResults.length;i++){
            const canvas=await captureResultCanvas(i);

            if(i>0){
                pdf.addPage("a4","landscape");
            }

            addCanvasToPdf(pdf,canvas);
        }

        const className=String(
            selectedResultClass||
            generatedResults[0]?.className||
            "Result"
        ).replace(/[^a-zA-Z0-9_-]+/g,"");

        pdf.save(`IKVM_All_${className}_Results.pdf`);

        if(generatedResults.length){
            currentResultIndex=0;
            renderSchoolResultCard(0);
        }
    }catch(error){
        console.error("All-results PDF generation failed:",error);
        alert("Could not create the combined PDF. Please try again.");
    }finally{
        if(button){
            button.disabled=false;
            button.textContent=oldText||"⬇ Download All Results PDF";
        }
    }
}

function resetAll(){
    generatedResults=[];
    currentResultIndex=-1;
    selectedResultClass="1st";
    const selector=document.getElementById("resultClass");
    if(selector)selector.value="1st";
    const studentsContainer=document.getElementById("studentsContainer");
    if(studentsContainer)studentsContainer.innerHTML="";
    const studentsCard=document.getElementById("studentsCard");
    if(studentsCard)studentsCard.classList.add("hidden");
    document.getElementById("previewCard").classList.add("hidden");
    document.getElementById("resultsContainer").innerHTML="";
    document.getElementById("resultView").style.display="none";
    document.getElementById("subjectsContainer").innerHTML="";
    DEFAULT_SUBJECTS.forEach(subject=>addSubject(subject));
    const addButton=document.getElementById("addSubjectButton");
    if(addButton)addButton.style.display="inline-block";
    loadStudentsFromIKVM();
}

