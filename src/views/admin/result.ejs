}


/* =========================================================
   EDIT GENERATED MARK
========================================================= */

function legacy_editGeneratedMark(
    resultIndex,
    subjectIndex,
    componentIndex,
    value
){

    const result =
        generatedResults[resultIndex];


    const subject =
        result.subjects[subjectIndex];


    const maximum =
        COMPONENTS[componentIndex].max;


    let mark =
        numberValue(value);


    mark =
        Math.max(
            0,
            Math.min(
                maximum,
                mark
            )
        );


    subject.marks[componentIndex] =
        mark;


    updateGeneratedResultUI(
        resultIndex
    );


    /*
      If the result card is currently open for this student,
      update that card too.
    */

    if(
        currentResultIndex === resultIndex
    ){

        renderSchoolResultCard(
            resultIndex
        );

    }

}


/* =========================================================
   GENERATED RESULT UI
========================================================= */

function legacy_updateGeneratedResultUI(
    resultIndex
){

    const result =
        generatedResults[resultIndex];


    const calculation =
        calculateResult(
            result
        );


    result.obtained =
        calculation.obtained;

    result.total =
        calculation.total;

    result.percentage =
        calculation.percentage;

    result.grade =
        calculation.grade;

    result.result =
        calculation.result;


    result.subjects.forEach(
        (subject,subjectIndex)=>{

            const term1 =
                subject.marks[0] +
                subject.marks[1] +
                subject.marks[2];


            const term2 =
                subject.marks[3] +
                subject.marks[4] +
                subject.marks[5];


            const final =
                term1 + term2;


            const t1 =
                document.getElementById(
                    `generated-t1-${resultIndex}-${subjectIndex}`
                );


            const t2 =
                document.getElementById(
                    `generated-t2-${resultIndex}-${subjectIndex}`
                );


            const finalElement =
                document.getElementById(
                    `generated-final-${resultIndex}-${subjectIndex}`
                );


            if(t1)
                t1.textContent =
                    `${term1}/100`;


            if(t2)
                t2.textContent =
                    `${term2}/100`;


            if(finalElement)
                finalElement.textContent =
                    `${final}/200`;

        }
    );


    const grandTerm1 =
        result.subjects.reduce(
            (sum,subject)=>
                sum +
                subject.marks[0] +
                subject.marks[1] +
                subject.marks[2],
            0
        );


    const grandTerm2 =
        result.subjects.reduce(
            (sum,subject)=>
                sum +
                subject.marks[3] +
                subject.marks[4] +
                subject.marks[5],
            0
        );


    const gt1 =
        document.getElementById(
            `generated-grand-t1-${resultIndex}`
        );


    const gt2 =
        document.getElementById(
            `generated-grand-t2-${resultIndex}`
        );


    const gf =
        document.getElementById(
            `generated-grand-final-${resultIndex}`
        );


    const gp =
        document.getElementById(
            `generated-percent-${resultIndex}`
        );


    const go =
        document.getElementById(
            `generated-overall-${resultIndex}`
        );


    if(gt1)
        gt1.textContent =
            `${grandTerm1}/${result.subjects.length*100}`;


    if(gt2)
        gt2.textContent =
            `${grandTerm2}/${result.subjects.length*100}`;


    if(gf)
        gf.textContent =
            `${result.obtained}/${result.total}`;


    if(gp)
        gp.textContent =
            `${result.percentage.toFixed(2)}%`;


    if(go)
        go.textContent =
            `${result.percentage.toFixed(2)}%`;


    updateAdjustment(
        resultIndex
    );

}


/* =========================================================
   TARGET ADJUSTMENT SUGGESTION
========================================================= */

function updateAdjustment(
    resultIndex
){

    const result =
        generatedResults[resultIndex];


    const calculation =
        calculateResult(
            result
        );


    const targetMarks =
        calculation.total *
        result.target /
        100;


    const difference =
        targetMarks -
        calculation.obtained;


    const box =
        document.getElementById(
            `generated-adjustment-${resultIndex}`
        );


    if(!box)
        return;


    if(Math.abs(difference) < 0.0001){

        box.innerHTML = `

            <strong>
                ✓ Target matched
            </strong>

            <div style="margin-top:5px">

                Current percentage is exactly
                ${result.target.toFixed(2)}%.

            </div>

        `;

        return;

    }


    const direction =
        difference > 0
            ? "increase"
            : "decrease";


    box.innerHTML = `

        <strong>
            💡 Target adjustment
        </strong>

        <div style="margin-top:5px">

            Current:
            <b>${calculation.percentage.toFixed(2)}%</b>

            &nbsp; | &nbsp;

            Target:
            <b>${result.target.toFixed(2)}%</b>

            <br>

            To return to the target,
            <b>
                ${direction}
                ${Math.abs(difference).toFixed(2)}
                total marks
            </b>
            across the subjects.

        </div>

    `;

}


