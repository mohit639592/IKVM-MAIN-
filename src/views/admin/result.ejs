function editGeneratedMark(resultIndex,subjectIndex,componentIndex,value){
    if(!isClass11()&&generatedResults[resultIndex]?.className!=="11th")return legacy_editGeneratedMark(resultIndex,subjectIndex,componentIndex,value);
    const result=generatedResults[resultIndex],subject=result?.subjects?.[subjectIndex];if(!subject)return;
    const m=subject.marks,raw=numberValue(value);
    let max=CLASS11_COMPONENTS[componentIndex].max;
    if(componentIndex===0)max=Math.min(100,100-numberValue(m[1]));
    if(componentIndex===1)max=Math.min(30,100-numberValue(m[0]));
    if(componentIndex===2)max=Math.min(100,100-numberValue(m[3]));
    if(componentIndex===3)max=Math.min(30,100-numberValue(m[2]));
    m[componentIndex]=Math.max(0,Math.min(max,raw));
    updateGeneratedResultUI(resultIndex);
}

