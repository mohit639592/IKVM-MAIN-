    document.querySelectorAll(".class11-card-input").forEach(input=>input.addEventListener("input",e=>{const r=generatedResults[Number(e.target.dataset.ri)],sub=r?.subjects?.[Number(e.target.dataset.si)];if(!sub)return;const ci=Number(e.target.dataset.ci);let max=CLASS11_COMPONENTS[ci].max;
        if(ci===0)max=Math.min(100,100-numberValue(sub.marks[1]));
