/* =========================================================
   READ SUBJECT SETTINGS
========================================================= */

function legacy_getSubjects(){

    return [

        ...document.querySelectorAll(".subject-card")

    ].map(card=>{

        const name =
            card.querySelector(".subjectName")
                ?.value
                .trim() ||
            "Subject";


        const minInputs =
            [
                ...card.querySelectorAll(".componentMin")
            ];


        const maxInputs =
            [
                ...card.querySelectorAll(".componentMax")
            ];


        const mins =
            minInputs.map(
                input =>
                    wholeNumber(input.value)
            );


        const maxs =
            maxInputs.map(
                input =>
                    wholeNumber(input.value)
            );


        const include =
            card.querySelector(".includeFinal")
                ?.checked !== false;


        return {
            name,
            mins,
            maxs,
            include
        };

    }).filter(
        subject =>
            subject.mins.length === COMPONENTS.length &&
            subject.maxs.length === COMPONENTS.length
    );

}


/* =========================================================
   VALIDATE SETTINGS
========================================================= */

function legacy_validateSubjects(){

    const subjects = getSubjects();


    if(!subjects.length){

        return "Add at least one subject.";

    }


    for(
        let subjectIndex=0;
        subjectIndex<subjects.length;
        subjectIndex++
    ){

        const subject =
            subjects[subjectIndex];


        for(
            let componentIndex=0;
            componentIndex<COMPONENTS.length;
            componentIndex++
        ){

            const maximum =
                COMPONENTS[componentIndex].max;


            let min =
                Math.max(
                    0,
                    Math.min(
                        maximum,
                        wholeNumber(
                            subject.mins[componentIndex]
                        )
                    )
                );


            let max =
                Math.max(
                    0,
                    Math.min(
                        maximum,
                        wholeNumber(
                            subject.maxs[componentIndex]
                        )
                    )
                );


            subject.mins[componentIndex] = min;

            subject.maxs[componentIndex] = max;


            if(min > max){

                return `
                    ${subject.name} —
                    ${COMPONENTS[componentIndex].label}:
                    minimum cannot be greater than maximum.
                `;

            }

        }

    }


    if(!subjects.some(s=>s.include)){

        return "Select at least one subject to include in Final %.";

    }


    return "";

}


/* =========================================================
   TOTAL BOUNDS
========================================================= */

function legacy_getBounds(){

    const subjects =
        getSubjects()
            .filter(s=>s.include);


    let minimum = 0;
    let maximum = 0;


    subjects.forEach(subject=>{

        subject.mins.forEach(
            value =>
                minimum += numberValue(value)
        );


        subject.maxs.forEach(
            value =>
                maximum += numberValue(value)
        );

    });


    const total =
        subjects.length * 200;


    return {
        minimum,
        maximum,
        total
    };

}


/* =========================================================
   POSSIBLE RANGE
========================================================= */

function legacy_updateRange(){

    const error =
        validateSubjects();


    const rangeBox =
        document.getElementById("rangeBox");


    const errorBox =
        document.getElementById("generatorError");


    if(error){

        if(
            error.includes("minimum") ||
            error.includes("at least") ||
            error.includes("Final")
        ){

            errorBox.style.display = "block";

            errorBox.textContent = "⚠️ " + error;

        }

    }else{

        errorBox.style.display = "none";

    }


    const bounds =
        getBounds();


    if(bounds.total <= 0){

        rangeBox.textContent =
            "Select at least one subject to see the possible percentage.";

        return;

    }


    const minPercentage =
        bounds.minimum /
        bounds.total *
        100;


    const maxPercentage =
        bounds.maximum /
        bounds.total *
        100;


    rangeBox.innerHTML = `

        <b>Possible generated overall percentage:</b>

        ${minPercentage.toFixed(2)}%

        -

        ${maxPercentage.toFixed(2)}%

        &nbsp;

        <span style="opacity:.7">
            (${getSubjects().filter(s=>s.include).length}
            subject(s) included)
        </span>

    `;

}


/* =========================================================
   EXACT CONSTRAINED ALLOCATION
========================================================= */

function shuffled(array){

    const result = [...array];


    for(
        let i=result.length-1;
        i>0;
        i--
    ){

        const j =
            Math.floor(
                Math.random() * (i+1)
            );


        [
            result[i],
            result[j]
        ] = [
            result[j],
            result[i]
        ];

    }


    return result;

}


function allocateExactTotal(
    total,
    mins,
    maxs
){

    const minSum =
        mins.reduce(
            (a,b)=>a+b,
            0
        );

    const maxSum =
        maxs.reduce(
            (a,b)=>a+b,
            0
        );

    /*
      IMPORTANT:
      The old version could return null even when a valid
      distribution existed because it visited every component
      only once and randomly allocated too little.

      This version keeps distributing until the exact required
      total is reached. Therefore, if total is between the
      mathematical minimum and maximum, generation succeeds.
    */

    if(
        total < minSum ||
        total > maxSum
    ){
        return null;
    }

    const values = [...mins];

    const capacities =
        maxs.map(
            (maximum,index)=>
                Math.max(
                    0,
                    maximum - mins[index]
                )
        );

    let remaining =
        total - minSum;

    while(remaining > 0){

        const available = [];

        for(
            let i=0;
            i<capacities.length;
            i++
        ){
            if(capacities[i] > 0){
                available.push(i);
            }
        }

        if(!available.length){
            return null;
        }

        /*
          Pick a random component that still has room.
        */
        const index =
            available[
                Math.floor(
                    Math.random() *
                    available.length
                )
            ];

        const add =
            Math.min(
                capacities[index],
                remaining
            );

        /*
          Add at least 1 mark.
          Randomize the amount while keeping enough room
          for the remaining total.
        */
        const amount =
            add <= 1
                ? add
                : 1 +
                  Math.floor(
                      Math.random() * add
                  );

        values[index] += amount;

        capacities[index] -= amount;

        remaining -= amount;
    }

    return values;
}


/* =========================================================
   GENERATE ONE STUDENT
========================================================= */

function legacy_generateStudentResult(
    student,
    subjects
){

    const included =
        subjects.filter(
            s=>s.include
        );


    const bounds =
        getBounds();


    const target =
        Math.max(
            0,
            Math.min(
                100,
                numberValue(
                    student.target
                )
            )
        );


    /*
      The result card has 10 subjects × 200 = 2000
      when all 10 are included.

      For a custom number of subjects:
      total = included subjects × 200.
    */

    const desiredTotal =
        Math.round(
            bounds.total *
            target /
            100
        );


    const mins = [];

    const maxs = [];


    included.forEach(
        subject=>{

            subject.mins.forEach(
                value =>
                    mins.push(
                        wholeNumber(value)
                    )
            );


            subject.maxs.forEach(
                value =>
                    maxs.push(
                        wholeNumber(value)
                    )
            );

        }
    );


    const generatedValues =
        allocateExactTotal(
            desiredTotal,
            mins,
            maxs
        );


    if(!generatedValues){

        return null;

    }


    const resultSubjects = [];

    let cursor = 0;


    included.forEach(
        subject=>{

            const marks =
                [];


            for(
                let i=0;
                i<COMPONENTS.length;
                i++
            ){

                marks.push(
                    generatedValues[cursor++]
                );

            }


            resultSubjects.push({

                name:subject.name,

                marks,

                mins:[
                    ...subject.mins
                ],

                maxs:[
                    ...subject.maxs
                ],

                include:true,

                remark:""

            });

        }
    );


    const obtained =
        resultSubjects.reduce(
            (sum,subject)=>
                sum +
                subject.marks.reduce(
                    (a,b)=>a+b,
                    0
                ),
            0
        );


    const total =
        resultSubjects.length *
        200;


    const percentage =
        total > 0
            ? obtained / total * 100
            : 0;


    return {

        name:student.name,

        target,

        rollNo:"",
        srNo:"",
        fatherName:"",
        className:"3rd",
        section:"",
        attendance:"",
        rank:"",

        subjects:resultSubjects,

        obtained,

        total,

        percentage,

        grade:
            gradeFromPercentage(
                percentage
            ),

        result:
            percentage >= 33
                ? "PASS"
                : "FAIL"

    };

}


/* =========================================================
   GENERATE ALL
========================================================= */

function applyStudentDatabaseMeta(result,student){
    if(!result||!student)return result;
    result.studentId=student.id||student._id||"";
    result.name=student.name||result.name||"";
    // Father name is shown only in the student-selection list.
    // It is intentionally NOT used in the generated result.
    result.fatherName="";
    result.srNo="";
    result.rollNo="";
    result.uid="";
    result.session=student.academicSession||student.schoolJoinSession||result.session||"";
    result.className=isClass11()?"11th":selectedResultClass;
    return result;
}

function getDatabaseStudentInputs(){
    return [...document.querySelectorAll(".student-row")].map(row=>({
        id:row.dataset.studentId||"",
        name:row.dataset.studentName||"",
        fatherName:row.dataset.fatherName||"",
        serialNo:row.dataset.serialNo||"",
        uid:row.dataset.uid||"",
        academicSession:row.dataset.academicSession||"",
        class:row.dataset.classNumber||"",
        targetInput:row.querySelector(".studentTarget")
    }));
}

function validateDatabaseStudents(){
    const rows=getDatabaseStudentInputs();
    const errorBox=document.getElementById("generatorError");
    if(!rows.length){
        errorBox.style.display="block";
        errorBox.textContent="⚠️ No students were loaded from the database. Please select the class again.";
        return null;
    }
    const bounds=getBounds();
    const minPercentage=bounds.total?bounds.minimum/bounds.total*100:0;
    const maxPercentage=bounds.total?bounds.maximum/bounds.total*100:0;
    const students=[];
    for(const row of rows){
        const name=row.name.trim();
        const rawTarget=row.targetInput?.value??"";
        const target=numberValue(rawTarget);
        if(!name){errorBox.style.display="block";errorBox.textContent="⚠️ A student record has no name.";return null;}
        if(rawTarget===""||target<0||target>100){errorBox.style.display="block";errorBox.textContent=`⚠️ Enter a valid target percentage for ${name}.`;return null;}
        if(target<minPercentage||target>maxPercentage){errorBox.style.display="block";errorBox.textContent=`${name}: ${target.toFixed(2)}% cannot be generated. Possible range is ${minPercentage.toFixed(2)}% - ${maxPercentage.toFixed(2)}%.`;return null;}
        students.push({id:row.id,name,fatherName:row.fatherName,serialNo:row.serialNo,uid:row.uid,academicSession:row.academicSession,class:row.class,target});
    }
    return {students};
}

function legacy_generateResults(){
    const error=validateSubjects();
    const errorBox=document.getElementById("generatorError");
    if(error){errorBox.style.display="block";errorBox.textContent="⚠️ "+error;return;}
    const prepared=validateDatabaseStudents();
    if(!prepared)return;
    const subjects=getSubjects();
    generatedResults=[];
    for(const student of prepared.students){
        const result=generateStudentResult(student,subjects);
        if(!result){errorBox.style.display="block";errorBox.textContent=`Could not generate a valid result for ${student.name}.`;return;}
        applyStudentDatabaseMeta(result,student);
        generatedResults.push(result);
    }
    errorBox.style.display="none";
    renderGeneratedResults();
    document.getElementById("previewCard").classList.remove("hidden");
    document.getElementById("previewCard").scrollIntoView({behavior:"smooth"});
}

function legacy_calculateResult(
    result
){

    const obtained =
        result.subjects.reduce(
            (
                sum,
                subject
            ) =>
                sum +
                subject.marks.reduce(
                    (a,b)=>a+b,
                    0
                ),
            0
        );


    const total =
        result.subjects.length *
        200;


    const percentage =
        total > 0
            ? obtained / total * 100
            : 0;


    return {

        obtained,

        total,

        percentage,

        grade:
            gradeFromPercentage(
                percentage
            ),

        result:
            percentage >= 33
                ? "PASS"
                : "FAIL"

    };

}


/* =========================================================
   RENDER GENERATED RESULTS
========================================================= */

function legacy_renderGeneratedResults(){

    const container =
        document.getElementById(
