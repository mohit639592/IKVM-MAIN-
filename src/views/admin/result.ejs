/* =========================================================
   CARD MARK EDIT
========================================================= */

function handleCardMarkInput(
    event
){

    const input =
        event.target;


    const resultIndex =
        Number(
            input.dataset.result
        );


    const subjectIndex =
        Number(
            input.dataset.subject
        );


    const componentIndex =
        Number(
            input.dataset.component
        );


    const result =
        generatedResults[
            resultIndex
        ];


    if(!result)
        return;


    const subject =
        result.subjects[
            subjectIndex
        ];


    if(!subject)
        return;


    const maximum =
        COMPONENTS[
            componentIndex
        ].max;


    let value =
        numberValue(
            input.value
        );


    value =
        Math.max(
            0,
            Math.min(
                maximum,
                value
            )
        );


    input.value =
        value;


    subject.marks[
        componentIndex
    ] = value;


    /*
      Update the generated result data.
    */

    const calculation =
        calculateResult(
            result
        );


    result.obtained =
        calculation.obtained;

    result.total =
        calculation.total;

    result.percentage =
        calculation.percentage;

    result.grade =
        calculation.grade;

    result.result =
        calculation.result;


    updateSchoolCardTotals(
        resultIndex
    );


    /*
      Also update the generated-result section
      when the admin goes back.
    */

    updateGeneratedResultUI(
        resultIndex
    );

}


/* =========================================================
   UPDATE SCHOOL CARD TOTALS
========================================================= */

function updateSchoolCardTotals(
    resultIndex
){

    const result =
        generatedResults[
            resultIndex
        ];


    const calculation =
        calculateResult(
            result
        );


    const totals =
        [0,0,0,0,0,0];


    result.subjects.forEach(
        (
            subject,
            subjectIndex
        )=>{

            subject.marks.forEach(
                (
                    mark,
                    componentIndex
                )=>{

                    totals[
                        componentIndex
                    ] +=
                        numberValue(mark);

                }
            );


            const term1 =
                subject.marks[0] +
                subject.marks[1] +
                subject.marks[2];


            const term2 =
                subject.marks[3] +
                subject.marks[4] +
                subject.marks[5];


            const final =
                term1 +
                term2;


            const t1 =
                document.getElementById(
                    `card-term1-${resultIndex}-${subjectIndex}`
                );


            const t2 =
                document.getElementById(
                    `card-term2-${resultIndex}-${subjectIndex}`
                );


            const f =
                document.getElementById(
                    `card-final-${resultIndex}-${subjectIndex}`
                );


            if(t1)
                t1.textContent =
                    term1;


            if(t2)
                t2.textContent =
                    term2;


            if(f)
                f.textContent =
                    final;

        }
    );


    const set =
        (
            id,
            value
        )=>{

            const element =
                document.getElementById(id);

            if(element)
                element.textContent =
                    value;

        };


    set(
        "card-total-fa1",
        totals[0]
    );


    set(
        "card-total-fa2",
        totals[1]
    );


    set(
        "card-total-sa1",
        totals[2]
    );


    set(
        "card-total-term1",
        totals[0] +
        totals[1] +
