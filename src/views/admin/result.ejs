                            id="generated-percent-${resultIndex}"
                        >
                            ${result.percentage.toFixed(2)}%
                        </span>

                    </span>

                </div>


                <div class="generated-scroll">

                    <table class="generated-table">

                        <thead>

                            <tr>

                                <th>Subject</th>

                                <th>FA-1 /20</th>
                                <th>FA-2 /20</th>
                                <th>S.A.-1 /60</th>

                                <th>Term 1 /100</th>

                                <th>FA-3 /20</th>
                                <th>FA-4 /20</th>
                                <th>S.A.-2 /60</th>

