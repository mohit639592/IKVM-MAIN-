let selectedResultClass = "1st";

const CLASS11_COMPONENTS = [
    { key:"halfWritten", label:"Half-Yearly Written", max:100 },
    { key:"halfPractical", label:"Half-Yearly Practical", max:30 },
    { key:"annualWritten", label:"Annual Written", max:100 },
    { key:"annualPractical", label:"Annual Practical", max:30 }
];

const CLASS11_SUBJECTS = [
    { name:"हिन्दी", ranges:[[0,100],[0,30],[0,100],[0,30]] },
    { name:"अंग्रेजी", ranges:[[0,100],[0,30],[0,100],[0,30]] },
    { name:"गणित/जीव विज्ञान", ranges:[[0,100],[0,30],[0,100],[0,30]] },
    { name:"भौतिक", ranges:[[0,100],[0,30],[0,100],[0,30]] },
    { name:"रसायन विज्ञान", ranges:[[0,100],[0,30],[0,100],[0,30]] }
];

function isClass11(){ return selectedResultClass === "11th"; }
function activeComponents(){ return isClass11() ? CLASS11_COMPONENTS : COMPONENTS; }

async function applyResultClass(){
    const selector=document.getElementById("resultClass");
    selectedResultClass=selector ? selector.value : "1st";
    const box=document.getElementById("subjectsContainer");
    if(!box)return;
    box.innerHTML="";
    if(isClass11()) CLASS11_SUBJECTS.forEach(subject=>addSubject(subject));
    else DEFAULT_SUBJECTS.forEach(subject=>addSubject(subject));
    const addButton=document.getElementById("addSubjectButton");
    if(addButton) addButton.style.display=isClass11()?"none":"inline-block";
    document.querySelectorAll(".class11-remove").forEach(button=>{button.style.display=isClass11()?"none":"inline-block";});
    updateRange();
    await loadStudentsFromIKVM();
}

async function loadStudentsFromIKVM(){
    const selector=document.getElementById("resultClass");
    const container=document.getElementById("studentsContainer");
    const card=document.getElementById("studentsCard");
    if(!selector||!container||!card)return;
    card.classList.remove("hidden");
    container.innerHTML='<div class="notice" style="margin-top:10px">Loading students from the IKVM database...</div>';
    try{
        const response=await fetch(`/api/admin/results/students?class=${encodeURIComponent(selector.value)}`,{headers:{"Accept":"application/json"}});
        if(!response.ok)throw new Error(`Server returned ${response.status}`);
        const data=await response.json();
        if(!data.success)throw new Error(data.message||"Unable to load students");
        renderStudentsFromDatabase(data.students||[]);
    }catch(error){
        console.error("Result student loading error:",error);
        container.innerHTML=`<div class="error-box" style="display:block">⚠️ ${esc(error.message||"Unable to load students from database")}</div>`;
    }
}

function renderStudentsFromDatabase(students){
    const container=document.getElementById("studentsContainer");
    const card=document.getElementById("studentsCard");
    if(!container||!card)return;
    container.innerHTML="";
    if(!students.length){
        container.innerHTML='<div class="notice" style="margin-top:10px">No active students found for the selected class.</div>';
        card.classList.remove("hidden");
        return;
    }
    students.forEach((student,index)=>{
        const row=document.createElement("div");
        row.className="student-row";
        row.dataset.studentId=student._id||"";
        row.dataset.studentName=student.name||"";
        row.dataset.fatherName=student.fatherName||"";
