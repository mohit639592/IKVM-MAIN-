<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Add Students | IKVM</title>


<style>

/* =========================================================
   ROOT
========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {

    --bg: #06080d;

    --panel: #0d111a;
    --panel2: #111722;
    --panel3: #151c29;

    --border: rgba(255,255,255,.075);
    --border2: rgba(255,255,255,.12);

    --text: #f2f4f8;
    --muted: #7d879a;
    --muted2: #596376;

    --purple: #696fff;
    --purple2: #8b62ff;

    --green: #25d49e;
    --red: #ff626d;
    --orange: #ffb45c;

}


/* =========================================================
   BODY
========================================================= */

body {

    min-height: 100vh;

    color: var(--text);

    font-family:
        Inter,
        "Segoe UI",
        Arial,
        sans-serif;

    background:

        radial-gradient(
            circle at 10% -10%,
            rgba(105,111,255,.18),
            transparent 32%
        ),

        radial-gradient(
            circle at 100% 50%,
            rgba(139,98,255,.08),
            transparent 30%
        ),

        #06080d;

}


/* =========================================================
   PAGE
========================================================= */

.page {

    width:
        min(
            1500px,
            calc(100% - 46px)
        );

    margin:
        auto;

    padding:
        28px 0 100px;

}


/* =========================================================
   TOPBAR
========================================================= */

.topbar {

    display:
        flex;

    justify-content:
        space-between;

    align-items:
        center;

    gap:
        20px;

    margin-bottom:
        22px;

}


.brand {

    display:
        flex;

    align-items:
        center;

    gap:
        14px;

}


.brand-icon {

    width:
        50px;

    height:
        50px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        15px;

    color:
        #969aff;

    background:
        linear-gradient(
            135deg,
            rgba(105,111,255,.20),
            rgba(139,98,255,.07)
        );

    border:
        1px solid
        rgba(105,111,255,.22);

    font-size:
        21px;

}


.eyebrow {

    color:
        #7c82ff;

    font-size:
        9px;

    font-weight:
        800;

    letter-spacing:
        2px;

}


h1 {

    margin-top:
        3px;

    font-size:
        27px;

    letter-spacing:
        -.6px;

}


.subtitle {

    margin-top:
        5px;

    color:
        var(--muted);

    font-size:
        11px;

}


.back-btn {

    height:
        40px;

    padding:
        0 14px;

    display:
        inline-flex;

    align-items:
        center;

    gap:
        8px;

    color:
        #aab2c1;

    text-decoration:
        none;

    border:
        1px solid
        var(--border);

    border-radius:
        9px;

    background:
        rgba(255,255,255,.025);

    font-size:
        10px;

}


.back-btn:hover {

    color:
        white;

    background:
        rgba(255,255,255,.06);

}


/* =========================================================
   FIELD LIBRARY
========================================================= */

.library {

    position:
        sticky;

    top:
        12px;

    z-index:
        50;

    margin-bottom:
        18px;

    padding:
        17px 19px;

    border:
        1px solid
        var(--border);

    border-radius:
        16px;

    background:
        rgba(13,17,26,.88);

    backdrop-filter:
        blur(18px);

    box-shadow:
        0 18px 55px
        rgba(0,0,0,.27);

}


.library-top {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    margin-bottom:
        13px;

}


.library-title {

    display:
        flex;

    align-items:
        center;

    gap:
        9px;

}


.library-title-icon {

    width:
        28px;

    height:
        28px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        8px;

    color:
        #8c91ff;

    background:
        rgba(105,111,255,.12);

}


.library h2 {

    font-size:
        12px;

}


.library p {

    margin-top:
        2px;

    color:
        var(--muted2);

    font-size:
        9px;

}


.library-hint {

    color:
        #687287;

    font-size:
        8px;

}


.field-library {

    display:
        flex;

    gap:
        8px;

    overflow-x:
        auto;

    padding-bottom:
        3px;

}


.field-library::-webkit-scrollbar {

    height:
        4px;

}


.field-library::-webkit-scrollbar-thumb {

    background:
        #293143;

    border-radius:
        10px;

}


.library-field {

    flex:
        0 0 auto;

    min-height:
        42px;

    padding:
        0 13px;

    display:
        flex;

    align-items:
        center;

    gap:
        8px;

    border:
        1px solid
        #273043;

    border-radius:
        9px;

    color:
        #9aa3b5;

    background:
        #0a0e15;

    cursor:
        pointer;

    font-size:
        9px;

    transition:
        .18s;

}


.library-field:hover {

    color:
        white;

    border-color:
        rgba(105,111,255,.6);

    background:
        rgba(105,111,255,.08);

    transform:
        translateY(-1px);

}


.library-field .plus {

    width:
        21px;

    height:
        21px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        6px;

    color:
        #8990ff;

    background:
        rgba(105,111,255,.10);

}


.library-field.active {

    border-color:
        rgba(37,212,158,.45);

    color:
        #bcefe0;

}


.library-field.active .plus {

    color:
        var(--green);

    background:
        rgba(37,212,158,.10);

}


/* =========================================================
   TOOLBAR
========================================================= */

.toolbar {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    margin-bottom:
        13px;

}


.student-count {

    color:
        var(--muted);

    font-size:
        10px;

}


.student-count strong {

    color:
        white;

    font-size:
        14px;

}


.toolbar-actions {

    display:
        flex;

    gap:
        8px;

}


.tool-btn {

    height:
        38px;

    padding:
        0 13px;

    border:
        1px solid
        #293143;

    border-radius:
        9px;

    color:
        #9ba4b5;

    background:
        #0b0f16;

    cursor:
        pointer;

    font-size:
        9px;

}


.tool-btn:hover {

    color:
        white;

    border-color:
        #414b60;

}


.tool-btn.primary {

    color:
        white;

    border:
        0;

    background:
        linear-gradient(
            135deg,
            #626aff,
            #845bff
        );

}


/* =========================================================
   STUDENTS
========================================================= */

.students-list {

    display:
        flex;

    flex-direction:
        column;

    gap:
        13px;

}


/* =========================================================
   STUDENT CARD
========================================================= */

.student-card {

    position:
        relative;

    overflow:
        hidden;

    border:
        1px solid
        var(--border);

    border-radius:
        16px;

    background:
        linear-gradient(
            145deg,
            rgba(17,23,34,.96),
            rgba(10,14,21,.96)
        );

    box-shadow:
        0 15px 45px
        rgba(0,0,0,.18);

}


.student-card::before {

    content:
        "";

    position:
        absolute;

    left:
        0;

    top:
        0;

    width:
        3px;

    height:
        100%;

    background:
        linear-gradient(
            #6a70ff,
            #8960ff
        );

    opacity:
        .7;

}


.student-header {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    gap:
        15px;

    padding:
        15px 17px;

    border-bottom:
        1px solid
        var(--border);

}


.student-heading {

    display:
        flex;

    align-items:
        center;

    gap:
        11px;

}


.student-number {

    width:
        34px;

    height:
        34px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        10px;

    color:
        #8d93ff;

    background:
        rgba(105,111,255,.10);

    font-size:
        10px;

    font-weight:
        800;

}


.student-heading h3 {

    font-size:
        12px;

}


.student-heading p {

    margin-top:
        3px;

    color:
        var(--muted2);

    font-size:
        8px;

}


.remove-student {

    width:
        31px;

    height:
        31px;

    border:
        1px solid
        rgba(255,98,109,.15);

    border-radius:
        8px;

    color:
        #a35e66;

    background:
        rgba(255,98,109,.045);

    cursor:
        pointer;

}


.remove-student:hover {

    color:
        #ff737c;

    background:
        rgba(255,98,109,.1);

}


/* =========================================================
   STUDENT BODY
========================================================= */

.student-body {

    padding:
        18px;

}


.fields-grid {

    display:
        grid;

    grid-template-columns:
        repeat(
            4,
            minmax(
                0,
                1fr
            )
        );

    gap:
        11px;

}


/* =========================================================
   FORM FIELD
========================================================= */

.form-field {

    min-width:
        0;

}


.form-field.full {

    grid-column:
        span 2;

}


.form-label {

    display:
        flex;

    align-items:
        center;

    gap:
        5px;

    margin-bottom:
        6px;

    color:
        #8992a5;

    font-size:
        8px;

    font-weight:
        800;

    text-transform:
        uppercase;

    letter-spacing:
        .7px;

}


.required {

    color:
        #ff6972;

}


.input {

    width:
        100%;

    height:
        42px;

    padding:
        0 11px;

    border:
        1px solid
        #283143;

    outline:
        none;

    border-radius:
        8px;

    color:
        #edf0f5;

    background:
        #080c12;

    font-size:
        10px;

    transition:
        .18s;

}


.input:focus {

    border-color:
        rgba(105,111,255,.7);

    box-shadow:
        0 0 0 3px
        rgba(105,111,255,.07);

}


.input.invalid {

    border-color:
        rgba(255,98,109,.8);

}


select.input {

    cursor:
        pointer;

}


/* =========================================================
   OPTIONAL FIELD
========================================================= */

.optional-field {

    position:
        relative;

}


.optional-field .remove-field {

    position:
        absolute;

    top:
        -3px;

    right:
        -3px;

    width:
        18px;

    height:
        18px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border:
        1px solid
        #313a4c;

    border-radius:
        50%;

    color:
        #737d91;

    background:
        #101621;

    cursor:
        pointer;

    font-size:
        8px;

}


.optional-field .remove-field:hover {

    color:
        #ff727a;

}


/* =========================================================
   ADD FIELD
========================================================= */

.add-field-area {

    margin-top:
        17px;

    padding-top:
        15px;

    border-top:
        1px solid
        rgba(255,255,255,.055);

}


.add-field-btn {

    height:
        38px;

    padding:
        0 13px;

    display:
        inline-flex;

    align-items:
        center;

    gap:
        7px;

    border:
        1px dashed
        #30394b;

    border-radius:
        9px;

    color:
        #818b9e;

    background:
        transparent;

    cursor:
        pointer;

    font-size:
        9px;

}


.add-field-btn:hover {

    color:
        #aab0ff;

    border-color:
        #5961b9;

    background:
        rgba(105,111,255,.05);

}


/* =========================================================
   DOCUMENTS
========================================================= */

.special-box {

    padding:
        11px;

    border:
        1px solid
        #283143;

    border-radius:
        9px;

    background:
        #080c12;

}


.document-list {

    display:
        flex;

    flex-wrap:
        wrap;

    gap:
        6px;

}


.document-tag {

    display:
        inline-flex;

    align-items:
        center;

    gap:
        7px;

    padding:
        7px 9px;

    border:
        1px solid
        #293346;

    border-radius:
        7px;

    color:
        #c5cbd6;

    background:
        #141a24;

    font-size:
        8px;

}


.document-remove {

    border:
        0;

    color:
        #737d8e;

    background:
        transparent;

    cursor:
        pointer;

}


.document-remove:hover {

    color:
        #ff7079;

}


.document-add {

    display:
        flex;

    gap:
        6px;

    margin-top:
        8px;

}


.document-add .input {

    height:
        34px;

}


.document-add button {

    width:
        36px;

    border:
        0;

    border-radius:
        8px;

    color:
        white;

    background:
        #5e67ef;

    cursor:
        pointer;

}


/* =========================================================
   CUSTOM FIELDS
========================================================= */

.custom-row {

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap:
        7px;

    margin-bottom:
        7px;

}


.custom-name {

    height:
        34px;

    display:
        flex;

    align-items:
        center;

    padding:
        0 9px;

    color:
        #777f91;

    border:
        1px solid
        #242d3d;

    border-radius:
        7px;

    background:
        #0b0f16;

    font-size:
        8px;

}


.custom-value {

    height:
        34px;

    width:
        100%;

    padding:
        0 8px;

    color:
        white;

    outline:
        none;

    border:
        1px solid
        #293143;

    border-radius:
        7px;

    background:
        #080c12;

    font-size:
        8px;

}


.custom-value:focus {

    border-color:
        rgba(105,111,255,.65);

}


/* =========================================================
   AADHAAR
========================================================= */

.aadhaar-status {

    min-height:
        12px;

    margin-top:
        4px;

    font-size:
        8px;

}


.ok {

    color:
        var(--green);

}


.warning {

    color:
        var(--red);

}


/* =========================================================
   EMPTY
========================================================= */

.empty {

    padding:
        70px 20px;

    text-align:
        center;

    border:
        1px dashed
        #273043;

    border-radius:
        14px;

    color:
        #697286;

}


.empty-icon {

    font-size:
        30px;

    opacity:
        .35;

    margin-bottom:
        10px;

}


.empty h3 {

    color:
        #9ca4b4;

    font-size:
        13px;

}


.empty p {

    margin-top:
        5px;

    font-size:
        9px;

}


/* =========================================================
   SAVE BAR
========================================================= */

.save-bar {

    position:
        sticky;

    bottom:
        18px;

    z-index:
        100;

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    gap:
        15px;

    margin-top:
        18px;

    padding:
        13px 15px 13px 18px;

    border:
        1px solid
        rgba(255,255,255,.10);

    border-radius:
        14px;

    background:
        rgba(10,14,21,.91);

    backdrop-filter:
        blur(18px);

    box-shadow:
        0 25px 70px
        rgba(0,0,0,.48);

}


.save-info {

    color:
        #7d8799;

    font-size:
        9px;

}


.save-info strong {

    color:
        white;

}


.save-btn {

    height:
        43px;

    padding:
        0 20px;

    border:
        0;

    border-radius:
        9px;

    color:
        white;

    background:
        linear-gradient(
            135deg,
            #00ad81,
            #00c995
        );

    font-size:
        10px;

    font-weight:
        800;

    cursor:
        pointer;

    box-shadow:
        0 10px 25px
        rgba(0,201,149,.13);

}


.save-btn:hover {

    filter:
        brightness(1.08);

}


.save-btn:disabled {

    opacity:
        .5;

    cursor:
        not-allowed;

}


/* =========================================================
   MODAL
========================================================= */

.modal {

    position:
        fixed;

    inset:
        0;

    z-index:
        500;

    display:
        none;

    align-items:
        center;

    justify-content:
        center;

    padding:
        20px;

    background:
        rgba(0,0,0,.70);

    backdrop-filter:
        blur(8px);

}


.modal.open {

    display:
        flex;

}


.modal-box {

    width:
        min(
            620px,
            100%
        );

    max-height:
        80vh;

    overflow:
        hidden;

    border:
        1px solid
        #293245;

    border-radius:
        16px;

    background:
        #0d1119;

    box-shadow:
        0 35px 100px
        rgba(0,0,0,.65);

}


.modal-header {

    padding:
        17px 19px;

    border-bottom:
        1px solid
        var(--border);

}


.modal-header h3 {

    font-size:
        13px;

}


.modal-header p {

    margin-top:
        4px;

    color:
        var(--muted);

    font-size:
        9px;

}


.modal-body {

    max-height:
        58vh;

    overflow:
        auto;

    padding:
        15px;

}


.modal-fields {

    display:
        grid;

    grid-template-columns:
        repeat(
            2,
            1fr
        );

    gap:
        8px;

}


.modal-field {

    min-height:
        45px;

    display:
        flex;

    align-items:
        center;

    gap:
        9px;

    padding:
        0 11px;

    border:
        1px solid
        #283143;

    border-radius:
        9px;

    color:
        #929bad;

    background:
        #0a0e15;

    cursor:
        pointer;

    font-size:
        9px;

}


.modal-field:hover {

    color:
        white;

    border-color:
        #4a5368;

}


.modal-field.disabled {

    opacity:
        .35;

    cursor:
        not-allowed;

}


.modal-icon {

    width:
        24px;

    height:
        24px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        7px;

    color:
        #858cff;

    background:
        rgba(105,111,255,.09);

}


.modal-footer {

    display:
        flex;

    justify-content:
        flex-end;

    padding:
        12px 15px;

    border-top:
        1px solid
        var(--border);

}


.close-modal {

    height:
        36px;

    padding:
        0 14px;

    border:
        1px solid
        #293143;

    border-radius:
        8px;

    color:
        #9ca5b7;

    background:
        #0a0e15;

    cursor:
        pointer;

}


/* =========================================================
   TOAST
========================================================= */

.toast {

    position:
        fixed;

    right:
        22px;

    bottom:
        22px;

    z-index:
        1000;

    display:
        none;

    max-width:
        400px;

    padding:
        12px 15px;

    border:
        1px solid
        #30394c;

    border-radius:
        10px;

    color:
        white;

    background:
        #111722;

    box-shadow:
        0 20px 60px
        rgba(0,0,0,.5);

    font-size:
        9px;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width: 1100px) {

    .fields-grid {

        grid-template-columns:
            repeat(
                3,
                minmax(
                    0,
                    1fr
                )
            );

    }

}


@media(max-width: 800px) {

    .page {

        width:
            calc(100% - 25px);

    }


    .topbar {

        align-items:
            flex-start;

    }


    .fields-grid {

        grid-template-columns:
            repeat(
                2,
                minmax(
                    0,
                    1fr
                )
            );

    }


    .form-field.full {

        grid-column:
            span 2;

    }


    .library {

        position:
            relative;

        top:
            auto;

    }


    .save-bar {

        flex-direction:
            column;

        align-items:
            stretch;

    }


    .save-btn {

        width:
            100%;

    }

}


@media(max-width: 500px) {

    .page {

        width:
            calc(100% - 16px);

        padding-top:
            15px;

    }


    .brand-icon {

        display:
            none;

    }


    h1 {

        font-size:
            23px;

    }


    .fields-grid {

        grid-template-columns:
            1fr;

    }


    .form-field.full {

        grid-column:
            span 1;

    }


    .modal-fields {

        grid-template-columns:
            1fr;

    }

}



/* =========================================================
   IKVM V2 VISUAL POLISH
========================================================= */
.topbar{padding:18px 20px;border:1px solid rgba(120,130,255,.12);border-radius:20px;background:linear-gradient(135deg,rgba(18,23,36,.94),rgba(8,11,18,.9));box-shadow:0 20px 60px rgba(0,0,0,.28)}
.eyebrow{font-size:10px;letter-spacing:2.4px}.topbar h1{font-size:31px}.subtitle{font-size:12px;color:#8e98ad}
.back-btn{height:44px;padding:0 17px;border-radius:12px;font-size:11px;border-color:rgba(255,255,255,.1);transition:.2s}.back-btn:hover{transform:translateY(-2px);border-color:rgba(105,111,255,.5);box-shadow:0 10px 30px rgba(105,111,255,.12)}
