.library h2{font-size:15px}.library p{font-size:10px}.library-title-icon{width:34px;height:34px;border-radius:10px;font-size:16px}.library-hint{font-size:9px;padding:6px 9px;border:1px solid rgba(255,255,255,.07);border-radius:999px;background:rgba(255,255,255,.025)}
.field-library{gap:10px;padding:4px 2px 8px}.library-field{min-height:48px;padding:0 15px;border-radius:12px;font-size:10px;box-shadow:inset 0 1px rgba(255,255,255,.025);transition:.2s}.library-field .plus{width:25px;height:25px;border-radius:8px;font-size:13px}.library-field:hover{transform:translateY(-3px);box-shadow:0 10px 25px rgba(0,0,0,.2)}.library-field.active{box-shadow:0 0 0 1px rgba(37,212,158,.12),0 10px 25px rgba(37,212,158,.07)}
.toolbar{padding:3px 2px}.student-count{font-size:11px}.student-count strong{font-size:18px}.tool-btn{height:42px;border-radius:11px;font-size:10px;padding:0 15px}.tool-btn.primary{box-shadow:0 10px 25px rgba(105,111,255,.2)}
.student-card{border-radius:20px;background:linear-gradient(145deg,rgba(19,25,39,.98),rgba(8,12,19,.98));box-shadow:0 18px 55px rgba(0,0,0,.25);transition:.2s}.student-card:hover{border-color:rgba(105,111,255,.18);transform:translateY(-1px)}.student-header{padding:17px 20px}.student-number{width:40px;height:40px;border-radius:12px;font-size:11px}.student-heading h3{font-size:14px}.student-heading p{font-size:9px}.student-body{padding:20px}.fields-grid{gap:14px}.form-label{font-size:9px;margin-bottom:7px;color:#a0a9bb}.input{height:46px;border-radius:10px;font-size:11px;padding:0 13px}.input:focus{box-shadow:0 0 0 4px rgba(105,111,255,.09),0 8px 24px rgba(0,0,0,.18)}
.add-field-area{margin-top:20px;padding-top:18px}.add-field-btn{height:42px;border-radius:11px;font-size:10px;padding:0 15px}.special-box{padding:14px;border-radius:12px}.document-tag{padding:9px 11px;border-radius:9px;font-size:10px}.document-add .input{height:40px}.document-add button{width:42px;border-radius:10px;font-size:16px}
.custom-row{grid-template-columns:1fr 1fr 42px;gap:8px;margin-bottom:8px}.custom-name,.custom-value{height:40px;border-radius:9px;font-size:10px}.custom-name{padding:0 11px}.custom-value{padding:0 10px}.custom-remove{height:40px;border:1px solid rgba(255,98,109,.16);border-radius:9px;color:#ff747c;background:rgba(255,98,109,.05);cursor:pointer}.custom-add{height:40px;margin-top:9px;padding:0 13px;border:1px dashed #364057;border-radius:9px;color:#9aa4b7;background:rgba(255,255,255,.02);cursor:pointer}.custom-add:hover{color:#fff;border-color:#656eff;background:rgba(105,111,255,.06)}
.status-select{display:grid;grid-template-columns:1fr 1fr;gap:8px}.status-select-input{cursor:pointer;appearance:auto}.status-choice{position:relative}.status-choice input{position:absolute;opacity:0;pointer-events:none}.status-choice label{height:46px;display:flex;align-items:center;gap:9px;padding:0 13px;border:1px solid #293143;border-radius:10px;background:#080c12;color:#8f99ac;cursor:pointer;font-size:10px;font-weight:700;transition:.2s}.status-dot{width:9px;height:9px;border-radius:50%;background:#5c6678;box-shadow:0 0 0 4px rgba(92,102,120,.08)}.status-choice input[value="active"]:checked+label{color:#bdf4e2;border-color:rgba(37,212,158,.5);background:rgba(37,212,158,.08);box-shadow:0 0 0 3px rgba(37,212,158,.06)}.status-choice input[value="active"]:checked+label .status-dot{background:#25d49e;box-shadow:0 0 0 4px rgba(37,212,158,.1)}.status-choice input[value="deactive"]:checked+label{color:#ffc1c6;border-color:rgba(255,98,109,.45);background:rgba(255,98,109,.07)}.status-choice input[value="deactive"]:checked+label .status-dot{background:#ff626d;box-shadow:0 0 0 4px rgba(255,98,109,.1)}
.aadhaar-status{font-size:9px;margin-top:6px}.save-bar{padding:15px 18px;border-radius:17px}.save-info{font-size:10px}.save-btn{height:47px;border-radius:11px;font-size:11px;padding:0 23px}

</style>

</head>


<body>


<div class="page">


<!-- =====================================================
     HEADER
====================================================== -->

<header class="topbar">

    <div class="brand">

        <div class="brand-icon">
            ✦
        </div>

        <div>

            <div class="eyebrow">
                IKVM · STUDENT MANAGEMENT
            </div>

            <h1>
                Add Students
            </h1>

            <div class="subtitle">
                Create multiple student records together.
            </div>

        </div>

    </div>


    <a
        href="/admin/students"
        class="back-btn"
    >

        ←

        Back to Students

    </a>

</header>



<!-- =====================================================
     FIELD LIBRARY
====================================================== -->

<section class="library">


    <div class="library-top">

        <div class="library-title">

            <div class="library-title-icon">
                ✦
            </div>

            <div>

                <h2>
                    Field Library
                </h2>

                <p>
                    Tap a field to add it to every student.
                </p>

            </div>

        </div>


        <div class="library-hint">
            GLOBAL FIELDS
        </div>

    </div>


    <div
        class="field-library"
        id="fieldLibrary"
    >


        <!-- BUILT-IN FIELDS -->

        <% (builtInFields || []).forEach(
            field => {

                /*
                 * Required fields are already displayed
                 * inside every student card.
                 */

        %>

            <button
                type="button"

                class="library-field"

                data-key="<%= field.key %>"

                data-label="<%= field.label %>"

                data-type="builtin"
            >

                <span class="plus">
                    +
                </span>

                <span>
                    <%= field.label %>
                </span>

            </button>

        <% }) %>



        <!-- DYNAMIC STUDENT FIELDS -->

        <% (
            dynamicFields &&
            dynamicFields.student
                ? dynamicFields.student
                : []
        ).forEach(
            field => {
        %>

            <button
                type="button"

                class="library-field"

                data-key="dynamic:student:<%= field.key %>"

                data-label="<%= field.label %>"

                data-type="dynamic-student"

                data-dynamic-key="<%= field.key %>"
            >

                <span class="plus">
                    +
                </span>

                <span>
                    <%= field.label %>
                </span>

            </button>

        <% }) %>



        <!-- DYNAMIC PARENT FIELDS -->

        <% (
            dynamicFields &&
            dynamicFields.parent
                ? dynamicFields.parent
                : []
        ).forEach(
            field => {
        %>

            <button
                type="button"

                class="library-field"

                data-key="dynamic:parent:<%= field.key %>"

                data-label="<%= field.label %>"

                data-type="dynamic-parent"

                data-dynamic-key="<%= field.key %>"
            >

                <span class="plus">
                    +
                </span>

                <span>
                    <%= field.label %>
                </span>

            </button>

        <% }) %>



        <!-- DOCUMENTS -->

        <button
            type="button"

            class="library-field"

            data-key="submittedDocuments"

            data-label="Documents Submitted"

            data-type="documents"
        >

            <span class="plus">
                +
            </span>

            <span>
                Documents
            </span>

        </button>



        <!-- ADDITIONAL INFORMATION -->

        <button
            type="button"

            class="library-field"

            data-key="customFields"

            data-label="Additional Information"

            data-type="custom"
        >

            <span class="plus">
                +
            </span>

            <span>
                Additional Information
            </span>

        </button>


    </div>

</section>



<!-- =====================================================
     TOOLBAR
====================================================== -->

<div class="toolbar">


    <div class="student-count">

        <strong id="studentCount">
            0
        </strong>

        students in this list

    </div>


    <div class="toolbar-actions">

        <button
            type="button"
            class="tool-btn"
            id="clearStudents"
        >
            Clear All
        </button>


        <button
            type="button"
            class="tool-btn primary"
            id="addStudent"
        >
            + Add Student
        </button>

    </div>

</div>



<!-- =====================================================
     STUDENTS
====================================================== -->

<div
    class="students-list"
    id="studentsList"
>


    <div
        class="empty"
        id="emptyState"
    >

        <div class="empty-icon">
            ✦
        </div>

        <h3>
            Your student list is empty
        </h3>

        <p>
            Click "Add Student" to create your first record.
        </p>

    </div>


</div>



<!-- =====================================================
     SAVE BAR
====================================================== -->

<div
    class="save-bar"
    id="saveBar"
>

    <div class="save-info">

        <strong id="saveCount">
            0
        </strong>

        student records ready to be created.

    </div>


    <button
        type="button"
        class="save-btn"
        id="saveAll"
    >

        ✓ Save All Students

    </button>

</div>

</div>



<!-- =====================================================
     FIELD MODAL
====================================================== -->

<div
    class="modal"
    id="fieldModal"
>


    <div class="modal-box">


        <div class="modal-header">

            <h3>
                Add Field to Student
            </h3>

            <p id="modalStudentName">
                Choose the information you want to add.
            </p>

        </div>


        <div
            class="modal-body"
        >

            <div
                class="modal-fields"
                id="modalFields"
            ></div>

        </div>


        <div class="modal-footer">

            <button
                type="button"
                class="close-modal"
                id="closeModal"
            >
                Close
            </button>

        </div>

    </div>

</div>



<!-- =====================================================
     TOAST
====================================================== -->

<div
    class="toast"
    id="toast"
></div>



<script>

/* =========================================================
   CONFIG
========================================================= */

const REQUIRED_FIELDS = [

    {
        key: "name",
        label: "Student Name",
        type: "text",
        required: true
    },

    {
        key: "class",
        label: "Class",
        type: "class",
        required: true
    },

    {
        key: "schoolJoinSession",
        label: "School Join Session",
        type: "text",
        required: true
    },

    {
        key: "status",
        label: "Student Status",
        type: "status",
        required: true
    },

    {
        key: "fatherName",
        label: "Father Name",
        type: "text",
        required: true
    },

    {
        key: "motherName",
        label: "Mother Name",
        type: "text",
        required: true
    }

];


/* =========================================================
   ELEMENTS
========================================================= */

const studentsList =
    document.getElementById(
        "studentsList"
    );

const emptyState =
    document.getElementById(
        "emptyState"
    );

const studentCount =
    document.getElementById(
        "studentCount"
    );

const saveCount =
    document.getElementById(
        "saveCount"
    );

const saveBar =
    document.getElementById(
        "saveBar"
    );

const fieldLibrary =
    document.getElementById(
        "fieldLibrary"
    );

const fieldModal =
    document.getElementById(
        "fieldModal"
    );

const modalFields =
    document.getElementById(
        "modalFields"
    );

const modalStudentName =
    document.getElementById(
        "modalStudentName"
    );

const toast =
    document.getElementById(
        "toast"
    );


let studentIndex = 0;

let activeStudentCard = null;


/* =========================================================
   ALL OPTIONAL FIELDS
========================================================= */

const OPTIONAL_FIELDS = [];


/* =========================================================
   REGISTER LIBRARY FIELDS
========================================================= */

fieldLibrary
    .querySelectorAll(
        ".library-field"
    )
    .forEach(
        button => {

            OPTIONAL_FIELDS.push({

                key:
                    button.dataset.key,

                label:
                    button.dataset.label,

                type:
                    button.dataset.type,

                dynamicKey:
                    button.dataset.dynamicKey ||
                    null

            });

        }
    );


/* =========================================================
   TOAST
========================================================= */

function showToast(
    message
) {

    toast.textContent =
        message;

    toast.style.display =
        "block";

    clearTimeout(
        window.__toast
    );

    window.__toast =
        setTimeout(
            () => {

                toast.style.display =
                    "none";

            },
            3200
        );

}


/* =========================================================
   ESCAPE
========================================================= */

function escapeHtml(
    value
) {

    return String(
        value ?? ""
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );

}


/* =========================================================
   FORMAT AADHAAR
========================================================= */

function formatAadhaar(
    value
) {

    return String(
        value || ""
    )
    .replace(
        /\D/g,
        ""
    )
    .slice(
        0,
        12
    )
    .replace(
        /(\d{4})(\d{4})(\d{0,4})/,
        "$1 $2 $3"
    )
    .trim();

}


/* =========================================================
   CREATE INPUT
========================================================= */

function createInput(
    field,
    optional = false
) {

    const wrapper =
        document.createElement(
            "div"
        );


    wrapper.className =
        "form-field" +
        (
            field.key ===
            "submittedDocuments" ||
            field.key ===
            "customFields"
                ? " full"
                : ""
        );


    wrapper.dataset.key =
        field.key;


    let html = `

        <label class="form-label">

            ${escapeHtml(
                field.label
            )}

            ${
                field.required
                    ? `<span class="required">*</span>`
                    : ""
            }

        </label>

    `;


    /* ============================================
       CLASS
    ============================================= */

    if(
        field.type ===
        "class"
    ) {

        html += `

            <select
                class="input"
                data-field="${escapeHtml(field.key)}"
                ${field.required ? "required" : ""}
            >

                <option value="">
                    Select class
                </option>

                ${Array
                    .from(
                        {
                            length: 12
                        },
                        (_, i) => `
                            <option value="${i + 1}">
                                Class ${i + 1}
                            </option>
                        `
                    )
                    .join("")
                }

            </select>

        `;

    }

    /* ============================================
       DOCUMENTS
    ============================================= */

    else if(field.key === "status" || field.type === "status") {

        html += `
            <select class="input status-select-input" data-field="status">
                <option value="active" selected>Active</option>
                <option value="deactive">Deactive</option>
            </select>
        `;

    }

    /* ============================================
       DOCUMENTS
    ============================================= */

    else if(
        field.key ===
        "submittedDocuments"
    ) {

        html += `

            <div
                class="special-box documents-box"
            >

                <div
                    class="document-list"
                ></div>


                <div
                    class="document-add"
                >

                    <input
                        class="input document-input"
                        placeholder="Add document..."
                    >

                    <button
                        type="button"
                        class="document-add-btn"
                    >
                        +
                    </button>

                </div>

            </div>

        `;

    }

    /* ============================================
       CUSTOM FIELDS
    ============================================= */

    else if(
        field.key ===
        "customFields"
    ) {

        html += `

            <div class="special-box custom-fields-box">
                <div class="custom-empty">No additional information added yet.</div>
                <button type="button" class="custom-add">＋ Add information</button>
            </div>

        `;

    }

    /* ============================================
       NORMAL
    ============================================= */

    else {

        html += `

            <input

                type="text"

                class="input"

                data-field="${escapeHtml(
                    field.key
                )}"

                ${
                    field.required
                        ? "required"
                        : ""
                }

                ${
                    field.key ===
                    "aadhaar"
                        ? `
                            maxlength="14"
                            inputmode="numeric"
                        `
                        : ""
                }

                ${
                    field.key ===
                    "aadhaar"
                        ? 'placeholder="1234 5678 9012"'
                        : ""
                }

            >

        `;

    }


    if(optional) {

        html += `

            <button
                type="button"
                class="remove-field"
                title="Remove field"
            >
                ×
            </button>

        `;

        wrapper.classList.add(
            "optional-field"
        );

    }


    wrapper.innerHTML =
        html;


    setupFieldEvents(
        wrapper,
        field
    );


    return wrapper;

}


/* =========================================================
   FIELD EVENTS
========================================================= */

function setupFieldEvents(
    wrapper,
    field
) {


    /* REMOVE */

    const remove =
        wrapper.querySelector(
            ".remove-field"
        );


    if(remove) {

        remove.addEventListener(
            "click",
            () => {

                wrapper.remove();

            }
        );

    }


    /* AADHAAR */

    const input =
        wrapper.querySelector(
            'input[data-field="aadhaar"]'
        );


    if(input) {

        input.addEventListener(
            "input",
            () => {

                input.value =
                    formatAadhaar(
                        input.value
                    );

                checkAadhaar(
                    input
                );

            }
        );

    }


    /* DOCUMENT */

    const customAdd = wrapper.querySelector(".custom-add");

    if(customAdd) {
        customAdd.addEventListener("click", () => addCustomRow(wrapper));
    }


    /* DOCUMENT */

    const documentButton =
        wrapper.querySelector(
            ".document-add-btn"
        );


    if(documentButton) {

        const documentInput =
            wrapper.querySelector(
                ".document-input"
            );


        documentButton.addEventListener(
            "click",
            () => {

                addDocument(
                    wrapper,
                    documentInput
                );

            }
        );


        documentInput.addEventListener(
            "keydown",
            event => {

                if(
                    event.key ===
                    "Enter"
                ) {

                    event.preventDefault();

                    addDocument(
                        wrapper,
                        documentInput
                    );

                }

            }
        );

    }

}


/* =========================================================
   DOCUMENT
========================================================= */

function addCustomRow(wrapper) {

    const box = wrapper.querySelector(".custom-fields-box");
    if(!box) return;

    const empty = box.querySelector(".custom-empty");
    if(empty) empty.remove();

    const row = document.createElement("div");
    row.className = "custom-row";
    row.innerHTML = `
        <input class="custom-name" type="text" placeholder="Information name">
        <input class="custom-value" type="text" placeholder="Value">
        <button type="button" class="custom-remove" title="Remove">×</button>
    `;

    row.querySelector(".custom-remove").addEventListener("click", () => {
        row.remove();
        if(!box.querySelector(".custom-row")) {
            const emptyAgain = document.createElement("div");
            emptyAgain.className = "custom-empty";
            emptyAgain.textContent = "No additional information added yet.";
            box.insertBefore(emptyAgain, box.querySelector(".custom-add"));
        }
    });

    box.insertBefore(row, box.querySelector(".custom-add"));
    row.querySelector(".custom-name").focus();
}


function addDocument(
    wrapper,
    input
) {

    const value =
        input.value.trim();


    if(!value) {

        return;

    }


    const list =
        wrapper.querySelector(
            ".document-list"
        );


    const tag =
        document.createElement(
            "div"
        );


    tag.className =
        "document-tag";


    tag.innerHTML = `

        <span>
            ${escapeHtml(value)}
        </span>

        <button
            type="button"
            class="document-remove"
        >
            ×
        </button>

    `;


    tag.querySelector(
        ".document-remove"
    )
    .addEventListener(
        "click",
        () => {

            tag.remove();

        }
    );


    list.appendChild(
        tag
    );


    input.value =
        "";

    input.focus();

}


/* =========================================================
   AADHAAR CHECK
========================================================= */

let aadhaarTimer;


function checkAadhaar(input) {

    const card =
        input.closest(".student-card");

    let status =
        input.parentElement.querySelector(
            ".aadhaar-status"
        );

    if (!status) {

        status =
            document.createElement("div");

        status.className =
            "aadhaar-status";

        input.parentElement.appendChild(
            status
        );
    }


    const clean =
        input.value.replace(/\D/g, "");


    clearTimeout(
        input._aadhaarTimer
    );


    input.classList.remove(
        "invalid"
    );


    // Empty
    if (!clean) {

        status.textContent = "";

        status.className =
            "aadhaar-status";

        input.dataset.aadhaarValid =
            "";

        return;
    }


    // Must be exactly 12 digits
    if (clean.length !== 12) {

        status.textContent =
            "Enter exactly 12 digits";

        status.className =
            "aadhaar-status warning";

        input.dataset.aadhaarValid =
            "false";

        return;
    }


    status.textContent =
        "Checking Aadhaar...";

    status.className =
        "aadhaar-status checking";


    const excludeId =
        card?.dataset.studentId || "";


    input._aadhaarTimer =
        setTimeout(
            async () => {

                try {

                    const response =
                        await fetch(

                            `/api/admin/students/check-aadhaar?aadhaar=${encodeURIComponent(
                                clean
                            )}&excludeId=${encodeURIComponent(
                                excludeId
                            )}`,

                            {
                                method:
                                    "GET",

                                credentials:
                                    "same-origin",

                                headers: {
                                    "Accept":
                                        "application/json"
                                }
                            }

                        );


                    if (!response.ok) {

                        throw new Error(
                            `HTTP ${response.status}`
                        );

                    }


                    const data =
                        await response.json();


                    if (!data.success) {

                        throw new Error(
                            data.message ||
                            "Aadhaar verification failed"
                        );

                    }


                    // ======================================
                    // AVAILABLE
                    // ======================================

                    if (
                        data.taken === false
                    ) {

                        status.textContent =
                            "✓ Aadhaar available";

                        status.className =
                            "aadhaar-status ok";

                        input.dataset.aadhaarValid =
                            "true";

                        input.classList.remove(
                            "invalid"
                        );

                        return;
                    }


                    // ======================================
                    // ALREADY TAKEN
                    // ======================================

                    if (
                        data.taken === true
                    ) {

                        const student =
                            data.student || {};


                        status.textContent =
                            `⚠ Already taken by ${
                                student.name ||
                                "another student"
                            } · Class ${
                                student.class ||
                                "-"
                            }`;


                        status.className =
                            "aadhaar-status warning";


                        input.dataset.aadhaarValid =
                            "false";


                        input.classList.add(
                            "invalid"
                        );

                        return;
                    }


                    // Unexpected response
                    throw new Error(
                        "Invalid Aadhaar response"
                    );


                }
                catch (error) {

                    console.error(
                        "Aadhaar verification error:",
                        error
                    );


                    status.textContent =
                        "Unable to verify Aadhaar";


                    status.className =
                        "aadhaar-status warning";


                    input.dataset.aadhaarValid =
                        "false";

                }

            },
            350
        );
}


/* =========================================================
   ADD STUDENT
========================================================= */

function addStudent() {


    studentIndex++;


    const card =
        document.createElement(
            "article"
        );


    card.className =
        "student-card";


    card.dataset.index =
        studentIndex;


    card.innerHTML = `

        <div class="student-header">

            <div class="student-heading">

                <div class="student-number">
                    ${String(
                        studentIndex
                    ).padStart(
                        2,
                        "0"
                    )}
                </div>

                <div>

                    <h3>
                        New Student
                    </h3>

                    <p>
                        Fill the required information below.
                    </p>

                </div>

            </div>


            <button
                type="button"
                class="remove-student"
                title="Remove student"
            >
                ×
            </button>

        </div>


        <div class="student-body">

            <div class="fields-grid"></div>


            <div class="add-field-area">

                <button
                    type="button"
                    class="add-field-btn"
                >

                    ＋

                    Add field for this student

                </button>

            </div>

        </div>

    `;


    const grid =
        card.querySelector(
            ".fields-grid"
        );


    REQUIRED_FIELDS.forEach(
        field => {

            grid.appendChild(
                createInput(
                    field
                )
            );

        }
    );


    /* REMOVE */

    card.querySelector(
        ".remove-student"
    )
    .addEventListener(
        "click",
        () => {

            card.remove();

            updateCounts();

        }
    );


    /* ADD FIELD */

    card.querySelector(
        ".add-field-btn"
    )
    .addEventListener(
        "click",
        () => {

            openFieldModal(
                card
            );

        }
    );


    studentsList.appendChild(
        card
    );


    emptyState.style.display =
        "none";


    updateCounts();


    card.scrollIntoView({

        behavior:
            "smooth",

        block:
            "center"

    });


    const nameInput =
        card.querySelector(
            '[data-field="name"]'
        );


    if(nameInput) {

        setTimeout(
            () => {

                nameInput.focus();

            },
            300
        );

    }

}


/* =========================================================
   GLOBAL FIELD
========================================================= */

fieldLibrary
    .querySelectorAll(
        ".library-field"
    )
    .forEach(
        button => {

            button.addEventListener(
                "click",
                () => {


                    const field = {

                        key:
                            button.dataset.key,

                        label:
                            button.dataset.label,

                        type:
                            button.dataset.type,

                        dynamicKey:
                            button.dataset.dynamicKey ||
                            null

                    };


                    const cards =
                        document.querySelectorAll(
                            ".student-card"
                        );


                    if(
                        cards.length === 0
                    ) {

                        showToast(
                            "Add at least one student first."
                        );

                        return;

                    }


                    cards.forEach(
                        card => {

                            addFieldToCard(
                                card,
                                field
                            );

                        }
                    );


                    button.classList.add(
                        "active"
                    );


                    updateCounts();

                }
            );

        }
    );


/* =========================================================
   ADD FIELD TO CARD
========================================================= */

function addFieldToCard(
    card,
    field
) {

    const grid =
        card.querySelector(
            ".fields-grid"
        );


    if(
        grid.querySelector(
            `[data-key="${CSS.escape(field.key)}"]`
        )
    ) {

        return;

    }


    const wrapper =
        createInput(
            field,
            true
        );


    grid.appendChild(
        wrapper
    );

}


/* =========================================================
   OPEN FIELD MODAL
========================================================= */

function openFieldModal(
    card
) {

    activeStudentCard =
        card;


    const name =
        card.querySelector(
            '[data-field="name"]'
        )?.value ||
        "this student";


    modalStudentName.textContent =
        `Choose a field to add only to ${name}.`;


    modalFields.innerHTML =
        "";


    const existing =
        [
            ...card.querySelectorAll(
                "[data-key]"
            )
        ]
        .map(
            element =>
                element.dataset.key
        );


    OPTIONAL_FIELDS.forEach(
        field => {


            const exists =
                existing.includes(
                    field.key
                );


            const item =
                document.createElement(
                    "button"
                );


            item.type =
                "button";


            item.className =
                "modal-field" +
                (
                    exists
                        ? " disabled"
                        : ""
                );


            item.innerHTML = `

                <span class="modal-icon">
                    ✦
                </span>

                <span>
                    ${escapeHtml(
                        field.label
                    )}
                </span>

            `;


            if(!exists) {

                item.addEventListener(
                    "click",
                    () => {

                        addFieldToCard(
                            activeStudentCard,
                            field
                        );

                        fieldModal.classList.remove(
                            "open"
                        );

                    }
                );

            }


            modalFields.appendChild(
                item
            );

        }
    );


    fieldModal.classList.add(
        "open"
    );

}


/* =========================================================
   CLOSE MODAL
========================================================= */

document
    .getElementById(
        "closeModal"
    )
    .addEventListener(
        "click",
        () => {

            fieldModal.classList.remove(
                "open"
            );

        }
    );


fieldModal.addEventListener(
    "click",
    event => {

        if(
            event.target ===
            fieldModal
        ) {

            fieldModal.classList.remove(
                "open"
            );

        }

    }
);


/* =========================================================
   ADD BUTTON
========================================================= */

document
    .getElementById(
        "addStudent"
    )
    .addEventListener(
        "click",
        addStudent
    );


/* =========================================================
   CLEAR
========================================================= */

document
    .getElementById(
        "clearStudents"
    )
    .addEventListener(
        "click",
        () => {


            const cards =
                document.querySelectorAll(
                    ".student-card"
                );


            if(
                cards.length === 0
            ) {

                return;

            }


            if(
                !confirm(
                    "Remove all students from this list?"
                )
            ) {

                return;

            }


            cards.forEach(
                card => card.remove()
            );


            emptyState.style.display =
                "block";


            updateCounts();

        }
    );


/* =========================================================
   COUNTS
========================================================= */

function updateCounts() {

    const count =
        document.querySelectorAll(
            ".student-card"
        ).length;


    studentCount.textContent =
        count;


    saveCount.textContent =
        count;


    saveBar.style.display =
        count
            ? "flex"
            : "none";


    if(!count) {

        emptyState.style.display =
            "block";

    }
    else {

        emptyState.style.display =
            "none";

    }

}


/* =========================================================
   COLLECT DOCUMENTS
========================================================= */

function collectDocuments(
    card
) {

    return [
        ...card.querySelectorAll(
            ".document-tag span"
        )
    ]
    .map(
        element =>
            element.textContent.trim()
    )
    .filter(Boolean);

}


/* =========================================================
   COLLECT CUSTOM FIELDS
========================================================= */

function collectCustomFields(
    card
) {

    const box =
        card.querySelector(
            ".custom-fields-box"
        );


    if(!box) {

        return [];

    }


    return [
        ...box.querySelectorAll(
            ".custom-row"
        )
    ]
    .map(
        row => ({

            name:
                row.querySelector(".custom-name")?.value.trim() || "",

            value:
                row.querySelector(
                    ".custom-value"
                )?.value ||
                ""

        })
    );

}


/* =========================================================
   COLLECT STUDENT
========================================================= */

function collectStudent(
    card
) {

    const values = {};


    card.querySelectorAll("[data-field]").forEach(input => {
        const key = input.dataset.field;
        if(input.type === "radio") {
            if(input.checked) values[key] = input.value;
        } else {
            values[key] = input.value;
        }
    });


    if(
        values.aadhaar
    ) {

        values.aadhaar =
            values.aadhaar.replace(
                /\s/g,
                ""
            );

    }


    const documents =
        card.querySelector(
            ".documents-box"
        );


    if(documents) {

        values.submittedDocuments =
            collectDocuments(
                card
            );

    }


    const custom =
        card.querySelector(
            ".custom-fields-box"
        );


    if(custom) {

        values.customFields =
            collectCustomFields(
                card
            );

    }


    return values;

}


/* =========================================================
   VALIDATION
========================================================= */
function validateStudents() {

    const cards = [
        ...document.querySelectorAll(
            ".student-card"
        )
    ];


    for (const card of cards) {


        const name =
            card.querySelector(
                '[data-field="name"]'
            );


        const classInput =
            card.querySelector(
                '[data-field="class"]'
            );


        const joinSession =
            card.querySelector(
                '[data-field="schoolJoinSession"]'
            );


        const father =
            card.querySelector(
                '[data-field="fatherName"]'
            );


        const mother =
            card.querySelector(
                '[data-field="motherName"]'
            );


        // IMPORTANT:
        // Status is a SELECT, not a radio/checkbox.
        const statusInput =
            card.querySelector(
                'select[data-field="status"]'
            );


        const required = [

            name,

            classInput,

            joinSession,

            father,

            mother,

            statusInput

        ];


        for (const input of required) {

            if (
                !input ||
                !String(
                    input.value || ""
                ).trim()
            ) {

                if (input) {

                    input.classList.add(
                        "invalid"
                    );


                    input.scrollIntoView({
                        behavior:
                            "smooth",

                        block:
                            "center"
                    });


                    // Focus after scrolling
                    setTimeout(() => {

                        input.focus();

                    }, 300);

                }


                showToast(
                    "Please complete all required fields."
                );


                return false;

            }


            input.classList.remove(
                "invalid"
            );

        }


        // ==========================================
        // AADHAAR DUPLICATE CHECK
        // ==========================================

        const duplicate =
            card.querySelector(
                ".aadhaar-status.warning"
            );


        if (duplicate) {

            showToast(
                "Please fix the Aadhaar issue before saving."
            );


            duplicate.scrollIntoView({
                behavior:
                    "smooth",

                block:
                    "center"
            });


            return false;

        }

    }


    return true;

}

/* =========================================================
   SAVE ALL
========================================================= */

document
    .getElementById(
        "saveAll"
    )
    .addEventListener(
        "click",
        async () => {


            if(
                !validateStudents()
            ) {

                return;

            }


            const cards =
                [
                    ...document.querySelectorAll(
                        ".student-card"
                    )
                ];


            if(
                cards.length === 0
            ) {

                showToast(
                    "Add at least one student."
                );

                return;

            }


            const students =
                cards.map(
                    card =>
                        collectStudent(
                            card
                        )
                );


            const saveButton =
                document.getElementById(
                    "saveAll"
                );


            saveButton.disabled =
                true;

            saveButton.textContent =
                "Saving Students...";


            try {


                const response =
                    await fetch(
                        "/admin/api/students/bulk-add",
                        {

                            method:
                                "POST",

                            headers: {

                                "Content-Type":
                                    "application/json"

                            },

                            body:
                                JSON.stringify({
                                    students
                                })

                        }
                    );


                const data =
                    await response.json();


                if(
                    !response.ok ||
                    !data.success
                ) {

                    throw new Error(
                        data.message ||
                        "Unable to save students."
                    );

                }


                showToast(
                    data.message ||
                    `${students.length} students added successfully.`
                );


                setTimeout(
                    () => {

                        window.location.href =
                            "/admin/students";

                    },
                    1000
                );


            }
            catch(error) {

                showToast(
                    error.message
                );

            }
            finally {

                saveButton.disabled =
                    false;

                saveButton.textContent =
                    "✓ Save All Students";

            }

        }
    );


/* =========================================================
   START WITH ONE STUDENT
========================================================= */

addStudent();

</script>

</body>

</html>