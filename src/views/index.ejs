<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>IKVM | Management System</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            background: #07090d;
            color: #f5f7ff;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }


        /* Background */

        body::before {
            content: "";

            position: fixed;
            inset: 0;

            background-image:
                linear-gradient(
                    rgba(255,255,255,0.025) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,0.025) 1px,
                    transparent 1px
                );

            background-size: 70px 70px;

            mask-image: linear-gradient(
                to bottom,
                black,
                transparent 85%
            );

            pointer-events: none;
            z-index: -2;
        }


        .glow {
            position: fixed;

            width: 450px;
            height: 450px;

            border-radius: 50%;

            filter: blur(150px);

            opacity: 0.13;

            pointer-events: none;

            z-index: -1;
        }

        .glow.one {
            background: #4c63ff;

            top: -220px;
            left: -180px;
        }

        .glow.two {
            background: #914cff;

            right: -220px;
            top: 350px;
        }


        /* Navbar */

        .navbar {
            width: min(1180px, 92%);

            height: 78px;

            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;

            border-bottom: 1px solid rgba(255,255,255,0.07);
        }


        .brand {
            display: flex;
            align-items: center;

            gap: 10px;

            font-size: 15px;
            font-weight: 700;

            letter-spacing: 0.5px;
        }


        .brand-icon {
            width: 35px;
            height: 35px;

            display: grid;
            place-items: center;

            border-radius: 10px;

            background: linear-gradient(
                135deg,
                #6078ff,
                #914cff
            );

            box-shadow:
                0 8px 30px rgba(80,80,255,0.3);

            font-size: 13px;
        }


        .navbar nav {
            display: flex;

            gap: 35px;
        }


        .navbar nav a {
            color: #858b9b;

            font-size: 13px;

            transition: 0.25s;
        }


        .navbar nav a:hover {
            color: white;
        }


        .login-btn {
            padding: 10px 20px;

            border: 1px solid rgba(255,255,255,0.1);

            border-radius: 9px;

            background: rgba(255,255,255,0.035);

            font-size: 13px;

            transition: 0.25s;
        }


        .login-btn:hover {
            background: rgba(255,255,255,0.09);

            transform: translateY(-1px);
        }


        /* Hero */

        .hero {
            width: min(1180px, 92%);

            min-height: 650px;

            margin: auto;

            display: grid;

            grid-template-columns: 1.1fr 0.9fr;

            align-items: center;

            gap: 70px;
        }


        .badge {
            display: inline-flex;

            align-items: center;

            gap: 9px;

            padding: 8px 13px;

            border: 1px solid rgba(255,255,255,0.08);

            border-radius: 50px;

            background: rgba(255,255,255,0.025);

            color: #8d94a5;

            font-size: 10px;

            letter-spacing: 1.5px;
        }


        .badge-dot {
            width: 6px;
            height: 6px;

            border-radius: 50%;

            background: #657cff;

            box-shadow: 0 0 12px #657cff;
        }


        .hero h1 {
            margin-top: 25px;

            max-width: 700px;

            font-size: clamp(45px, 5vw, 70px);

            line-height: 1.05;

            letter-spacing: -3px;
        }


        .hero h1 span {
            display: block;

            background: linear-gradient(
                90deg,
                #6c83ff,
                #a15cff
            );

            -webkit-background-clip: text;

            color: transparent;
        }


        .hero-description {
            max-width: 580px;

            margin-top: 25px;

            color: #858b9b;

            font-size: 15px;

            line-height: 1.8;
        }


        /* Buttons */

        .buttons {
            display: flex;

            gap: 12px;

            margin-top: 32px;
        }


        .primary-btn,
        .secondary-btn {
            padding: 13px 21px;

            border-radius: 9px;

            font-size: 13px;

            font-weight: 600;

            transition: 0.25s;
        }


        .primary-btn {
            display: flex;

            align-items: center;

            gap: 14px;

            background: linear-gradient(
                135deg,
                #566fff,
                #824cff
            );

            box-shadow:
                0 12px 35px rgba(75,75,255,0.25);
        }


        .primary-btn:hover {
            transform: translateY(-3px);

            box-shadow:
                0 18px 45px rgba(75,75,255,0.4);
        }


        .secondary-btn {
            border: 1px solid rgba(255,255,255,0.1);

            background: rgba(255,255,255,0.025);

            color: #b0b5c4;
        }


        .secondary-btn:hover {
            background: rgba(255,255,255,0.07);
        }


        /* Small points */

        .points {
            display: flex;

            gap: 25px;

            margin-top: 38px;

            color: #72798b;

            font-size: 11px;
        }


        .points span {
            color: #657aff;

            margin-right: 6px;
        }


        /* Right visual */

        .visual {
            position: relative;

            height: 440px;

            display: grid;

            place-items: center;
        }


        .circle {
            position: absolute;

            border: 1px solid rgba(100,120,255,0.12);

            border-radius: 50%;
        }


        .circle.one {
            width: 350px;
            height: 350px;
        }


        .circle.two {
            width: 470px;
            height: 470px;

            border-color: rgba(150,80,255,0.06);
        }


        .main-card {
            width: 310px;

            padding: 30px;

            border: 1px solid rgba(255,255,255,0.1);

            border-radius: 18px;

            background: linear-gradient(
                145deg,
                rgba(255,255,255,0.07),
                rgba(255,255,255,0.025)
            );

            backdrop-filter: blur(20px);

            box-shadow:
                0 40px 100px rgba(0,0,0,0.55),
                0 0 80px rgba(80,80,255,0.1);

            position: relative;

            z-index: 2;

            animation: floating 5s ease-in-out infinite;
        }


        @keyframes floating {

            0% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }

            100% {
                transform: translateY(0);
            }
        }


        .card-label {
            color: #70778a;

            font-size: 9px;

            letter-spacing: 2px;
        }


        .card-icon {
            width: 65px;
            height: 65px;

            margin-top: 38px;

            display: grid;
            place-items: center;

            border-radius: 16px;

            background: linear-gradient(
                135deg,
                #566fff,
                #8b4dff
            );

            box-shadow:
                0 15px 35px rgba(80,80,255,0.3);

            font-size: 23px;
        }


        .main-card h2 {
            margin-top: 24px;

            font-size: 21px;
        }


        .main-card p {
            margin-top: 10px;

            color: #7d8495;

            font-size: 12px;

            line-height: 1.7;
        }


        .card-divider {
            height: 1px;

            margin: 25px 0;

            background: rgba(255,255,255,0.07);
        }


        .online {
            display: flex;

            align-items: center;

            gap: 8px;

            color: #7d8495;

            font-size: 10px;
        }


        .online-dot {
            width: 6px;
            height: 6px;

            border-radius: 50%;

            background: #4ed49a;

            box-shadow: 0 0 10px #4ed49a;
        }


        /* Features */

        .features {
            width: min(1180px, 92%);

            margin: 50px auto 120px;
        }


        .section-title {
            text-align: center;
        }


        .section-title > span {
            color: #6c7dff;

            font-size: 10px;

            letter-spacing: 2px;

            font-weight: 700;
        }


        .section-title h2 {
            margin-top: 14px;

            font-size: 38px;

            letter-spacing: -1.5px;
        }


        .section-title em {
            color: #777e90;

            font-style: normal;
        }


        .feature-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 18px;

            margin-top: 45px;
        }


        .feature-card {
            padding: 27px;

            border: 1px solid rgba(255,255,255,0.07);

            border-radius: 14px;

            background: rgba(255,255,255,0.025);

            transition: 0.3s;
        }


        .feature-card:hover {
            transform: translateY(-5px);

            border-color: rgba(100,120,255,0.3);

            background: rgba(255,255,255,0.045);
        }


        .feature-number {
            color: #6e80ff;

            font-size: 11px;

            font-weight: 700;
        }


        .feature-card h3 {
            margin-top: 18px;

            font-size: 16px;
        }


        .feature-card p {
            margin-top: 9px;

            color: #777e90;

            font-size: 12px;

            line-height: 1.7;
        }


        /* Footer */

        footer {
            width: min(1180px, 92%);

            margin: auto;

            padding: 28px 0;

            border-top: 1px solid rgba(255,255,255,0.07);

            display: flex;

            justify-content: space-between;

            align-items: center;
        }


        footer p {
            color: #505666;

            font-size: 10px;
        }


        /* Responsive */

        @media (max-width: 850px) {

            .navbar nav {
                display: none;
            }

            .hero {
                grid-template-columns: 1fr;

                padding: 80px 0;
            }

            .visual {
                height: 400px;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }
        }


        @media (max-width: 500px) {

            .hero h1 {
                font-size: 43px;

                letter-spacing: -2px;
            }

            .buttons {
                flex-direction: column;
            }

            .primary-btn,
            .secondary-btn {
                justify-content: center;

                text-align: center;
            }

            .points {
                flex-wrap: wrap;
            }

            .main-card {
                width: 280px;
            }

            .circle.one {
                width: 320px;
                height: 320px;
            }

            .circle.two {
                width: 400px;
                height: 400px;
            }

            footer {
                flex-direction: column;

                gap: 15px;
            }
        }

    </style>
</head>


<body>

    <div class="glow one"></div>
    <div class="glow two"></div>


    <!-- NAVBAR -->

    <header class="navbar">

        <a href="/" class="brand">

            <div class="brand-icon">
                ◆
            </div>

            <span>
                IKVM
            </span>

        </a>


        <nav>

            <a href="#home">
                Home
            </a>

            <a href="#features">
                Features
            </a>

            <a href="#about">
                About
            </a>

        </nav>


        <a href="/login" class="login-btn">
            Login
        </a>

    </header>



    <!-- HERO -->

    <section class="hero" id="home">

        <div class="hero-content">

            <div class="badge">

                <span class="badge-dot"></span>

                IKVM MANAGEMENT PLATFORM

            </div>


            <h1>

                Everything you need.

                <span>
                    One powerful system.
                </span>

            </h1>


            <p class="hero-description">

                A modern and reliable management platform designed
                to simplify operations, organize information and
                help you manage everything from one place.

            </p>


            <div class="buttons">

                <a href="/login" class="primary-btn">

                    Enter System

                    <span>
                        →
                    </span>

                </a>


                <a href="#features" class="secondary-btn">

                    Explore Features

                </a>

            </div>


            <div class="points">

                <div>
                    <span>✓</span>
                    Secure
                </div>

                <div>
                    <span>✓</span>
                    Fast
                </div>

                <div>
                    <span>✓</span>
                    Easy to use
                </div>

            </div>

        </div>



        <!-- RIGHT SIDE -->

        <div class="visual">

            <div class="circle one"></div>

            <div class="circle two"></div>


            <div class="main-card">

                <div class="card-label">
                    SYSTEM
                </div>


                <div class="card-icon">
                    ◆
                </div>


                <h2>
                    Smart Management
                </h2>


                <p>
                    Manage your data, users and daily
                    operations efficiently from one
                    centralized platform.
                </p>


                <div class="card-divider"></div>


                <div class="online">

                    <span class="online-dot"></span>

                    System Online

                </div>

            </div>

        </div>

    </section>



    <!-- FEATURES -->

    <section class="features" id="features">

        <div class="section-title">

            <span>
                WHY CHOOSE US
            </span>

            <h2>
                Built for
                <em>better management.</em>
            </h2>

        </div>


        <div class="feature-grid">


            <div class="feature-card">

                <div class="feature-number">
                    01
                </div>

                <h3>
                    Simple
                </h3>

                <p>
                    A clean and intuitive interface
                    that makes everyday management
                    simple.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-number">
                    02
                </div>

                <h3>
                    Secure
                </h3>

                <p>
                    Secure authentication and
                    organized access keep your
                    information protected.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-number">
                    03
                </div>

                <h3>
                    Powerful
                </h3>

                <p>
                    Powerful tools designed to handle
                    your complete management workflow.
                </p>

            </div>


        </div>

    </section>



    <!-- FOOTER -->

    <footer>

    <div class="brand">

        <div class="brand-icon">
            ◆
        </div>

        <span>
            IKVM
        </span>

    </div>

    <p>
        © 2026 IKVM. All rights reserved.
    </p>

</footer>

</body>
</html>